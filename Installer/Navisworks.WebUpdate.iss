[Setup]
AppId=BIMaestro.Navisworks.WebUpdate
AppName=BIMaestro pour Navisworks
AppVersion=1.0.0
AppPublisher=BIMaestro
DefaultDirName={userappdata}\Autodesk\ApplicationPlugins\BIMaestro.Navisworks.bundle
CreateAppDir=no
DisableProgramGroupPage=yes
Uninstallable=no
PrivilegesRequired=lowest
OutputDir=Output
OutputBaseFilename=BIMaestro-Navisworks-Publication-Web
CloseApplications=yes
RestartApplications=no
Compression=lzma2
SolidCompression=yes

[Languages]
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Files]
#include "Navisworks.Files.iss"
