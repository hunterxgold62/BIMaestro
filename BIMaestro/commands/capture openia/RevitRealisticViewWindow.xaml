<Window x:Class="IA.RevitRealisticViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IA - Vue réaliste" Height="430" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choisissez une vue plan, coupe ou 3D à transformer en rendu réaliste (qualité medium)."
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ListBox x:Name="ViewsList" Grid.Row="1" DisplayMemberPath="DisplayName"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="110" Margin="0,0,8,0" Click="Cancel_Click">Annuler</Button>
            <Button Width="170" IsDefault="True" Click="Generate_Click">Générer l'image</Button>
        </StackPanel>
    </Grid>
</Window>
