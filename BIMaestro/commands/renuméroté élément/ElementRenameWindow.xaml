<Window x:Class="Modification.ElementRenamerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Organisateur d'Éléments"
        Height="580"
        Width="560"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Organisateur d'éléments" Style="{StaticResource H1}"/>
                <TextBlock Text="Configurez le paramètre cible, la structure de nommage et lancez le renommage en un clic."
                           Margin="0,6,0,0"
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Paramètre à modifier :" Style="{StaticResource Label}"
                           ToolTip="Sélectionnez le paramètre texte que vous souhaitez modifier pour les éléments sélectionnés."/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ParameterComboBox" ItemsSource="{Binding AvailableParameters}" SelectedItem="{Binding SelectedParameter}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Préfixe :" Style="{StaticResource Label}"
                           ToolTip="Entrez le texte qui sera ajouté avant le numéro lors du renommage des éléments."/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PrefixTextBox" Text="{Binding Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Suffixe :" Style="{StaticResource Label}"
                           ToolTip="Entrez le texte qui sera ajouté après le numéro lors du renommage des éléments."/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SuffixTextBox" Text="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Numéro de départ :" Style="{StaticResource Label}"
                           ToolTip="Spécifiez le point de départ pour la numérotation."/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="StartNumberTextBox" Text="{Binding StartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Format de numérotation :" Style="{StaticResource Label}"
                           ToolTip="Choisissez le format de numérotation des éléments."/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="NumberFormatComboBox" ItemsSource="{Binding NumberFormats}" SelectedItem="{Binding SelectedNumberFormat}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Hauteur de bande (m) :" Style="{StaticResource Label}"
                           ToolTip="Spécifiez la hauteur des bandes utilisées pour le tri des éléments. Les éléments sont regroupés par bandes horizontales de cette hauteur et triés de gauche à droite dans chaque bande."/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="BandHeightTextBox" Text="{Binding BandHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Border Grid.Row="6" Grid.ColumnSpan="2"
                        Background="{StaticResource Surface.Subtle}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,4,0,0">
                    <CheckBox x:Name="SortByLevelCheckBox"
                              Content="Trier par niveau"
                              IsChecked="{Binding IsSortByLevelEnabled, Mode=TwoWay}"
                              ToolTip="Cochez cette case pour trier les éléments par niveau avant d'appliquer le renommage."/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Réinitialiser"
                    Width="150"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnResetClick"
                    ToolTip="Cliquez pour réinitialiser le paramètre sélectionné des éléments (vide le contenu)."/>
            <Button Content="Renommer"
                    Width="150"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnRenameClick"
                    ToolTip="Cliquez pour appliquer le renommage aux éléments sélectionnés."/>
        </StackPanel>
    </Grid>
</Window>