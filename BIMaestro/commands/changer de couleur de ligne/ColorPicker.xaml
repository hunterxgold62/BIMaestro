<Window x:Class="Modification.GraphicOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Surcharges vues"
        Height="660"
        Width="760"
        MinHeight="560"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Height" Value="34"/>
            </Style>

            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header vert BIMaestro -->
        <Border Grid.Row="0"
                Padding="22"
                CornerRadius="18"
                Background="#0F5A36"
                BorderBrush="#0B4429"
                BorderThickness="1"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Surcharges graphiques par vues"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Applique ou réinitialise rapidement la demi-teinte, la transparence ou le masquage des éléments sélectionnés dans les vues choisies."
                               Margin="0,6,24,0"
                               TextWrapping="Wrap"
                               Foreground="#DDEFE6"
                               Opacity="0.95"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="HelpButton"
                        Content="?"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="Ouvrir l’aide en ligne"
                        Click="HelpButton_Click"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Options -->
            <Border Grid.Column="0"
                    Padding="16"
                    CornerRadius="14"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    Margin="0,0,12,0">

                <StackPanel>
                    <TextBlock Text="Options générales"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <CheckBox x:Name="HalftoneCheckBox"
                              Content="Appliquer la demi-teinte"/>

                    <CheckBox x:Name="HideInViewCheckBox"
                              Content="Masquer dans les vues"
                              Checked="HideInViewCheckBox_Checked"
                              Unchecked="HideInViewCheckBox_Unchecked"/>

                    <Border Margin="0,16,0,16"
                            Height="1"
                            Background="{DynamicResource Divider}"/>

                    <TextBlock Text="Transparence"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Valeur appliquée aux éléments sélectionnés."
                               TextWrapping="Wrap"
                               Opacity="0.72"
                               Margin="0,0,0,8"/>

                    <Slider x:Name="TransparencySlider"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            ValueChanged="TransparencySlider_ValueChanged"/>

                    <Border Margin="0,8,0,0"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="{DynamicResource Surface.Subtle}"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TransparencyValueText"
                                   Text="0 %"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Border Margin="0,18,0,12"
                            Height="1"
                            Background="{DynamicResource Divider}"/>

                    <TextBlock Text="À savoir"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Si tu coches une feuille, BIMaestro applique les réglages aux vues placées sur cette feuille. La feuille elle-même n’est pas modifiée."
                               TextWrapping="Wrap"
                               Opacity="0.72"/>
                </StackPanel>
            </Border>

            <!-- Views / Sheets -->
            <Border Grid.Column="1"
                    Padding="16"
                    CornerRadius="14"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1">

                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,12">

                        <TextBlock Text="Sélection des vues et feuilles"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <WrapPanel>
                            <Button x:Name="SelectActiveViewButton"
                                    Content="Vue active"
                                    Click="SelectActiveViewButton_Click"/>

                            <Button x:Name="SelectAllButton"
                                    Content="Tout sélectionner"
                                    Click="SelectAllButton_Click"/>

                            <Button x:Name="DeselectAllButton"
                                    Content="Tout désélectionner"
                                    Click="DeselectAllButton_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="{DynamicResource Surface.Subtle}">

                        <TreeView x:Name="ViewsTreeView"
                                  Margin="8"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12"
                CornerRadius="14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1">

            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <Button x:Name="ResetButton"
                            Content="Réinitialiser"
                            Click="ResetButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Annuler"
                            Click="CancelButton_Click"/>

                    <Button x:Name="ApplyButton"
                            Content="Appliquer"
                            Style="{StaticResource PrimaryButton}"
                            Click="ApplyButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>