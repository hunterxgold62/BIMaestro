<!-- SelectViewsWindow.xaml -->
<Window x:Class="ScanTextRevit.SelectViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Sélection de Vues/Feuilles" 
        Height="500" Width="400">

    <Window.Resources>
        <!-- Style pour que les éléments de l'arbre adoptent la couleur Foreground du Window -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground"
                    Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Foreground}" />
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            CornerRadius="10"
            Background="#FFF0F0F0"
            Padding="10"
            Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TreeView avec virtualisation activée -->
            <TreeView x:Name="ViewsTreeView"
                      Grid.Row="0" Margin="5"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling" />

            <!-- Boutons OK / Annuler -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="5"
                        Grid.Row="1">
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="80"
                        Margin="5"
                        Click="OkButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Annuler"
                        Width="80"
                        Margin="5"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
