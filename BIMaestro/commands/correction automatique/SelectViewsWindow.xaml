<!-- SelectViewsWindow.xaml -->
<Window x:Class="ScanTextRevit.SelectViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Sélection de Vues/Feuilles"
        Height="520"
        Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground"
                        Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Foreground}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sélection des vues et feuilles"
                   Style="{StaticResource H2}"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <TreeView x:Name="ViewsTreeView"
                      Margin="2"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Grid.Row="2">
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Width="120"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="120"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>