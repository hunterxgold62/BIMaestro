<!-- SelectViewsWindow.xaml -->
<Window x:Class="ScanTextRevit.SelectViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Sélection de Vues/Feuilles"
        Height="520"
        Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground"
                        Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Foreground}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Sélection des vues et feuilles"
                       Style="{StaticResource H2}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <Button Grid.Column="1"
                    x:Name="HelpButton"
                    Content="?"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Style="{StaticResource HelpButtonStyle}"
                    ToolTip="Ouvrir l’aide en ligne"
                    Click="HelpButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <TreeView x:Name="ViewsTreeView"
                      Margin="2"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Grid.Row="2">
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Width="120"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="120"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
