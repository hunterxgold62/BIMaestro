<Window x:Class="ScanTextRevit.CorrectionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Résultat du Scan de Textes et Corrections (IA)"
        Height="700"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="MainBorder"
            CornerRadius="14"
            Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            Padding="0"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="True"
                       Background="{DynamicResource Brand}"
                       Height="46"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Résultat du Scan de Textes et Corrections (IA)"
                           Style="{DynamicResource H1}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
                <Button Content="Fermer"
                        Width="95"
                        Height="30"
                        DockPanel.Dock="Right"
                        Margin="0,8,12,8"
                        Click="CloseButton_Click"
                        Style="{DynamicResource SecondaryButton}"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <WrapPanel x:Name="FilterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Légende :" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Button x:Name="ErrorFilterButton"
                                    Content="Vert = Erreur"
                                    Foreground="Green"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ErrorFilterButton_Click"
                                    Margin="0,0,8,0"/>

                            <TextBlock Text="|" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Button x:Name="MinorFilterButton"
                                    Content="Orange = Correction mineure"
                                    Foreground="Orange"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="MinorFilterButton_Click"
                                    Margin="0,0,8,0"/>

                            <TextBlock Text="|" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Button x:Name="RepetitionFilterButton"
                                    Content="Bleu = Répétition"
                                    Foreground="Blue"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RepetitionFilterButton_Click"
                                    Margin="0,0,8,0"/>

                            <TextBlock Text="|" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <CheckBox x:Name="HideDuplicatesCheckBox"
                                      Content="Masquer répétitions"
                                      Foreground="{DynamicResource Text.Primary}"
                                      Margin="0,0,8,0"
                                      Checked="HideDuplicatesCheckBox_Checked"
                                      Unchecked="HideDuplicatesCheckBox_Unchecked"/>

                            <TextBlock Text="|" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Button x:Name="ShowAllFilterButton"
                                    Content="Afficher toutes"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource Text.Primary}"
                                    Click="ShowAllFilterButton_Click"
                                    Margin="0,0,8,0"/>

                            
                        </WrapPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                        <StackPanel x:Name="ProgressBarPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="ProgressBar"
                                         Height="18"
                                         Width="260"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Foreground="{DynamicResource Brand}"
                                         Background="{DynamicResource Divider}"/>
                            <TextBlock x:Name="ProgressText"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="0%"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="CorrectionsPanel" Orientation="Vertical" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>