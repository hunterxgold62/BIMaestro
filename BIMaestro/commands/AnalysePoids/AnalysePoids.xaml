<Window x:Class="Analyse.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Résultats de l'Analyse"
        Height="650"
        Width="800"
        MinHeight="520"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{DynamicResource Brand}"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Résultats de l'analyse" Style="{StaticResource H1}"/>
                    <TextBlock Text="Double-cliquez une ligne pour sélectionner les éléments dans Revit."
                               Margin="0,6,0,0"
                               Foreground="#E7F6EE"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="HelpButton"
                        Content="?"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="Ouvrir l’aide en ligne"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
            <DataGrid x:Name="ElementDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Margin="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="3*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="2*"/>
                    <DataGridTextColumn Header="Taille (Mo)"
                                        Binding="{Binding TailleAffiche}"
                                        SortMemberPath="TailleEnMo"
                                        Width="*"/>
                    <DataGridTextColumn Header="Instances" Binding="{Binding Count}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Background="{DynamicResource Surface.Subtle}">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="FamilyTotalText" Style="{StaticResource H2}"/>
                <TextBlock x:Name="ImportTotalText" Style="{StaticResource H2}" Margin="0,4,0,0"/>
                <TextBlock x:Name="GrandTotalText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
