<Window x:Class="Analyse.CollaborativeModelTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suivi maquettes collaboratif"
        Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Interface simplifiée : sélection utilisateur, recherche maquette, accès direct au dossier du modèle."
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#FFF7F8FA" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Utilisateur :" Margin="0,0,8,0"/>
                <ComboBox x:Name="UserComboBox"
                          Grid.Column="1"
                          Height="30"
                          IsEditable="True"
                          Margin="0,0,12,0"
                          SelectionChanged="UserComboBox_SelectionChanged"
                          LostFocus="UserComboBox_LostFocus"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Version Revit :" Margin="0,0,8,0"/>
                <ComboBox x:Name="RevitVersionComboBox"
                          Grid.Column="3"
                          Height="30"
                          IsEditable="False"
                          Margin="0,0,12,0"
                          SelectionChanged="RevitVersionComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Type fichier :" Margin="0,0,8,0"/>
                <ComboBox x:Name="FileTypeComboBox"
                          Grid.Column="5"
                          Height="30"
                          IsEditable="False"
                          Margin="0,0,12,0"
                          SelectionChanged="FileTypeComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Recherche maquette :" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchModelTextBox"
                         Grid.Column="7"
                         Height="30"
                         Margin="0,0,12,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchModelTextBox_TextChanged"/>

                <Button Grid.Column="8" Content="Rafraîchir" Width="90" Height="30" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#FFE3E7ED" BorderThickness="1" CornerRadius="10" Padding="8">
            <ListBox x:Name="ProjectsListBox"
                     BorderThickness="0"
                     MouseDoubleClick="ProjectsListBox_MouseDoubleClick"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SnapsToDevicePixels="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding PastelBrush}"
                                HorizontalAlignment="Stretch"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,8"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding ModelName}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProjectName}" Margin="0,4,0,0" FontWeight="SemiBold" Opacity="0.9"/>
                                <TextBlock Text="{Binding ModelPath}" Margin="0,3,0,0" TextWrapping="Wrap" Opacity="0.9"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Utilisateur: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding UserName}"/>
                                    <TextBlock Text="   Créateur: " FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding CreatorName}"/>
                                    <TextBlock Text="   Revit: " FontWeight="SemiBold" Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding RevitVersion}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="InfoText"
                       Grid.Column="0"
                       Opacity="0.85"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="Ouvrir dossier"
                    Width="120"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="OpenFolder_Click"/>
        </Grid>
    </Grid>
</Window>
