<Window x:Class="IA.CorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Correction / Reformulation de Texte"
        Width="640"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Correction / reformulation IA" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,6,0,0"
                           Text="Générez 3 reformulations puis sélectionnez celle à appliquer."
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="1" Text="Texte original :" Style="{StaticResource H2}" Margin="0,0,0,4"/>

                <TextBox Grid.Row="2"
                         x:Name="originalTextBox"
                         Height="70"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,10"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Texte corrigé / reformulé :" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="1"
                             x:Name="proposalsListBox"
                             SelectionMode="Single"
                             Margin="0,0,0,10"
                             MouseDoubleClick="proposalsListBox_MouseDoubleClick"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="Style de reformulation :" Style="{StaticResource H2}" Margin="0,0,0,4"/>

                <ComboBox Grid.Row="5"
                          x:Name="styleComboBox"
                          SelectedIndex="0"
                          Margin="0,0,0,10">
                    <ComboBoxItem Content="Classique"/>
                    <ComboBoxItem Content="Professionnelle"/>
                    <ComboBoxItem Content="Baratin"/>
                    <ComboBoxItem Content="Cool"/>
                    <ComboBoxItem Content="Personnalisé"/>
                </ComboBox>

                <StackPanel Grid.Row="6"
                            x:Name="customInstructionPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Instruction personnalisée :" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBox x:Name="customInstructionTextBox"
                             Height="60"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>
                </StackPanel>

                <Button x:Name="rephraseButton"
                        Grid.Row="7"
                        Content="Reformuler (3 propositions)"
                        Width="230"
                        Style="{StaticResource PrimaryButton}"
                        Click="rephraseButton_Click"
                        HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="cancelButton"
                    Content="Annuler"
                    Width="120"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="cancelButton_Click"/>
            <Button x:Name="okButton"
                    Content="OK"
                    Width="120"
                    Style="{StaticResource PrimaryButton}"
                    Click="okButton_Click"/>
        </StackPanel>
    </Grid>
</Window>