<Window x:Class="Modification.PickDefaultFlangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir la bride par défaut"
        Width="700" Height="480"
        MinWidth="680" MinHeight="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <DockPanel Margin="12" LastChildFill="True">

        <!-- Bandeau haut -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontSize="16" FontWeight="SemiBold"
                 Text="Sélectionne le type de bride à utiliser (session en cours)"/>
            <Grid Margin="10,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Rechercher (famille) :"/>
                <!-- Filtre EN TEMPS RÉEL sur le NOM DE FAMILLE -->
                <TextBox x:Name="SearchBox"
                 Grid.Column="1"
                 Height="28"
                 VerticalContentAlignment="Center"
                 ToolTip="Tape pour filtrer les familles (ex : 'bri', 'collerette', 'pn16')"
                 TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </StackPanel>

        <!-- Liste (double-clic = valider) -->
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="FlangeList"
                MouseDoubleClick="FlangeList_MouseDoubleClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True"
                                    VirtualizationMode="Recycling"
                                    ScrollUnit="Pixel"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Famille" Width="260" DisplayMemberBinding="{Binding Family}"/>
                        <GridViewColumn Header="Type"    Width="360" DisplayMemberBinding="{Binding Type}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

    </DockPanel>
</Window>
