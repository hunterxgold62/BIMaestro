<Window x:Class="Modification.PickDefaultFlangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Choisir la bride par défaut"
        Width="700"
        Height="480"
        MinWidth="680"
        MinHeight="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{DynamicResource Brand}"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Sélection de la bride par défaut" Style="{StaticResource H1}"/>
                    <TextBlock Text="Sélectionnez le type de bride à utiliser pour la session en cours."
                               Margin="0,6,0,0"
                               Foreground="#E7F6EE"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        x:Name="HelpButton"
                        Content="?"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="Ouvrir l’aide en ligne"
                        Click="HelpButton_Click"/>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Text="Rechercher (famille) :"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Height="28"
                             VerticalContentAlignment="Center"
                             ToolTip="Tape pour filtrer les familles (ex : 'bri', 'collerette', 'pn16')"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="FlangeList" MouseDoubleClick="FlangeList_MouseDoubleClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True"
                                                VirtualizationMode="Recycling"
                                                ScrollUnit="Pixel"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Famille" Width="260" DisplayMemberBinding="{Binding Family}"/>
                        <GridViewColumn Header="Type" Width="360" DisplayMemberBinding="{Binding Type}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
