<Window x:Class="Modification.PickDefaultFlangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Choisir la bride par défaut"
        Width="700"
        Height="480"
        MinWidth="680"
        MinHeight="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{DynamicResource Brand}"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Sélection de la bride par défaut" Style="{StaticResource H1}"/>
                <TextBlock Text="Sélectionnez le type de bride à utiliser pour la session en cours."
                           Margin="0,6,0,0"
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Text="Rechercher (famille) :"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Height="28"
                             VerticalContentAlignment="Center"
                             ToolTip="Tape pour filtrer les familles (ex : 'bri', 'collerette', 'pn16')"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="FlangeList" MouseDoubleClick="FlangeList_MouseDoubleClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True"
                                                VirtualizationMode="Recycling"
                                                ScrollUnit="Pixel"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Famille" Width="260" DisplayMemberBinding="{Binding Family}"/>
                        <GridViewColumn Header="Type" Width="360" DisplayMemberBinding="{Binding Type}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>