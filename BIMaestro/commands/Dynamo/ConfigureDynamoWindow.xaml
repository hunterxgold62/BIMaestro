<Window x:Class="Modification.ConfigureDynamoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Configurer un bouton Dynamo"
        MinWidth="420"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Personnaliser un bouton Dynamo"
                       FontWeight="Bold"
                       FontSize="16" />
            <TextBlock Text="Choisissez l'emplacement, renommez l'étiquette et sélectionnez le script .dyn à lancer."
                       Foreground="Gray"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bouton à configurer :"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="ButtonComboBox"
                      Grid.Column="1"
                      Width="80"
                      SelectedIndex="0">
                <ComboBoxItem>1</ComboBoxItem>
                <ComboBoxItem>2</ComboBoxItem>
                <ComboBoxItem>3</ComboBoxItem>
                <ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>5</ComboBoxItem>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Texte affiché sur le ruban :"
                           Margin="0,0,15,4" />
                <TextBlock Text="Utilisez Entrée pour forcer un retour à la ligne."
                           FontSize="11"
                           Foreground="Gray" />
            </StackPanel>
            <TextBox x:Name="LabelTextBox"
                     Grid.Column="1"
                     Height="52"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     TextChanged="LabelTextBox_TextChanged"
                     VerticalContentAlignment="Top" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Script Dynamo à lancer :"
                       VerticalAlignment="Center" />
            <DockPanel Grid.Column="1">
                <TextBox x:Name="PathTextBox"
                         IsReadOnly="True"
                         Margin="0,0,6,0"
                         MinWidth="260"
                         ToolTip="Chemin complet du fichier .dyn sélectionné" />
                <Button Content="Parcourir..."
                        Click="BrowseButton_Click" />
            </DockPanel>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,0,0,12"
                Padding="10"
                BorderThickness="1"
                CornerRadius="4"
                BorderBrush="#FFBEBEBE">
            <StackPanel>
                <TextBlock Text="Aperçu du texte sur le ruban"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <Border Background="#FFF5F5F5"
                        Padding="8"
                        CornerRadius="4"
                        BorderBrush="#FFD4D4D4"
                        BorderThickness="1">
                    <TextBlock x:Name="PreviewTextBlock"
                               TextAlignment="Center"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="Annuler"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>