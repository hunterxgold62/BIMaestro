<!-- UI/CleanupWindow.xaml -->
<Window x:Class="MyRevitAddin.UI.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nettoyage du projet" Height="260" Width="340"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <TextBlock FontWeight="Bold" Margin="0,0,0,10"
               Text="Sélectionnez les opérations à réaliser :" />

        <CheckBox x:Name="ViewsCheckbox"
              Content="Supprimer vues non implantées"
              Margin="0,5"/>

        <CheckBox x:Name="FamiliesCheckbox"
              Content="Purger familles inutilisées (douce)"
              Margin="0,5"/>

        <CheckBox x:Name="SchedulesCheckbox"
              Content="Supprimer nomenclatures inutilisées"
              Margin="0,5"/>

        <!-- Nouvelle case forte -->
        <CheckBox x:Name="HardFamiliesCheckbox"
              Content="Purger familles inutilisées (méthode forte)"
              Margin="0,5"/>
        <TextBlock Foreground="DarkRed" FontWeight="Bold"
               Text="⚠️ À exécuter en DERNIER, peut provoquer des erreurs." />

        <!-- Avertissement à faire en dernier -->

        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <Button x:Name="OkButton"
              Content="OK"
              Width="75"
              Margin="5"
              Click="OkButton_Click"/>
            <Button x:Name="CancelButton"
              Content="Annuler"
              Width="75"
              Margin="5"
              Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
