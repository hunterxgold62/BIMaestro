<Window x:Class="Modification.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Nettoyage du projet"
        Width="560"
        Height="600"
        MinWidth="520"
        MinHeight="520"
        Background="{DynamicResource App.Background}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Micro-style local : rend les checkboxes plus respirantes -->
            <Style x:Key="CleanupCheck" TargetType="{x:Type CheckBox}">
                <Setter Property="Margin" Value="0,8,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========= HEADER ========= -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brand}"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource H1}" Text="Nettoyage du projet"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#E7F6EE"
                               TextWrapping="Wrap"
                               Text="Sélectionnez les opérations à réaliser. Une question proposera de créer « NomDuFichier - Purger.rvt » avant exécution."/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="HelpButton"
                        Content="?"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="Ouvrir l’aide en ligne"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <!-- ========= CONTENT (scrollable) ========= -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Style="{StaticResource H2}" Text="Opérations de nettoyage" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Astuce : commencez par les suppressions “safe”, puis terminez par la purge."
                               Margin="0,0,0,10"/>

                    <!-- Bloc "safe" -->
                    <Border Background="{DynamicResource Surface.Subtle}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="Étapes recommandées"/>

                            <CheckBox x:Name="ViewsCheckbox"
                                      Style="{StaticResource CleanupCheck}"
                                      Content="Supprimer les vues non placées sur feuille"
                                      ToolTip="Supprime les vues (plans, coupes, 3D, détails, rendus) non placées et différentes de la vue active."/>

                            <CheckBox x:Name="SchedulesCheckbox"
                                      Style="{StaticResource CleanupCheck}"
                                      Content="Supprimer les nomenclatures inutilisées"
                                      ToolTip="Supprime les nomenclatures jamais placées qui contiennent « Interne » dans leur nom."/>

                            <CheckBox x:Name="FamiliesCheckbox"
                                      Style="{StaticResource CleanupCheck}"
                                      Content="Purger les familles inutilisées (méthode douce)"
                                      ToolTip="Liste et purge via la commande native Revit « Purger les éléments inutilisés »."/>
                        </StackPanel>
                    </Border>

                    <!-- Bloc "danger" -->
                    <Border Background="{DynamicResource Warm.Highlight}"
                            BorderBrush="{DynamicResource Warm.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="⚠ Méthode forte — à exécuter en dernier"/>

                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,6,0,10"
                                       TextWrapping="Wrap"
                                       Text="Essaie de supprimer de force les familles chargées non utilisées (hors familles système usuelles). Peut provoquer des avertissements ou des échecs selon les dépendances."/>
                            <CheckBox x:Name="HardFamiliesCheckbox"
                                      Content="Purger les familles inutilisées (méthode forte)"
                                      ToolTip="Supprime agressivement les familles non instanciées. À utiliser uniquement après les autres opérations."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Hint}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Text="Recommandé : lancez la méthode forte seulement après les étapes ci-dessus."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========= FOOTER ========= -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Content="Annuler"
                    MinWidth="140"
                    Height="38"
                    Margin="0,0,12,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>

            <Button x:Name="OkButton"
                    Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    Content="Lancer"
                    MinWidth="170"
                    Height="38"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>