<Window x:Class="Analyse.ElementHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qui a fait ça ??" Height="860" Width="1330" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="HistoryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
            </Style>

            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="ScopeRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Pill"
                                    Background="{DynamicResource Surface.Subtle}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Focus}"/>
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HistoryTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="bd"
                                        Background="Transparent"
                                        CornerRadius="12"
                                        Padding="16,10">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="Accent"
                                        Height="3"
                                        CornerRadius="2"
                                        Background="{DynamicResource Focus}"
                                        VerticalAlignment="Bottom"
                                        Margin="12,0,12,1"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                                    <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover.Fill}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VisualCardItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SelectionBorder"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="2">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTimelineSeparator}" Value="True">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="Margin" Value="0,6,0,10"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18,18,26,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock x:Name="HeaderText" Style="{StaticResource H1}" Text="Qui a fait ça ??"/>
                <TextBlock x:Name="HeaderSubtitleText"
                           Margin="0,6,0,0"
                           Text="BETA - Lecture visuelle des suppressions, déplacements, créations et clusters de la maquette."
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="HelpButton"
                        Content="?"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="Ouvrir l'aide en ligne"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Grid.Column="0" Columns="5">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Evènements" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TotalStatText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Suppressions" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="DeleteStatText" FontSize="18" FontWeight="Bold" Foreground="#FFD83030" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Déplacements" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="MoveStatText" FontSize="18" FontWeight="Bold" Foreground="#FFE28A00" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Créations" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="CreateStatText" FontSize="18" FontWeight="Bold" Foreground="#FF278D42" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Utilisateurs" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="UserStatText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Action" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="ActionFilterCombo" Width="155" Margin="0,0,12,0" SelectionChanged="ActionFilterCombo_SelectionChanged"/>
                    <TextBlock Text="Utilisateur" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="UserFilterCombo" Width="150" Margin="0,0,12,0" SelectionChanged="UserFilterCombo_SelectionChanged"/>
                    <TextBlock Text="Recherche" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="SearchBox" Width="210" Margin="0,0,12,0" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Jour" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="HistoryDayPicker" Width="125" Margin="0,0,8,0"/>
                    <Button x:Name="LoadDayButton" Content="Charger jour" Width="115" Style="{StaticResource HistoryButton}" Click="LoadDayButton_Click"/>
                    <TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Text="0 / 0 évènements affichés"/>
                </WrapPanel>
                <WrapPanel x:Name="ContextScopePanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ContextScopeText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,0,10,6"
                               Text="Portée"/>
                    <RadioButton x:Name="ScopeElementRadio"
                                 Content="Élément"
                                 GroupName="HistoryScope"
                                 Tag="element"
                                 IsChecked="True"
                                 Style="{StaticResource ScopeRadioStyle}"
                                 Checked="ScopeFilter_Checked"/>
                    <RadioButton x:Name="ScopeTypeRadio"
                                 Content="Type"
                                 GroupName="HistoryScope"
                                 Tag="type"
                                 Style="{StaticResource ScopeRadioStyle}"
                                 Checked="ScopeFilter_Checked"/>
                    <RadioButton x:Name="ScopeFamilyRadio"
                                 Content="Famille"
                                 GroupName="HistoryScope"
                                 Tag="family"
                                 Style="{StaticResource ScopeRadioStyle}"
                                 Checked="ScopeFilter_Checked"/>
                    <RadioButton x:Name="ScopeModelRadio"
                                 Content="Maquette"
                                 GroupName="HistoryScope"
                                 Tag="model"
                                 Style="{StaticResource ScopeRadioStyle}"
                                 Checked="ScopeFilter_Checked"/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="VisualizeDeletedButton" Content="Visualiser évènement" Width="175" Style="{StaticResource HistoryButton}" Click="VisualizeDeletedButton_Click"/>
                    <Button x:Name="FocusButton" Content="Focus élément" Width="135" Style="{StaticResource HistoryButton}" Click="FocusButton_Click"/>
                    <Button x:Name="DetailsButton" Content="Détails" Width="100" Style="{StaticResource HistoryButton}" Click="DetailsButton_Click"/>
                    <Button x:Name="RestoreParametersButton" Content="Restaurer avant" Width="145" Style="{StaticResource HistoryButton}" Click="RestoreParametersButton_Click" IsEnabled="False"/>
                    <Button x:Name="CleanPreviewsButton" Content="Nettoyer previews" Width="155" Style="{StaticResource HistoryButton}" Click="CleanPreviewsButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl x:Name="HistoryTabs" Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" Padding="0" ClipToBounds="False">
            <TabItem Header="Vue visuelle" Style="{StaticResource HistoryTabItem}">
                <Border Style="{StaticResource Card}" Padding="10,10,18,10" Margin="0,10,0,0">
                    <ListBox x:Name="VisualCardsList"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionMode="Single"
                             ItemContainerStyle="{StaticResource VisualCardItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             SelectionChanged="VisualCardsList_SelectionChanged"
                             MouseDoubleClick="VisualCardsList_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Visibility="{Binding TimelineSeparatorVisibility}"
                                            Margin="0,2,12,2"
                                            Padding="2,0,6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimelineTitle}"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,12,0"/>
                                            <Border Grid.Column="1"
                                                    Height="1"
                                                    Background="{DynamicResource Border}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Width="214"
                                        Height="246"
                                        Style="{StaticResource Card}"
                                        Padding="0"
                                        BorderBrush="{Binding AccentSoftBrush}"
                                        Visibility="{Binding CardVisibility}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Voir cette famille"
                                                          Click="QuickFilterFamily_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Voir ce type"
                                                          Click="QuickFilterType_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Voir cet utilisateur"
                                                          Click="QuickFilterUser_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Voir cette action"
                                                          Click="QuickFilterAction_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Réinitialiser les filtres"
                                                          Click="QuickFilterReset_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="142"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    CornerRadius="14,14,0,0"
                                                    Background="{Binding AccentSoftBrush}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <ItemsControl ItemsSource="{Binding MosaicImages}"
                                                                  Visibility="{Binding MosaicVisibility}"
                                                                  Margin="12">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="2" Columns="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="3"
                                                                        Background="White"
                                                                        CornerRadius="8"
                                                                        ClipToBounds="True">
                                                                    <Image Source="{Binding}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           MaxWidth="54"
                                                                           MaxHeight="54"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Image Source="{Binding ImagePath}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="142"
                                                           MaxHeight="142"
                                                           Visibility="{Binding ImageVisibility}"/>
                                                    <TextBlock Text="{Binding VisualInitials}"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               FontSize="34"
                                                               FontWeight="Bold"
                                                               Opacity="0.38"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding InitialsVisibility}"/>

                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="8"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="12"
                                                            Padding="9,4">
                                                        <TextBlock Text="{Binding TileCountText}"
                                                                   Foreground="White"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="9"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="12"
                                                            MinWidth="64"
                                                            Height="30"
                                                            Padding="10,0">
                                                        <TextBlock Text="{Binding ActionBadgeShort}"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Margin="9"
                                                            Background="#FF111827"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            Visibility="{Binding ImportanceBadgeVisibility}">
                                                        <TextBlock Text="{Binding ImportanceBadgeText}"
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="12,10,12,6">
                                                <TextBlock Text="{Binding TileTitle}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="38"/>
                                                <TextBlock Text="{Binding TileSubtitle}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Margin="12,0,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TileTimeText}"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           FontSize="11"/>
                                                <Ellipse Grid.Column="1"
                                                         Width="10"
                                                         Height="10"
                                                         Fill="{Binding AccentBrush}"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>

            <TabItem Header="Données" Style="{StaticResource HistoryTabItem}">
                <Border Style="{StaticResource Card}" Padding="8,8,14,8" Margin="0,10,0,0">
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" SelectionMode="Extended"
                              MouseDoubleClick="HistoryGrid_MouseDoubleClick" SelectionChanged="HistoryGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id / Groupe" Binding="{Binding ElementIdText}" Width="95"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="160"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="150"/>
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="130"/>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Famille" Binding="{Binding Family}" Width="140"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="160"/>
                            <DataGridTextColumn Header="Position / Delta" Binding="{Binding PositionText}" Width="250"/>
                            <DataGridTextColumn Header="Transaction" Binding="{Binding Tx}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <Border x:Name="DetailsPanel" Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="420" Margin="12,0,0,0"
                Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Détails évènement" Style="{StaticResource H2}" FontSize="16" Margin="0,0,0,10"/>
                <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                </ScrollViewer>
                <ListBox Grid.Row="2" x:Name="ClusterListBox" DisplayMemberPath="Display" Visibility="Collapsed"
                         SelectionMode="Extended"
                         HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="ClusterListBox_MouseDoubleClick">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface.Subtle}"
                                            CornerRadius="8"
                                            Padding="8,5"
                                            Margin="0,8,0,4">
                                        <TextBlock Foreground="{DynamicResource Text.Primary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  ·  {1} éléments">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="ItemCount"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
                <WrapPanel Grid.Row="3" x:Name="ClusterActionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Button x:Name="ClusterVisualizeButton" Content="Visualiser sélection" Width="160" Style="{StaticResource HistoryButton}" Click="ClusterVisualizeButton_Click"/>
                    <Button x:Name="ClusterFocusButton" Content="Focus sélection" Width="140" Style="{StaticResource HistoryButton}" Click="ClusterFocusButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
