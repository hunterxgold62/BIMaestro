<Window x:Class="Visualisation.FamilySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Visualisation"
        Title="BIMaestro - Sélection des Familles"
        Height="560"
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TreeCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Margin" Value="2,2,0,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brand}"
                Padding="16,12"
                CornerRadius="0,0,12,12">
            <TextBlock Text="Sélection des Familles et Sous-Familles"
                       Style="{DynamicResource H1}"/>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <CheckBox x:Name="EntireModelCheckBox"
                              DockPanel.Dock="Left"
                              Style="{StaticResource TreeCheckBox}"
                              VerticalAlignment="Center"
                              Content="Étendre à toute la maquette"
                              ToolTip="Quand coché : collecte/sélection dans tout le projet, pas uniquement la vue active."
                              Checked="EntireModelScopeChanged"
                              Unchecked="EntireModelScopeChanged"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SelectAllViewsButton"
                                Style="{DynamicResource SecondaryButton}"
                                Content="Tout sélectionner"
                                Margin="0,0,8,0"
                                MinWidth="160"
                                Click="SelectAllViewsButton_Click"/>
                        <Button x:Name="DeselectAllViewsButton"
                                Style="{DynamicResource SecondaryButton}"
                                Content="Tout désélectionner"
                                MinWidth="180"
                                Click="DeselectAllViewsButton_Click"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TreeView x:Name="FamiliesTreeView"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:FamilyItem}"
                                                          ItemsSource="{Binding VisibleSubFamilies}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource TreeCheckBox}"
                                                  Content="{Binding Name}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="16,0,16,16" Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Terminer"
                            Style="{DynamicResource PrimaryButton}"
                            IsDefault="True"
                            Margin="0,0,8,0"
                            Click="FinishButton_Click"/>
                    <Button Content="Annuler"
                            Style="{DynamicResource SecondaryButton}"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>