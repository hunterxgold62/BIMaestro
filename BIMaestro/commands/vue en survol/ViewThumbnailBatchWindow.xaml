<Window x:Class="BIMaestro.ViewHover.ViewThumbnailBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Miniatures des vues"
        Width="620"
        Height="550"
        MinWidth="560"
        MinHeight="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Margin="0,0,0,14"
                CornerRadius="14"
                Background="{StaticResource Brand}">
            <StackPanel>
                <TextBlock Text="Miniatures des vues"
                           Style="{StaticResource H1}"/>
                <TextBlock x:Name="DocumentText"
                           Margin="0,6,0,0"
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Vues à traiter"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <ComboBox x:Name="ModeComboBox"
                              Margin="0,8,0,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Miniatures manquantes et obsolètes"/>
                        <ComboBoxItem Content="Miniatures manquantes uniquement"/>
                        <ComboBoxItem Content="Toutes les miniatures"/>
                    </ComboBox>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Les gabarits, vues internes, nomenclatures non graphiques et vues non imprimables sont ignorés."
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="StartButton"
                        Grid.Column="1"
                        Width="120"
                        Height="38"
                        VerticalAlignment="Center"
                        Content="Démarrer"
                        Click="StartButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                MinHeight="180"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="Prêt à démarrer."/>
                    <TextBlock x:Name="CounterText"
                               Grid.Column="1"
                               Margin="12,0,0,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brand}"
                               Text="0 / 0"/>
                </Grid>

                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="1"
                             Height="12"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="1"
                             Value="0"/>

                <TextBlock x:Name="CurrentViewText"
                           Grid.Row="2"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="Vue : —"
                           TextTrimming="CharacterEllipsis"/>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText"
                               Grid.Column="0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Écoulé : —"/>
                    <TextBlock x:Name="RemainingText"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Restant estimé : —"/>
                    <TextBlock x:Name="FailedText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Échecs : 0"/>
                </Grid>

                <TextBlock Grid.Row="4"
                           Margin="0,16,0,0"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Une vue est exportée à la fois pendant l’inactivité de Revit. Pause et arrêt sont pris en compte après la capture en cours. Les miniatures déjà terminées restent enregistrées."/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PauseResumeButton"
                    Grid.Column="1"
                    Width="110"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="Pause"
                    IsEnabled="False"
                    Click="PauseResumeButton_Click"/>
            <Button x:Name="StopButton"
                    Grid.Column="2"
                    Width="110"
                    Height="34"
                    Content="Arrêter"
                    IsEnabled="False"
                    Click="StopButton_Click"/>
        </Grid>
    </Grid>
</Window>
