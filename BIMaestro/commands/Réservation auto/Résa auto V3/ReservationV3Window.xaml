<Window x:Class="Modification.ReservationAutoV3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="BIMaestro - Réservations Auto (V3)"
        Height="780"
        Width="920"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsSection" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="4,6,4,18"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>

            <Style x:Key="SettingsTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========= HEADER ========= -->
        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Réservations automatiques" Style="{StaticResource H1}"/>

                <Button Grid.Column="1"
                        Content="?"
                        Width="28"
                        Height="28"
                        FontWeight="Bold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip="Ouvrir l'aide en ligne"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <!-- ========= CONTENT ========= -->
        <TabControl Grid.Row="1">

            <!-- ========= TAB 1 ========= -->
            <TabItem Header="Exécution" Margin="0,0,-1,0">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                            <StackPanel>

                                <TextBlock Text="Cibles"
                                           Style="{StaticResource H2}"
                                           Margin="0,0,0,14"/>

                                <!-- ===== SUPPORT ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Support"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <WrapPanel Grid.Column="1"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="hostMurCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnMurGifHover"
                                                    MouseLeftButtonUp="OnMurHostClick"
                                                    ToolTip="Mur">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgHostMur"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtHostMurFallback"
                                                                       Text="Mur"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Mur"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="hostSolCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,0,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnSolGifHover"
                                                    MouseLeftButtonUp="OnSolHostClick"
                                                    ToolTip="Sol">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgHostSol"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtHostSolFallback"
                                                                       Text="Sol"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Sol"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- ===== FORME ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Forme"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <WrapPanel Grid.Column="1"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="shapeRectCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnShapeRectHover"
                                                    MouseLeftButtonUp="OnShapeRectClick"
                                                    ToolTip="Rectangulaire">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgShapeRect"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtShapeRectFallback"
                                                                       Text="Rect."
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Rectangulaire"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="shapeCircCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnShapeCircHover"
                                                    MouseLeftButtonUp="OnShapeCircClick"
                                                    ToolTip="Circulaire">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgShapeCirc"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtShapeCircFallback"
                                                                       Text="Circ."
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Circulaire"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Variante dans la même ligne -->
                                            <Border Background="{StaticResource Surface}"
                                                    BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="12"
                                                    MinWidth="240"
                                                    Height="128">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="Variante"
                                                               Style="{StaticResource Label}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,0,0,8"/>

                                                    <ComboBox Grid.Row="1"
                                                              x:Name="comboShape"
                                                              Height="34"
                                                              VerticalAlignment="Center"
                                                              IsEditable="True"
                                                              SelectionChanged="OnShapeVariantChanged"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- ===== TYPE D'OBJET ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Objet"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <WrapPanel Grid.Column="1"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="objPipeCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjPipeHover"
                                                    MouseLeftButtonUp="OnObjPipeClick"
                                                    ToolTip="Canalisation">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjPipe"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjPipeFallback"
                                                                       Text="Cana"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Canalisation"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objDuctCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjDuctHover"
                                                    MouseLeftButtonUp="OnObjDuctClick"
                                                    ToolTip="Gaine">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjDuct"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjDuctFallback"
                                                                       Text="Gaine"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Gaine"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objDoorCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjDoorHover"
                                                    MouseLeftButtonUp="OnObjDoorClick"
                                                    ToolTip="Porte">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjDoor"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjDoorFallback"
                                                                       Text="Porte"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Porte"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objWindowCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjWindowHover"
                                                    MouseLeftButtonUp="OnObjWindowClick"
                                                    ToolTip="Fenêtre">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjWindow"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjWindowFallback"
                                                                       Text="Fenêtre"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Fenêtre"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objOtherCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,0,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjOtherHover"
                                                    MouseLeftButtonUp="OnObjOtherClick"
                                                    ToolTip="Autre">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjOther"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjOtherFallback"
                                                                       Text="Autre"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Autre"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <ComboBox x:Name="comboObjectType"
                                          Height="1"
                                          Width="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          SelectionChanged="OnCriteriaChanged">
                                    <ComboBoxItem Content="Canalisation"/>
                                    <ComboBoxItem Content="Gaine"/>
                                    <ComboBoxItem Content="Porte"/>
                                    <ComboBoxItem Content="Fenêtre"/>
                                    <ComboBoxItem Content="Autre"/>
                                </ComboBox>

                                <!-- ===== SOURCE ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Source"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Canalisation / gaine"
                                                       Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="comboPipeSource"
                                                      Height="34"
                                                      VerticalAlignment="Center">
                                                <ComboBoxItem Content="Maquette"/>
                                                <ComboBoxItem Content="Lien IFC"/>
                                                <ComboBoxItem Content="Lien RVT"/>
                                            </ComboBox>

                                            <CheckBox x:Name="chkDoubleLink"
                                                      Content="Double lien"
                                                      Checked="OnModeChanged"
                                                      Unchecked="OnModeChanged"
                                                      Margin="0,8,0,0"/>

                                            <TextBlock Text="Lien IFC/RVT : clique soit une cana/gaine locale, soit une cana/gaine du lien. Le mur à sélectionner sera automatiquement de l'autre maquette. Double lien limite les deux sélections aux liens ; le même lien peut contenir les deux éléments."
                                                       Style="{StaticResource Hint}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ===== OPTIONS ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel>
                                        <CheckBox x:Name="chkAutomatique"
                                                  Content="Mode automatique (scan – mur uniquement)"
                                                  Checked="OnModeChanged"
                                                  Unchecked="OnModeChanged"
                                                  Margin="0,0,0,6"/>

                                        <CheckBox x:Name="chkMulti"
                                                  Content="Multi-sélection (canalisations – rectangle)"
                                                  IsEnabled="False"
                                                  Margin="0,0,0,10"/>

                                        <CheckBox x:Name="chkNorme"
                                                  Content="Arrondir aux 50 mm supérieurs"
                                                  Margin="0,0,0,6"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="chkDynamo"
                                                      Content="Exécuter Dynamo automatiquement"
                                                      VerticalAlignment="Center"/>

                                            <Border Margin="8,0,0,0"
                                                    Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    ToolTipService.InitialShowDelay="120">
                                                <Grid>
                                                    <ToggleButton x:Name="btnDynamoInfo"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}"
                                                                  Cursor="Hand">
                                                        <TextBlock Text="i"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Text.Secondary}"/>
                                                    </ToggleButton>

                                                    <Popup PlacementTarget="{Binding ElementName=btnDynamoInfo}"
                                                           Placement="Bottom"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Fade"
                                                           StaysOpen="False"
                                                           IsOpen="{Binding IsChecked, ElementName=btnDynamoInfo, Mode=TwoWay}">
                                                        <Border Background="{StaticResource Surface}"
                                                                BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="12"
                                                                Margin="0,8,0,0"
                                                                MaxWidth="360">
                                                            <TextBlock Text="Option facultative : lance un script Dynamo après la création/mise à jour des réservations pour renseigner ou corriger automatiquement des paramètres. Vous pouvez utiliser votre propre script adapté à vos familles et à votre méthode projet."
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Text.Primary}"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========= TAB 2 ========= -->
            <TabItem Header="Familles">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Votre famille de réservation" Style="{StaticResource SettingsTitle}"/>
                                        <TextBlock Text="Choisissez le cas à configurer. Les familles BIMaestro restent disponibles en solution de secours."
                                                   Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               x:Name="txtConfigProgress"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brand}"
                                               VerticalAlignment="Top"
                                               Margin="18,2,0,0"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Support" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbConfigSupport" Height="34" SelectedIndex="0" SelectionChanged="OnConfigContextChanged">
                                            <ComboBoxItem Content="Mur"/>
                                            <ComboBoxItem Content="Sol"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Forme" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbConfigShape" Height="34" SelectedIndex="0" SelectionChanged="OnConfigContextChanged">
                                            <ComboBoxItem Content="Rectangulaire"/>
                                            <ComboBoxItem Content="Circulaire"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Hébergement" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbConfigHosting" Height="34" SelectedIndex="0" SelectionChanged="OnConfigContextChanged">
                                            <ComboBoxItem Content="Avec hôte"/>
                                            <ComboBoxItem Content="Sans hôte"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Brand}"
                                        BorderThickness="3,0,0,0"
                                        Padding="10,8"
                                        Margin="0,2,0,0">
                                    <TextBlock x:Name="txtSelectedConfigStatus" Style="{StaticResource Hint}"/>
                                </Border>

                                <ComboBox x:Name="cbTargetProfile" Visibility="Collapsed" SelectionChanged="OnTargetProfileChanged">
                                    <ComboBoxItem Content="Mur - Rectangulaire"/>
                                    <ComboBoxItem Content="Mur - Circulaire"/>
                                    <ComboBoxItem Content="Sol - Rectangulaire"/>
                                    <ComboBoxItem Content="Sol - Circulaire"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <TextBlock Text="Famille et type" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Les Modèles génériques compatibles sont affichés en premier, puis les autres catégories."
                                           Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                                <ComboBox x:Name="cbLoadedType" Height="34" DisplayMemberPath="Display" SelectionChanged="OnLoadedTypeChanged"/>

                                <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,6,0,12"/>

                                <TextBlock Text="Importer une famille RFA"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="Facultatif : utilisez cette zone uniquement si la famille n'est pas encore chargée dans le projet."
                                           Style="{StaticResource Hint}" Margin="0,3,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="tbRfaPath" IsReadOnly="True" Height="34"/>
                                    <Button Grid.Column="2"
                                            x:Name="btnBrowseRfa"
                                            Content="Parcourir…"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnBrowseRfa"/>
                                    <Button Grid.Column="4"
                                            x:Name="btnLoadRfa"
                                            Content="Charger dans le projet"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnLoadRfa"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSection}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Paramètres de dimensions" Style="{StaticResource SettingsTitle}"/>
                                    <TextBlock Text="Sélectionnez un paramètre existant ou saisissez son nom."
                                               Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                                    <StackPanel x:Name="panelMapRectWall" Visibility="Collapsed">
                                        <TextBlock Text="Longueur (axe du mur)" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallLen" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Hauteur" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="cbMapWallHeight" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="cbMapWallDepth" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircWall" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallDiam" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="cbMapWallDepth2" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapRectFloor" Visibility="Collapsed">
                                        <TextBlock Text="Longueur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorLen" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Largeur" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="cbMapFloorWidth" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="cbMapFloorDepth" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircFloor" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorDiam" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="cbMapFloorDepth2" Height="34" IsEditable="True"/>
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Divider}" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Placement vertical" Style="{StaticResource SettingsTitle}"/>
                                    <TextBlock Text="Le mode automatique convient à la plupart des familles. Ajustez-le selon leur construction."
                                               Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                                    <TextBlock Text="Référence verticale" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="cbVerticalReference"
                                              Height="34"
                                              SelectionChanged="OnVerticalPlacementChanged">
                                        <ComboBoxItem Content="Automatique"/>
                                        <ComboBoxItem Content="Centre"/>
                                        <ComboBoxItem Content="Bas"/>
                                        <ComboBoxItem Content="Haut"/>
                                    </ComboBox>

                                    <TextBlock Text="Décalage vertical (mm)" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="tbVerticalOffset" Height="34" Text="0"/>

                                    <Button x:Name="btnApplyMapping"
                                            Content="Enregistrer cette famille"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,12,0,0"
                                            Click="OnApplyMapping"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========= TAB 3 ========= -->
            <TabItem Header="Réglages">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsSection}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Arrondi des dimensions" Style="{StaticResource SettingsTitle}"/>
                                    <TextBlock Text="Chaque dimension calculée est portée au multiple de 50 mm immédiatement supérieur. Aucun jeu de 50 mm n'est ajouté avant l'arrondi."
                                               Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="chkDefaultNorme" Content="Activer l'arrondi aux 50 mm supérieurs par défaut"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Divider}" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Exemple" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="232 mm  →  250 mm"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brand}"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsSection}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Enrichissement avec Dynamo" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Dynamo n'est pas nécessaire pour créer les réservations. Dans mon cas, je l'utilise pour ajouter automatiquement les hauteurs NGF dans la famille de réservation : c'est la raison pour laquelle cette option existe. Laissez-la désactivée si vous n'en avez pas besoin."
                                           Style="{StaticResource Hint}" Margin="0,0,0,14"/>

                                <TextBlock Text="Chemin du script Dynamo (.dyn)" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="tbDynamoPath" Height="34"/>
                                    <Button Grid.Column="2"
                                            Content="Parcourir…"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnBrowseDynamo"/>
                                </Grid>

                                <CheckBox x:Name="chkDefaultDynamo"
                                          Content="Exécuter le script Dynamo par défaut"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Enregistrer les réglages"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Margin="0,2,0,0"
                                Click="OnSaveOnly"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ========= FOOTER ACTIONS ========= -->
        <Border Grid.Row="2"
                Background="Transparent"
                Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            MinWidth="140"
                            IsCancel="True"
                            Click="OnCancel"/>
                    <Button Content="Lancer la réservation"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            MinWidth="200"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Click="OnOk"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
