<Window x:Class="Modification.ReservationAutoV3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="BIMaestro - Réservations Auto (V3)"
        Height="780"
        Width="920"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========= HEADER ========= -->
        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Réservations automatiques" Style="{StaticResource H1}"/>
            </StackPanel>
        </Border>

        <!-- ========= CONTENT ========= -->
        <TabControl Grid.Row="1">

            <!-- ========= TAB 1 ========= -->
            <TabItem Header="Exécution" Margin="0,0,-1,0">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                            <StackPanel>

                                <TextBlock Text="Cibles"
                                           Style="{StaticResource H2}"
                                           Margin="0,0,0,14"/>

                                <!-- ===== SUPPORT ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Support"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <WrapPanel Grid.Column="1"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="hostMurCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnMurGifHover"
                                                    MouseLeftButtonUp="OnMurHostClick"
                                                    ToolTip="Mur">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgHostMur"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtHostMurFallback"
                                                                       Text="Mur"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Mur"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="hostSolCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,0,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnSolGifHover"
                                                    MouseLeftButtonUp="OnSolHostClick"
                                                    ToolTip="Sol">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgHostSol"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtHostSolFallback"
                                                                       Text="Sol"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Sol"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- ===== FORME ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Forme"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <WrapPanel Grid.Column="1"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="shapeRectCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnShapeRectHover"
                                                    MouseLeftButtonUp="OnShapeRectClick"
                                                    ToolTip="Rectangulaire">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgShapeRect"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtShapeRectFallback"
                                                                       Text="Rect."
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Rectangulaire"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="shapeCircCard"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,10,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnShapeCircHover"
                                                    MouseLeftButtonUp="OnShapeCircClick"
                                                    ToolTip="Circulaire">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgShapeCirc"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtShapeCircFallback"
                                                                       Text="Circ."
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Circulaire"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Variante dans la même ligne -->
                                            <Border Background="{StaticResource Surface}"
                                                    BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="12"
                                                    MinWidth="240"
                                                    Height="128">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="Variante"
                                                               Style="{StaticResource Label}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,0,0,8"/>

                                                    <ComboBox Grid.Row="1"
                                                              x:Name="comboShape"
                                                              Height="34"
                                                              VerticalAlignment="Center"
                                                              IsEditable="True"
                                                              SelectionChanged="OnShapeVariantChanged"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- ===== TYPE D'OBJET ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Objet"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <WrapPanel Grid.Column="1"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="objPipeCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjPipeHover"
                                                    MouseLeftButtonUp="OnObjPipeClick"
                                                    ToolTip="Canalisation">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjPipe"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjPipeFallback"
                                                                       Text="Cana"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Canalisation"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objDuctCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjDuctHover"
                                                    MouseLeftButtonUp="OnObjDuctClick"
                                                    ToolTip="Gaine">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjDuct"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjDuctFallback"
                                                                       Text="Gaine"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Gaine"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objDoorCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjDoorHover"
                                                    MouseLeftButtonUp="OnObjDoorClick"
                                                    ToolTip="Porte">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjDoor"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjDoorFallback"
                                                                       Text="Porte"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Porte"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objWindowCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjWindowHover"
                                                    MouseLeftButtonUp="OnObjWindowClick"
                                                    ToolTip="Fenêtre">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjWindow"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjWindowFallback"
                                                                       Text="Fenêtre"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Fenêtre"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="objOtherCard"
                                                    Width="112"
                                                    Height="124"
                                                    Margin="0,0,0,0"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand"
                                                    MouseEnter="OnObjOtherHover"
                                                    MouseLeftButtonUp="OnObjOtherClick"
                                                    ToolTip="Autre">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            CornerRadius="12"
                                                            Background="{StaticResource Surface.Subtle}"
                                                            BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1"
                                                            Padding="8">
                                                        <Grid>
                                                            <Image x:Name="imgObjOther"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="txtObjOtherFallback"
                                                                       Text="Autre"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Text="Autre"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <ComboBox x:Name="comboObjectType"
                                          Height="1"
                                          Width="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          SelectionChanged="OnCriteriaChanged">
                                    <ComboBoxItem Content="Canalisation"/>
                                    <ComboBoxItem Content="Gaine"/>
                                    <ComboBoxItem Content="Porte"/>
                                    <ComboBoxItem Content="Fenêtre"/>
                                    <ComboBoxItem Content="Autre"/>
                                </ComboBox>

                                <!-- ===== SOURCE ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Source"
                                                   Style="{StaticResource Label}"
                                                   VerticalAlignment="Center"/>

                                        <ComboBox Grid.Column="1"
                                                  x:Name="comboPipeSource"
                                                  Height="34"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="Maquette"/>
                                            <ComboBoxItem Content="Lien IFC"/>
                                            <ComboBoxItem Content="Lien RVT"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- ===== OPTIONS ===== -->
                                <Border Background="{StaticResource Surface.Subtle}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel>
                                        <CheckBox x:Name="chkAutomatique"
                                                  Content="Mode automatique (scan – mur uniquement)"
                                                  Margin="0,0,0,6"/>

                                        <CheckBox x:Name="chkMulti"
                                                  Content="Multi-sélection (canalisations – rectangle)"
                                                  IsEnabled="False"
                                                  Margin="0,0,0,10"/>

                                        <CheckBox x:Name="chkNorme"
                                                  Content="Appliquer la norme (arrondi 50 mm)"
                                                  Margin="0,0,0,6"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="chkDynamo"
                                                      Content="Exécuter Dynamo automatiquement"
                                                      VerticalAlignment="Center"/>

                                            <Border Margin="8,0,0,0"
                                                    Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource Border}"
                                                    Background="{StaticResource Surface}"
                                                    ToolTipService.InitialShowDelay="120">
                                                <Grid>
                                                    <ToggleButton x:Name="btnDynamoInfo"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  FocusVisualStyle="{x:Null}"
                                                                  Cursor="Hand">
                                                        <TextBlock Text="i"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Text.Secondary}"/>
                                                    </ToggleButton>

                                                    <Popup PlacementTarget="{Binding ElementName=btnDynamoInfo}"
                                                           Placement="Bottom"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Fade"
                                                           StaysOpen="False"
                                                           IsOpen="{Binding IsChecked, ElementName=btnDynamoInfo, Mode=TwoWay}">
                                                        <Border Background="{StaticResource Surface}"
                                                                BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="12"
                                                                Margin="0,8,0,0"
                                                                MaxWidth="360">
                                                            <TextBlock Text="Option facultative : lance un script Dynamo après la création/mise à jour des réservations pour renseigner ou corriger automatiquement des paramètres. Vous pouvez utiliser votre propre script adapté à vos familles et à votre méthode projet."
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Text.Primary}"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========= TAB 2 ========= -->
            <TabItem Header="Configuration (familles)" Margin="7,0,-7,0">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Configuration actuelle" Style="{StaticResource H2}"/>
                            <TextBlock Text="Les profils ci-dessous sont détectés automatiquement quand les familles sont disponibles dans le projet."
                                       Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                            <Border Background="{StaticResource Surface.Subtle}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Profils actifs"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mur – Rectangle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtWallRect" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mur – Cercle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtWallCirc" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sol – Rectangle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtFloorRect" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sol – Cercle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtFloorCirc" Foreground="{StaticResource Text.Secondary}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Ajouter / configurer une famille" Style="{StaticResource H2}"/>

                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <StackPanel>

                                    <TextBlock Text="1) Charger un fichier .RFA de réservation"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez le fichier source puis cliquez sur « Charger dans le projet »."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                        <Button x:Name="btnBrowseRfa"
                                                Content="Parcourir…"
                                                Width="130"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnBrowseRfa"/>
                                        <TextBox x:Name="tbRfaPath" IsReadOnly="True" Height="34"/>
                                    </DockPanel>

                                    <Button x:Name="btnLoadRfa"
                                            Content="Charger dans le projet"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="38"
                                            Click="OnLoadRfa"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="2) Associer la famille à un profil"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez le profil cible puis le type si nécessaire."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <ComboBox x:Name="cbTargetProfile" Height="34" SelectionChanged="OnTargetProfileChanged">
                                        <ComboBoxItem Content="Mur - Rectangulaire"/>
                                        <ComboBoxItem Content="Mur - Circulaire"/>
                                        <ComboBoxItem Content="Sol - Rectangulaire"/>
                                        <ComboBoxItem Content="Sol - Circulaire"/>
                                    </ComboBox>

                                    <TextBlock Text="Type (si la famille a plusieurs types)" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                    <ComboBox x:Name="cbLoadedType" Height="34" DisplayMemberPath="Display" SelectionChanged="OnLoadedTypeChanged"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="3) Mapping des paramètres"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez un paramètre existant ou saisissez un nom manuellement."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <StackPanel x:Name="panelMapRectWall" Visibility="Collapsed">
                                        <TextBlock Text="Longueur (axe mur)" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallLen" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Hauteur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapWallHeight" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapWallDepth" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircWall" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallDiam" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapWallDepth2" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapRectFloor" Visibility="Collapsed">
                                        <TextBlock Text="Longueur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorLen" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Largeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapFloorWidth" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapFloorDepth" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircFloor" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorDiam" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapFloorDepth2" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="4) Placement vertical"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Le mode Auto tente une détection. Corrigez si nécessaire selon la construction réelle de la famille."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <TextBlock Text="Référence verticale" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="cbVerticalReference"
                                              Height="34"
                                              SelectionChanged="OnVerticalPlacementChanged">
                                        <ComboBoxItem Content="Auto"/>
                                        <ComboBoxItem Content="Centre"/>
                                        <ComboBoxItem Content="Bas"/>
                                        <ComboBoxItem Content="Haut"/>
                                    </ComboBox>

                                    <TextBlock Text="Offset vertical (mm)" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                    <TextBox x:Name="tbVerticalOffset"
                                             Height="34"
                                             Text="0"/>

                                    <Button x:Name="btnApplyMapping"
                                            Content="Appliquer au profil + sauvegarder"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="38"
                                            Margin="0,12,0,0"
                                            Click="OnApplyMapping"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="Oversize Pipe/Duct (mm)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="tbOversize" Text="50" Height="34"/>

                                    <TextBlock Text="Chemin Dynamo" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                    <TextBox x:Name="tbDynamoPath" Height="34"/>

                                    <CheckBox x:Name="chkDefaultNorme" Content="Norme activée par défaut (arrondi)" Margin="0,12,0,6"/>
                                    <CheckBox x:Name="chkDefaultDynamo" Content="Dynamo auto activé par défaut"/>

                                    <Button Content="Sauvegarder config (sans changer les familles)"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            Margin="0,14,0,0"
                                            Click="OnSaveOnly"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <!-- ========= FOOTER ACTIONS ========= -->
        <Border Grid.Row="2"
                Background="Transparent"
                Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            MinWidth="140"
                            IsCancel="True"
                            Click="OnCancel"/>
                    <Button Content="Lancer la réservation"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            MinWidth="200"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Click="OnOk"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>