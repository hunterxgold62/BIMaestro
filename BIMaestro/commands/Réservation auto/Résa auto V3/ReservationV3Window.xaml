<Window x:Class="Modification.ReservationAutoV3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Réservations Auto (V3)"
        Height="780"
        Width="860"
        MinWidth="780"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========= HEADER (brand) ========= -->
        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,14"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock Text="Réservations automatiques" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,6,0,0"
                           Text="Choisissez vos cibles, puis lancez la réservation. Vous pouvez aussi associer vos familles personnalisées dans l’onglet dédié."
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ========= CONTENT ========= -->
        <TabControl Grid.Row="1">

            <!-- ========= TAB 1 ========= -->
            <TabItem Header="Exécution" Margin="0,0,-1,0">
                <!-- ✅ Onglet défilant : pas besoin d'afficher tout d’un coup -->
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card principale -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <!-- Form layout propre -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Titre -->
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Divider -->
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Divider -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="Cibles"
                                           Style="{StaticResource H2}"
                                           Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Support" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Row="1"
                                           Grid.Column="1"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Left">
                                    <Border x:Name="hostMurCard"
                                            Margin="0,0,6,0"
                                            Width="110"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource Border}"
                                            Background="{StaticResource Surface.Subtle}"
                                            Cursor="Hand"
                                            MouseEnter="OnMurGifHover"
                                            MouseLeftButtonUp="OnMurHostClick"
                                            ToolTip="Sélectionner Mur">
                                        <Grid Height="52">
                                            <Image x:Name="imgHostMur"
                                                   Stretch="Uniform"
                                                   Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="txtHostMurFallback"
                                                       Text="Mur"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="hostSolCard"
                                            Margin="6,0,0,0"
                                            Width="110"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource Border}"
                                            Background="{StaticResource Surface.Subtle}"
                                            Cursor="Hand"
                                            MouseEnter="OnSolGifHover"
                                            MouseLeftButtonUp="OnSolHostClick"
                                            ToolTip="Sélectionner Sol">
                                        <Grid Height="52">
                                            <Image x:Name="imgHostSol"
                                                   Stretch="Uniform"
                                                   Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="txtHostSolFallback"
                                                       Text="Sol"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Forme" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border x:Name="shapeRectCard"
                                                Width="110"
                                                Margin="0,0,6,0"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                BorderBrush="{StaticResource Border}"
                                                Background="{StaticResource Surface.Subtle}"
                                                Cursor="Hand"
                                                MouseEnter="OnShapeRectHover"
                                                MouseLeftButtonUp="OnShapeRectClick"
                                                ToolTip="Rectangulaire">
                                            <Grid Height="52">
                                                <Image x:Name="imgShapeRect" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtShapeRectFallback" Text="Rect." FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="shapeCircCard"
                                                Width="110"
                                                Margin="6,0,0,0"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                BorderBrush="{StaticResource Border}"
                                                Background="{StaticResource Surface.Subtle}"
                                                Cursor="Hand"
                                                MouseEnter="OnShapeCircHover"
                                                MouseLeftButtonUp="OnShapeCircClick"
                                                ToolTip="Circulaire">
                                            <Grid Height="52">
                                                <Image x:Name="imgShapeCirc" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtShapeCircFallback" Text="Circ." FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Variante :" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="comboShape"
                                                  Width="220"
                                                  Height="32"
                                                  IsEditable="True"
                                                  SelectionChanged="OnShapeVariantChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Type d’objet" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border x:Name="objPipeCard" Width="88" Margin="0,0,6,0" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface.Subtle}" Cursor="Hand" MouseEnter="OnObjPipeHover" MouseLeftButtonUp="OnObjPipeClick" ToolTip="Canalisation">
                                            <Grid Height="50">
                                                <Image x:Name="imgObjPipe" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtObjPipeFallback" Text="Cana" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="objDuctCard" Width="88" Margin="0,0,6,0" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface.Subtle}" Cursor="Hand" MouseEnter="OnObjDuctHover" MouseLeftButtonUp="OnObjDuctClick" ToolTip="Gaine">
                                            <Grid Height="50">
                                                <Image x:Name="imgObjDuct" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtObjDuctFallback" Text="Gaine" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="objDoorCard" Width="88" Margin="0,0,6,0" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface.Subtle}" Cursor="Hand" MouseEnter="OnObjDoorHover" MouseLeftButtonUp="OnObjDoorClick" ToolTip="Porte">
                                            <Grid Height="50">
                                                <Image x:Name="imgObjDoor" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtObjDoorFallback" Text="Porte" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="objWindowCard" Width="88" Margin="0,0,6,0" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface.Subtle}" Cursor="Hand" MouseEnter="OnObjWindowHover" MouseLeftButtonUp="OnObjWindowClick" ToolTip="Fenêtre">
                                            <Grid Height="50">
                                                <Image x:Name="imgObjWindow" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtObjWindowFallback" Text="Fenêtre" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="objOtherCard" Width="88" Margin="0,0,0,0" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource Border}" Background="{StaticResource Surface.Subtle}" Cursor="Hand" MouseEnter="OnObjOtherHover" MouseLeftButtonUp="OnObjOtherClick" ToolTip="Autre">
                                            <Grid Height="50">
                                                <Image x:Name="imgObjOther" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="txtObjOtherFallback" Text="Autre" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          x:Name="comboObjectType"
                                          Height="1"
                                          Width="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          SelectionChanged="OnCriteriaChanged">
                                    <ComboBoxItem Content="Canalisation"/>
                                    <ComboBoxItem Content="Gaine"/>
                                    <ComboBoxItem Content="Porte"/>
                                    <ComboBoxItem Content="Fenêtre"/>
                                    <ComboBoxItem Content="Autre"/>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Source canalisations" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="4" Grid.Column="1"
                                          x:Name="comboPipeSource"
                                          Height="34"
                                          Margin="0,8,0,0">
                                    <ComboBoxItem Content="Maquette"/>
                                    <ComboBoxItem Content="Lien IFC"/>
                                    <ComboBoxItem Content="Lien RVT"/>
                                </ComboBox>

                                <Rectangle Grid.Row="5" Grid.ColumnSpan="2"
                                           Height="1"
                                           Fill="{StaticResource Divider}"
                                           Margin="0,12,0,12"/>

                                <CheckBox Grid.Row="6" Grid.ColumnSpan="2"
                                          x:Name="chkAutomatique"
                                          Content="Mode automatique (scan – mur uniquement)"
                                          Margin="0,0,0,6"/>

                                <CheckBox Grid.Row="7" Grid.ColumnSpan="2"
                                          x:Name="chkMulti"
                                          Content="Multi-sélection (canalisations – rectangle)"
                                          IsEnabled="False"
                                          Margin="0,0,0,6"/>

                                <Rectangle Grid.Row="8" Grid.ColumnSpan="2"
                                           Height="1"
                                           Fill="{StaticResource Divider}"
                                           Margin="0,12,0,12"/>

                                <StackPanel Grid.Row="9" Grid.ColumnSpan="2">
                                    <TextBlock Text="Options" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Activez les options de calcul avant de cliquer sur Lancer."
                                               Style="{StaticResource Hint}"
                                               Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkNorme" Content="Appliquer la norme (arrondi 50 mm)" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkDynamo" Content="Exécuter Dynamo automatiquement" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource Border}"
                                                Background="{StaticResource Surface.Subtle}"
                                                ToolTipService.InitialShowDelay="120">
                                            <TextBlock Text="i"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       ToolTip="Option facultative : lance un script Dynamo après la création/mise à jour des réservations pour renseigner ou corriger automatiquement des paramètres. Vous pouvez utiliser votre propre script adapté à vos familles et à votre méthode projet. Exemple : mise à jour Hauteur relative / NGF pour corriger rapidement les décalages et éviter les oublis."/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Conseil -->
                        <Border Grid.Row="1"
                                Background="{StaticResource Warm.Highlight}"
                                BorderBrush="{StaticResource Warm.Border}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12">
                            <TextBlock Text="Conseil : utilisez l’onglet « Configuration (familles) » pour associer rapidement une nouvelle famille .RFA à un profil Mur/Sol."
                                       Style="{StaticResource Hint}"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========= TAB 2 ========= -->
            <TabItem Header="Configuration (familles)" Margin="7,0,-7,0">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Configuration actuelle" Style="{StaticResource H2}"/>
                            <TextBlock Text="Les profils ci-dessous sont détectés automatiquement quand les familles sont disponibles dans le projet."
                                       Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                            <Border Background="{StaticResource Surface.Subtle}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Profils actifs"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mur – Rectangle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtWallRect" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mur – Cercle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtWallCirc" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sol – Rectangle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtFloorRect" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sol – Cercle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtFloorCirc" Foreground="{StaticResource Text.Secondary}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Ajouter / configurer une famille" Style="{StaticResource H2}"/>

                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <StackPanel>

                                    <TextBlock Text="1) Charger un fichier .RFA de réservation"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez le fichier source puis cliquez sur « Charger dans le projet »."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                        <Button x:Name="btnBrowseRfa"
                                                Content="Parcourir…"
                                                Width="130"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnBrowseRfa"/>
                                        <TextBox x:Name="tbRfaPath" IsReadOnly="True" Height="34"/>
                                    </DockPanel>

                                    <Button x:Name="btnLoadRfa"
                                            Content="Charger dans le projet"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="38"
                                            Click="OnLoadRfa"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="2) Associer la famille à un profil"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez le profil cible puis le type si nécessaire."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <ComboBox x:Name="cbTargetProfile" Height="34" SelectionChanged="OnTargetProfileChanged">
                                        <ComboBoxItem Content="Mur - Rectangulaire"/>
                                        <ComboBoxItem Content="Mur - Circulaire"/>
                                        <ComboBoxItem Content="Sol - Rectangulaire"/>
                                        <ComboBoxItem Content="Sol - Circulaire"/>
                                    </ComboBox>

                                    <TextBlock Text="Type (si la famille a plusieurs types)" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                    <ComboBox x:Name="cbLoadedType" Height="34" DisplayMemberPath="Display" SelectionChanged="OnLoadedTypeChanged"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="3) Mapping des paramètres"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez un paramètre existant ou saisissez un nom manuellement."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <StackPanel x:Name="panelMapRectWall" Visibility="Collapsed">
                                        <TextBlock Text="Longueur (axe mur)" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallLen" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Hauteur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapWallHeight" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapWallDepth" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircWall" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallDiam" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapWallDepth2" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapRectFloor" Visibility="Collapsed">
                                        <TextBlock Text="Longueur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorLen" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Largeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapFloorWidth" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapFloorDepth" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircFloor" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorDiam" Height="34" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                        <ComboBox x:Name="cbMapFloorDepth2" Height="34" IsEditable="True"/>
                                    </StackPanel>

                                    <Button x:Name="btnApplyMapping"
                                            Content="Appliquer au profil + sauvegarder"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="38"
                                            Margin="0,12,0,0"
                                            Click="OnApplyMapping"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="Oversize Pipe/Duct (mm)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="tbOversize" Text="50" Height="34"/>

                                    <TextBlock Text="Chemin Dynamo" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                                    <TextBox x:Name="tbDynamoPath" Height="34"/>

                                    <CheckBox x:Name="chkDefaultNorme" Content="Norme activée par défaut (arrondi)" Margin="0,12,0,6"/>
                                    <CheckBox x:Name="chkDefaultDynamo" Content="Dynamo auto activé par défaut"/>

                                    <Button Content="Sauvegarder config (sans changer les familles)"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            Margin="0,14,0,0"
                                            Click="OnSaveOnly"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <!-- ========= FOOTER ACTIONS ========= -->
        <Border Grid.Row="2"
                Background="Transparent"
                Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            MinWidth="140"
                            IsCancel="True"
                            Click="OnCancel"/>
                    <Button Content="Lancer la réservation"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            MinWidth="200"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Click="OnOk"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>