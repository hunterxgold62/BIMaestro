<Window x:Class="Modification.ReservationAutoV3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Réservations Auto (V3)"
        Height="660"
        Width="860"
        MinWidth="780"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ========= PALETTE ========= -->
        <SolidColorBrush x:Key="App.Background" Color="#F6F8FB"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Surface.Subtle" Color="#F9FAFB"/>

        <SolidColorBrush x:Key="Border" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="Divider" Color="#EEF2F7"/>

        <SolidColorBrush x:Key="Text.Primary" Color="#0F172A"/>
        <SolidColorBrush x:Key="Text.Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted" Color="#94A3B8"/>

        <!-- Marque -->
        <SolidColorBrush x:Key="Brand" Color="#0F5132"/>
        <SolidColorBrush x:Key="Brand.Hover" Color="#0B3D26"/>
        <SolidColorBrush x:Key="Brand.Press" Color="#08301D"/>

        <!-- Focus / Hover -->
        <SolidColorBrush x:Key="Focus" Color="#7CC8A3"/>
        <SolidColorBrush x:Key="Hover.Fill" Color="#F1F5F9"/>

        <!-- Info card -->
        <SolidColorBrush x:Key="Warm.Highlight" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="Warm.Border" Color="#FDE68A"/>

        <!-- ========= EFFECTS ========= -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Opacity="0.10"/>

        <!-- ========= TYPO ========= -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ========= CARDS ========= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ========= INPUTS ========= -->
        <Style x:Key="BaseTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface.Subtle}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Focus}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}"/>

        <Style x:Key="BaseComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}"/>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ========= BUTTONS ========= -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Brand}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand.Hover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand.Press}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand.Press}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover.Fill}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Focus}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= TABS (pill modern) ========= -->
        <Style TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover.Fill}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========= HEADER (brand) ========= -->
        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,14"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock Text="Réservations automatiques" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,6,0,0"
                           Text="Choisissez vos cibles, puis lancez la réservation. Vous pouvez aussi associer vos familles personnalisées dans l’onglet dédié."
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ========= CONTENT ========= -->
        <TabControl Grid.Row="1">
            <!-- ========= TAB 1 ========= -->
            <TabItem Header="Exécution">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Cibles" Style="{StaticResource H2}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Support" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="comboHost" SelectionChanged="OnCriteriaChanged">
                                <ComboBoxItem Content="Mur"/>
                                <ComboBoxItem Content="Sol"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Forme" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="comboShape" SelectionChanged="OnCriteriaChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Type d’objet" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="comboObjectType" SelectionChanged="OnCriteriaChanged">
                                <ComboBoxItem Content="Canalisation"/>
                                <ComboBoxItem Content="Gaine"/>
                                <ComboBoxItem Content="Porte"/>
                                <ComboBoxItem Content="Fenêtre"/>
                                <ComboBoxItem Content="Autre"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source canalisations" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="comboPipeSource">
                                <ComboBoxItem Content="Maquette"/>
                                <ComboBoxItem Content="Lien IFC"/>
                                <ComboBoxItem Content="Lien RVT"/>
                            </ComboBox>

                            <Rectangle Grid.Row="5" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource Divider}" Margin="0,6,0,10"/>

                            <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="chkAutomatique"
                                      Content="Mode automatique (scan – mur uniquement)"/>

                            <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="chkMulti"
                                      Content="Multi-sélection (canalisations – rectangle)"
                                      IsEnabled="False"/>

                            <Rectangle Grid.Row="8" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource Divider}" Margin="0,6,0,10"/>

                            <StackPanel Grid.Row="9" Grid.ColumnSpan="2">
                                <TextBlock Text="Options" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBlock Text="Activez les options de calcul avant de cliquer sur Lancer."
                                           Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="chkNorme" Content="Appliquer la norme (arrondi 50 mm)"/>
                                <CheckBox x:Name="chkDynamo" Content="Exécuter Dynamo automatiquement"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource Warm.Highlight}"
                            BorderBrush="{StaticResource Warm.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12">
                        <TextBlock Text="Conseil : utilisez l’onglet « Configuration (familles) » pour associer rapidement une nouvelle famille .RFA à un profil Mur/Sol."
                                   Style="{StaticResource Hint}"
                                   Margin="0"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========= TAB 2 ========= -->
            <TabItem Header="Configuration (familles)">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Configuration actuelle" Style="{StaticResource H2}"/>
                            <TextBlock Text="Les profils ci-dessous sont détectés automatiquement quand les familles sont disponibles dans le projet."
                                       Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                            <Border Background="{StaticResource Surface.Subtle}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Profils actifs"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mur – Rectangle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtWallRect" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mur – Cercle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtWallCirc" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sol – Rectangle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtFloorRect" Foreground="{StaticResource Text.Secondary}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sol – Cercle" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtFloorCirc" Foreground="{StaticResource Text.Secondary}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Ajouter / configurer une famille" Style="{StaticResource H2}"/>

                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <StackPanel>

                                    <TextBlock Text="1) Charger un fichier .RFA de réservation"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez le fichier source puis cliquez sur « Charger dans le projet »."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                        <Button x:Name="btnBrowseRfa"
                                                Content="Parcourir…"
                                                Width="130"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnBrowseRfa"/>
                                        <TextBox x:Name="tbRfaPath" IsReadOnly="True"/>
                                    </DockPanel>

                                    <Button x:Name="btnLoadRfa"
                                            Content="Charger dans le projet"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OnLoadRfa"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="2) Associer la famille à un profil"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez le profil cible puis le type si nécessaire."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <ComboBox x:Name="cbTargetProfile" SelectionChanged="OnTargetProfileChanged">
                                        <ComboBoxItem Content="Mur - Rectangulaire"/>
                                        <ComboBoxItem Content="Mur - Circulaire"/>
                                        <ComboBoxItem Content="Sol - Rectangulaire"/>
                                        <ComboBoxItem Content="Sol - Circulaire"/>
                                    </ComboBox>

                                    <TextBlock Text="Type (si la famille a plusieurs types)" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="cbLoadedType" DisplayMemberPath="Display" SelectionChanged="OnLoadedTypeChanged"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="3) Mapping des paramètres"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Sélectionnez un paramètre existant ou saisissez un nom manuellement."
                                               Style="{StaticResource Hint}" Margin="0,4,0,10"/>

                                    <StackPanel x:Name="panelMapRectWall" Visibility="Collapsed">
                                        <TextBlock Text="Longueur (axe mur)" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallLen" IsEditable="True"/>
                                        <TextBlock Text="Hauteur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallHeight" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallDepth" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircWall" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallDiam" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapWallDepth2" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapRectFloor" Visibility="Collapsed">
                                        <TextBlock Text="Longueur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorLen" IsEditable="True"/>
                                        <TextBlock Text="Largeur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorWidth" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorDepth" IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMapCircFloor" Visibility="Collapsed">
                                        <TextBlock Text="Diamètre" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorDiam" IsEditable="True"/>
                                        <TextBlock Text="Profondeur" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cbMapFloorDepth2" IsEditable="True"/>
                                    </StackPanel>

                                    <Button x:Name="btnApplyMapping"
                                            Content="Appliquer au profil + sauvegarder"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,10,0,0"
                                            Click="OnApplyMapping"/>

                                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,16,0,14"/>

                                    <TextBlock Text="Oversize Pipe/Duct (mm)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="tbOversize" Text="50"/>

                                    <TextBlock Text="Chemin Dynamo" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="tbDynamoPath"/>

                                    <CheckBox x:Name="chkDefaultNorme" Content="Norme activée par défaut (arrondi)"/>
                                    <CheckBox x:Name="chkDefaultDynamo" Content="Dynamo auto activé par défaut"/>

                                    <Button Content="Sauvegarder config (sans changer les familles)"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            Click="OnSaveOnly"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ========= FOOTER ACTIONS ========= -->
        <Border Grid.Row="2"
                Background="Transparent"
                Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True"
                            Click="OnCancel"/>
                    <Button Content="Lancer la réservation"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Click="OnOk"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>