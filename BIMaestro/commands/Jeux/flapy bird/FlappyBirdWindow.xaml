<Window x:Class="BIMaestro.Bonus.FlappyBirdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flappy Bird"
        Width="420"
        Height="640"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF8ED6FF" Offset="0" />
                <GradientStop Color="#FFBCEBFF" Offset="0.55" />
                <GradientStop Color="#FFEAF8FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Rectangle VerticalAlignment="Bottom"
                   Height="240"
                   Margin="10,0,10,80"
                   IsHitTestVisible="False"
                   CacheMode="BitmapCache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#46FFFFFF" Offset="0.64" />
                    <GradientStop Color="#68D7F4FF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas IsHitTestVisible="False" CacheMode="BitmapCache">
            <Ellipse Width="88" Height="88" Fill="#66FFF1A8" Canvas.Left="286" Canvas.Top="34" />
            <Ellipse Width="74" Height="74" Fill="#28FFFFFF" Canvas.Left="293" Canvas.Top="41" />

            <Canvas Canvas.Left="28" Canvas.Top="52">
                <Ellipse Width="62" Height="34" Fill="#EFFFFFFF" Canvas.Left="0" Canvas.Top="18" />
                <Ellipse Width="48" Height="42" Fill="#F7FFFFFF" Canvas.Left="24" Canvas.Top="4" />
                <Ellipse Width="70" Height="38" Fill="#EFFFFFFF" Canvas.Left="54" Canvas.Top="14" />
                <Rectangle Width="104" Height="26" RadiusX="13" RadiusY="13" Fill="#EFFFFFFF" Canvas.Left="12" Canvas.Top="27" />
            </Canvas>

            <Canvas Canvas.Left="216" Canvas.Top="136" Opacity="0.82">
                <Ellipse Width="50" Height="28" Fill="#F4FFFFFF" Canvas.Left="0" Canvas.Top="15" />
                <Ellipse Width="42" Height="36" Fill="#FAFFFFFF" Canvas.Left="21" Canvas.Top="2" />
                <Ellipse Width="62" Height="31" Fill="#F4FFFFFF" Canvas.Left="50" Canvas.Top="13" />
                <Rectangle Width="92" Height="22" RadiusX="11" RadiusY="11" Fill="#F4FFFFFF" Canvas.Left="10" Canvas.Top="24" />
            </Canvas>

            <Canvas Canvas.Left="58" Canvas.Top="226" Opacity="0.58">
                <Ellipse Width="70" Height="30" Fill="#FFFFFFFF" Canvas.Left="0" Canvas.Top="10" />
                <Ellipse Width="44" Height="34" Fill="#FFFFFFFF" Canvas.Left="40" Canvas.Top="0" />
                <Ellipse Width="80" Height="32" Fill="#FFFFFFFF" Canvas.Left="72" Canvas.Top="9" />
                <Rectangle Width="132" Height="22" RadiusX="11" RadiusY="11" Fill="#FFFFFFFF" Canvas.Left="10" Canvas.Top="20" />
            </Canvas>
        </Canvas>

        <Canvas IsHitTestVisible="False" CacheMode="BitmapCache" VerticalAlignment="Bottom" Height="180" Margin="10,0,10,70">
            <Path Fill="#7FC7E892" Opacity="0.74"
                  Data="M0,112 C48,58 94,82 132,116 C182,40 250,66 296,118 C344,78 382,86 410,116 L410,180 L0,180 Z" />
            <Path Fill="#65A7D878" Opacity="0.90"
                  Data="M0,128 C42,94 86,104 124,132 C178,78 236,88 282,136 C326,104 374,108 410,132 L410,180 L0,180 Z" />
        </Canvas>

        <Rectangle VerticalAlignment="Bottom" Height="8" Margin="10,0,10,70" Fill="#AAFFFFFF" IsHitTestVisible="False" CacheMode="BitmapCache" />

        <Border VerticalAlignment="Bottom" Height="70" Margin="10" CornerRadius="18" CacheMode="BitmapCache">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFAFE77A" Offset="0" />
                    <GradientStop Color="#FF77C85C" Offset="0.45" />
                    <GradientStop Color="#FF4E9848" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Rectangle Height="14" VerticalAlignment="Top" Fill="#5EFFFFFF" />
                <Canvas Opacity="0.42">
                    <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="28" Canvas.Top="8" />
                    <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="76" Canvas.Top="4" />
                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="132" Canvas.Top="7" />
                    <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="188" Canvas.Top="5" />
                    <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="244" Canvas.Top="8" />
                    <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="310" Canvas.Top="5" />
                    <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF" Canvas.Left="366" Canvas.Top="7" />
                </Canvas>
            </Grid>
        </Border>

        <Border Margin="10" CornerRadius="18" BorderBrush="#35FFFFFF" BorderThickness="1" IsHitTestVisible="False" />

        <Canvas x:Name="GameCanvas" Background="Transparent" Margin="10" ClipToBounds="True" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Background="#F7FFFFFF"
                CornerRadius="10"
                Padding="8,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#66000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏆" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Score" FontWeight="SemiBold" Foreground="#FF2C2C2C" Margin="0,0,6,0" />
                <TextBlock x:Name="ScoreText" Text="0" FontWeight="Bold" Foreground="#FF2C2C2C" FontSize="15" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Background="#F7FFFFFF"
                CornerRadius="10"
                Padding="8,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#66000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Record" FontWeight="SemiBold" Foreground="#FF2C2C2C" Margin="0,0,6,0" />
                <TextBlock x:Name="BestScoreText" Text="0" FontWeight="Bold" Foreground="#FF2C2C2C" FontSize="15" />
            </StackPanel>
        </Border>


        <Border x:Name="Overlay"
                CornerRadius="14"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC111111" Offset="0" />
                    <GradientStop Color="#AA000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#80000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="OverlayTitle"
                           Text="Flappy Bird"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayMessage"
                           Text="Appuie sur Espace pour commencer"
                           Foreground="White"
                           Margin="0,12,0,0"
                           TextAlignment="Center" />
                <TextBlock x:Name="OverlayBestScore"
                           Text="Record : 0"
                           Foreground="#FFFDE68A"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="Évite les tuyaux !"
                           Foreground="#FFE4E4E4"
                           Margin="0,8,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="(ou clique dans la fenêtre)"
                           Foreground="#FFE4E4E4"
                           Margin="0,4,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="␣"
                           Foreground="#80FFFFFF"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
