<Window x:Class="BIMaestro.Bonus.FlappyBirdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flappy Bird"
        Width="420"
        Height="640"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF8ED6FF" Offset="0" />
                <GradientStop Color="#FFBCEBFF" Offset="0.55" />
                <GradientStop Color="#FFEAF8FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,24,0" Fill="#24FFF8D8" IsHitTestVisible="False" />

        <Canvas IsHitTestVisible="False">
            <Ellipse Width="120" Height="120" Fill="#30FFFFFF" Canvas.Left="26" Canvas.Top="40" />
            <Ellipse Width="160" Height="90" Fill="#40FFFFFF" Canvas.Left="180" Canvas.Top="70" />
            <Ellipse Width="110" Height="70" Fill="#35FFFFFF" Canvas.Left="250" Canvas.Top="150" />
            <Ellipse Width="180" Height="80" Fill="#2AFFFFFF" Canvas.Left="40" Canvas.Top="220" />
        </Canvas>

        <Rectangle VerticalAlignment="Bottom" Height="8" Margin="10,0,10,70" Fill="#55FFFFFF" IsHitTestVisible="False" />

        <Border VerticalAlignment="Bottom" Height="70" Margin="10" CornerRadius="18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF9FE07A" Offset="0" />
                    <GradientStop Color="#FF6FBB55" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border Margin="10" CornerRadius="18" BorderBrush="#35FFFFFF" BorderThickness="1" IsHitTestVisible="False" />

        <Canvas x:Name="GameCanvas" Background="Transparent" Margin="10" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Background="#F7FFFFFF"
                CornerRadius="10"
                Padding="8,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#66000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏆" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Score" FontWeight="SemiBold" Foreground="#FF2C2C2C" Margin="0,0,6,0" />
                <TextBlock x:Name="ScoreText" Text="0" FontWeight="Bold" Foreground="#FF2C2C2C" FontSize="15" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Background="#F7FFFFFF"
                CornerRadius="10"
                Padding="8,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#66000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Record" FontWeight="SemiBold" Foreground="#FF2C2C2C" Margin="0,0,6,0" />
                <TextBlock x:Name="BestScoreText" Text="0" FontWeight="Bold" Foreground="#FF2C2C2C" FontSize="15" />
            </StackPanel>
        </Border>


        <Border x:Name="Overlay"
                CornerRadius="14"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC111111" Offset="0" />
                    <GradientStop Color="#AA000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#80000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="OverlayTitle"
                           Text="Flappy Bird"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayMessage"
                           Text="Appuie sur Espace pour commencer"
                           Foreground="White"
                           Margin="0,12,0,0"
                           TextAlignment="Center" />
                <TextBlock x:Name="OverlayBestScore"
                           Text="Record : 0"
                           Foreground="#FFFDE68A"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="Évite les tuyaux !"
                           Foreground="#FFE4E4E4"
                           Margin="0,8,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="(ou clique dans la fenêtre)"
                           Foreground="#FFE4E4E4"
                           Margin="0,4,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="␣"
                           Foreground="#80FFFFFF"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>