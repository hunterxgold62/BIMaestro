<Window x:Class="BIMaestro.Bonus.FlappyBirdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro – Flappy Bird"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="#FF0B1118"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Closed="Window_Closed">

    <Window.Resources>

        <!-- ===================== COULEURS (identiques au Snake) ===================== -->

        <SolidColorBrush x:Key="AccentGreen" Color="#18A058"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FF121A24"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SoftText" Color="#FFB4BCC8"/>
        <SolidColorBrush x:Key="MainText" Color="#FFF3F4F6"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF7C8796"/>
        <SolidColorBrush x:Key="InputBg" Color="#FF1A2430"/>
        <SolidColorBrush x:Key="InputBgHover" Color="#FF222E3C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#33FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <Style x:Key="HudCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,14" Width="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== EN-TÊTE ===================== -->

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="22" CornerRadius="2"
                        Background="{StaticResource AccentGreen}" Margin="0,0,10,0"/>
                <TextBlock Text="BIMaestro Flappy Bird" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="LeaderboardButton"
                    Grid.Column="1"
                    Click="LeaderboardButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="★" Foreground="#FFFFC83D" Margin="0,0,6,0"/>
                    <TextBlock x:Name="LeaderboardButtonText" Text="Classement global"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===================== HUD ===================== -->

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HudCard}">
                <StackPanel>
                    <TextBlock x:Name="ScoreLabel" Text="SCORE" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="30" FontWeight="Bold"
                               RenderTransformOrigin="0,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="ScorePopScale" ScaleX="1" ScaleY="1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="NextMedalText" FontSize="12" Foreground="{StaticResource SoftText}"
                               TextTrimming="CharacterEllipsis" Text=" "/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource HudCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="BestLabel" Text="RECORD" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="BestScoreText" Text="0" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="BestMedalText" FontSize="12" Foreground="{StaticResource SoftText}"
                                   TextTrimming="CharacterEllipsis" Text=" "/>
                    </StackPanel>
                    <Viewbox x:Name="BestMedalHost" Grid.Column="1" Width="40" Height="40"
                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== ZONE DE JEU ===================== -->

        <Grid Grid.Row="2" Width="420" Height="540">
            <Grid x:Name="Playfield" Width="420" Height="540">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,420,540" RadiusX="14" RadiusY="14"/>
                </Grid.Clip>

                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6FC6F5" Offset="0"/>
                            <GradientStop Color="#FFA9E1FF" Offset="0.55"/>
                            <GradientStop Color="#FFE4F6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Canvas IsHitTestVisible="False">
                    <Ellipse Width="88" Height="88" Fill="#66FFF1A8" Canvas.Left="296" Canvas.Top="34"/>
                    <Ellipse Width="74" Height="74" Fill="#28FFFFFF" Canvas.Left="303" Canvas.Top="41"/>
                </Canvas>

                <!-- Nuages et collines : construits et animés dans le code (défilement en parallaxe) -->
                <Canvas x:Name="SceneryCanvas" IsHitTestVisible="False"/>

                <!-- Tuyaux + oiseau : s'arrête au-dessus du sol -->
                <Canvas x:Name="GameCanvas"
                        VerticalAlignment="Top"
                        Height="470"
                        Background="Transparent"
                        ClipToBounds="True"/>

                <!-- Sol défilant -->
                <Canvas x:Name="GroundCanvas"
                        VerticalAlignment="Bottom"
                        Height="70"
                        IsHitTestVisible="False"
                        ClipToBounds="True"/>

                <!-- Écran d'accueil / fin de partie -->
                <Border x:Name="Overlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,40"
                        MinWidth="290"
                        Padding="24,20"
                        CornerRadius="14"
                        Background="#EB121A24"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.45" Color="#FF000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="OverlayTitle" Text="Flappy Bird" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Border x:Name="NewRecordBadge"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Padding="10,3"
                                CornerRadius="10"
                                Background="#33FFC83D"
                                BorderBrush="#88FFC83D"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NewRecordText" Text="Nouveau record !" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FFFFD66B"/>
                        </Border>

                        <!-- Bloc résultat (fin de partie) -->
                        <Grid x:Name="ResultPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox x:Name="ResultMedalHost" Width="72" Height="72"/>
                                <TextBlock x:Name="ResultMedalText" FontSize="12" FontWeight="SemiBold"
                                           Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource SoftText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ResultScoreLabel" Text="SCORE" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="ResultScoreText" Text="0" FontSize="30" FontWeight="Bold"/>
                                <TextBlock x:Name="ResultBestLabel" Text="RECORD" Margin="0,6,0,0"
                                           Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="ResultBestText" Text="0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource SoftText}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="OverlayMessage"
                                   Margin="0,14,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   Foreground="{StaticResource SoftText}"/>
                        <TextBlock x:Name="OverlayBestScore"
                                   Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFDE68A"/>

                        <Border HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                Padding="18,3"
                                CornerRadius="6"
                                Background="#FF1A2430"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <TextBlock x:Name="OverlayKeyText" Text="ESPACE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource SoftText}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
        </Grid>

        <!-- ===================== RACCOURCIS ===================== -->

        <TextBlock x:Name="ShortcutsText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Espace ou clic = sauter • Échap = fermer"/>
    </Grid>
</Window>
