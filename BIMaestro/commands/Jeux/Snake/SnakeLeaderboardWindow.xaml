<!-- SnakeLeaderboardWindow.xaml : classement des jeux, même thème sombre que le Snake -->
<Window x:Class="BIMaestro.Bonus.SnakeLeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classement Jeux"
        Width="530"
        Height="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF0B1118"
        Foreground="#FFF3F4F6"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#FF121A24"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="MainText" Color="#FFF3F4F6"/>
        <SolidColorBrush x:Key="SoftText" Color="#FFB4BCC8"/>
        <SolidColorBrush x:Key="MutedText" Color="#FF7C8796"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF18A058"/>

        <!-- Médailles -->
        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFE58A" Offset="0"/>
            <GradientStop Color="#FFE2A72E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF1F5F9" Offset="0"/>
            <GradientStop Color="#FF9AA6B5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BronzeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF3B58A" Offset="0"/>
            <GradientStop Color="#FFB8673A" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
        </Style>

        <!-- Onglet de mode : pastille arrondie, colorée quand elle est choisie -->
        <Style x:Key="ModeTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                CornerRadius="14"
                                Padding="12,6"
                                Background="Transparent"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SoftText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Accent}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Marche du podium -->
        <Style x:Key="PodiumCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Opacity" Value="0.35"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MeBadge" TargetType="Border">
            <Setter Property="Background" Value="#3318A058"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Contenu d'une marche du podium (DataContext = LeaderboardRow) -->
        <DataTemplate x:Key="PodiumContent">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding PlayerName}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="120"/>
                <TextBlock Text="{Binding ScoreText}" FontSize="22" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,2,0,0"/>
                <Border Style="{StaticResource MeBadge}" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="{Binding DataContext.MeBadge, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ShowWhenNotEmpty" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18,16,18,18">

        <!-- ===== Ma place ===== -->
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="10" Padding="12,9" Margin="0,8,0,0"
                DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding Selected.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MyRankText}" FontSize="12" Foreground="{StaticResource SoftText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel>

        <!-- ===== En-tête ===== -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="34" CornerRadius="2" Background="{Binding Selected.Accent}" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleText}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SubtitleText}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Border Background="#FF1A2430" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                    <TextBlock Text="ESC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SoftText}"/>
                </Border>
                <TextBlock Text="{Binding CloseHint}" FontSize="12" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ===== Onglets de mode ===== -->
        <ItemsControl ItemsSource="{Binding Tabs}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource ModeTab}"
                                 GroupName="LeaderboardModes"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Aucun score ===== -->
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="14" Padding="20,36" Margin="0,4,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🏁" FontSize="30" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding EmptyHint}" FontSize="12" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== Podium (2 - 1 - 3) ===== -->
        <Grid Margin="0,8,0,14" Style="{StaticResource ShowWhenNotEmpty}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2e -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" DataContext="{Binding Second}">
                <Grid Width="40" Height="40" Margin="0,0,0,-20" Panel.ZIndex="1">
                    <Ellipse Fill="{StaticResource SilverBrush}" Stroke="#FF0B1118" StrokeThickness="3"/>
                    <TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#FF1F2937" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource PodiumCard}" Height="118" Padding="8,26,8,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#26CBD5E1" Offset="0"/>
                            <GradientStop Color="#FF121A24" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PodiumContent}"/>
                </Border>
            </StackPanel>

            <!-- 1er -->
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" DataContext="{Binding First}">
                <TextBlock Text="👑" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,-2"/>
                <Grid Width="48" Height="48" Margin="0,0,0,-24" Panel.ZIndex="1">
                    <Ellipse Fill="{StaticResource GoldBrush}" Stroke="#FF0B1118" StrokeThickness="3"/>
                    <TextBlock Text="1" FontSize="20" FontWeight="Bold" Foreground="#FF3B2A06" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource PodiumCard}" Height="146" Padding="8,32,8,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2EF5C542" Offset="0"/>
                            <GradientStop Color="#FF121A24" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PodiumContent}"/>
                </Border>
            </StackPanel>

            <!-- 3e -->
            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" DataContext="{Binding Third}">
                <Grid Width="40" Height="40" Margin="0,0,0,-20" Panel.ZIndex="1">
                    <Ellipse Fill="{StaticResource BronzeBrush}" Stroke="#FF0B1118" StrokeThickness="3"/>
                    <TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#FF3A1C0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource PodiumCard}" Height="104" Padding="8,26,8,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#26E0915A" Offset="0"/>
                            <GradientStop Color="#FF121A24" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PodiumContent}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Places 4 à 10 ===== -->
        <ItemsControl ItemsSource="{Binding Others}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" Padding="12,9" Margin="0,0,0,6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                                <Setter Property="BorderBrush" Value="#14FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMe}" Value="True">
                                        <Setter Property="Background" Value="#2618A058"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Rank, StringFormat=#{0}}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                <Border Style="{StaticResource MeBadge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DataContext.MeBadge, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        </StackPanel>
    </DockPanel>
</Window>
