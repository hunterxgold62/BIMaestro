<Window x:Class="BIMaestro.Bonus.FlappyBirdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flappy Bird"
        Width="420"
        Height="640"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#FF87CEEB"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="#FF87CEEB" Margin="10" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Background="#CCFFFFFF"
                CornerRadius="6"
                Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Score: " FontWeight="Bold" />
                <TextBlock x:Name="ScoreText" Text="0" FontWeight="Bold" />
            </StackPanel>
        </Border>

        <Border x:Name="Overlay"
                Background="#AA000000"
                CornerRadius="10"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="OverlayTitle"
                           Text="Flappy Bird"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayMessage"
                           Text="Appuie sur Espace pour commencer"
                           Foreground="White"
                           Margin="0,10,0,0"
                           TextAlignment="Center" />
                <TextBlock Text="Évite les tuyaux !"
                           Foreground="#FFD0D0D0"
                           Margin="0,6,0,0"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
