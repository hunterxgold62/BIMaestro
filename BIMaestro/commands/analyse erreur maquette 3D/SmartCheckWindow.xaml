<Window x:Class="Analyse.SmartCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro – Clash 3D"
        Height="700"
        Width="1150"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="RowSelectedBrush" Color="#E6F5EC"/>
            <SolidColorBrush x:Key="RowOkBrush" Color="#F8FAFC"/>

            <Style x:Key="IssueRowStyle" TargetType="DataGridRow">
                <Setter Property="Padding" Value="4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ignored}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowOkBrush}"/>
                        <Setter Property="Opacity" Value="0.62"/>
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OkButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Content" Value="Marquer OK"/>
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Height" Value="30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ignored}" Value="True">
                        <Setter Property="Content" Value="Annuler OK"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="100"/>
            </Style>

            <Style x:Key="IssueGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Clash 3D — Résultats d’analyse" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,6,0,0"
                           Text="Analysez les anomalies, focalisez les éléments en vue 3D et marquez les points traités."
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Warm.Highlight}" BorderBrush="{DynamicResource Warm.Border}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtIssueCount" Text="0 anomalies" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                    </Border>
                    <Button Content="Ouvrir / MAJ vue 3D" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="OnEnsure3D"/>
                    <ToggleButton x:Name="BtnShowAll"
                                  Content="Afficher toutes les erreurs"
                                  Height="30"
                                  Padding="12,0"
                                  Margin="0,0,8,0"
                                  BorderBrush="{DynamicResource Border}"
                                  Background="{DynamicResource Surface}"
                                  Checked="OnShowAll"
                                  Unchecked="OnShowAll"/>
                    <CheckBox x:Name="ChkAutoFocus" Content="Focus auto 3D (sélection)" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="⟨ Précédent" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0" Click="OnPrev"/>
                    <Button Content="Suivant ⟩" Style="{StaticResource ActionButtonStyle}" Click="OnNext"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs">
            <TabItem Header="Toutes" Margin="0,0,-2,0">
                <DataGrid x:Name="GridAll" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowStyle="{StaticResource IssueRowStyle}"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="180"/>
                        <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0" Click="OnFocus"/>
                                        <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Traversées (sans réservation)" Margin="6,0,-8,0">
                <DataGrid x:Name="GridMEP" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowStyle="{StaticResource IssueRowStyle}"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="220"/>
                        <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0" Click="OnFocus"/>
                                        <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Collisions liens / tuyaux" Margin="12,0,-13,0">
                <DataGrid x:Name="GridLinks" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowStyle="{StaticResource IssueRowStyle}"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="220"/>
                        <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0" Click="OnFocus"/>
                                        <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Raccords ouverts" Margin="19,0,-21,1">
                <DataGrid x:Name="GridOpen" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowStyle="{StaticResource IssueRowStyle}"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="180"/>
                        <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0" Click="OnFocus"/>
                                        <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="Astuce : Focus 3D met en avant l’élément. ‘Afficher toutes les erreurs’ enlève la zone de coupe."
                   Style="{StaticResource Hint}"/>
    </Grid>
</Window>