<Window x:Class="Analyse.SmartCheckWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BIMaestro · Clash 3D" Width="960" Height="760" MinWidth="760" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource App.Background}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing" KeyDown="Window_KeyDown">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="Option" TargetType="CheckBox"><Setter Property="Margin" Value="0,0,18,10"/><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/></Style>
   <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="76"/></Style>
   <Style x:Key="ResultItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Row" CornerRadius="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,12"><ContentPresenter/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brand}"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.Fill}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TutorialColumn" Width="0"/></Grid.ColumnDefinitions>
  <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Clash 3D" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
    <TextBlock Text="Repérez les conflits. Comprenez-les en 3D. Décidez de la suite." Style="{StaticResource Hint}" Margin="0,5,0,0"/>
    <TextBlock x:Name="DocumentText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Content="TUTO" Style="{StaticResource SmallButton}" Click="Tutorial_Click"/>
    <Button Content="Aide" Style="{StaticResource SmallButton}" Click="Help_Click"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
   <StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel x:Name="ScopePanel" VerticalAlignment="Center">
      <TextBlock Text="Analyser" Style="{StaticResource Label}" Margin="0,0,10,0"/>
      <ComboBox x:Name="ScopeCombo" Width="185" SelectedIndex="0" ToolTip="Le périmètre définit les objets de départ. Les obstacles de la maquette sont recherchés autour de ces objets."/>
      <Button Content="Actualiser" Style="{StaticResource SmallButton}" Click="RefreshScope_Click" ToolTip="Reprendre la vue et la sélection actuelles dans Revit."/>
     </WrapPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="AnalyzeButton" Content="Analyser" Style="{StaticResource PrimaryButton}" MinWidth="115" Click="Analyze_Click"/>
      <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource SmallButton}" Click="Cancel_Click" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
    <Expander x:Name="SettingsExpander" Header="Personnaliser l'analyse" Margin="0,12,0,0" Foreground="{DynamicResource Text.Secondary}">
     <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,12,0,0">
       <TextBlock Text="Objets à contrôler" Style="{StaticResource H2}"/>
       <WrapPanel><CheckBox x:Name="PipesCheck" Content="Tuyaux" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="DuctsCheck" Content="Gaines" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="TraysCheck" Content="Chemins de câbles" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="ConduitsCheck" Content="Conduits" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="FittingsCheck" Content="Raccords et accessoires" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="EquipmentCheck" Content="Équipements" Style="{StaticResource Option}"/>
        <CheckBox x:Name="GenericCheck" Content="Modèles génériques" Style="{StaticResource Option}"/>
       </WrapPanel>
       <TextBlock Text="Contrôles" Style="{StaticResource H2}"/>
       <WrapPanel><CheckBox x:Name="LocalCheck" Content="Collisions dans la maquette" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="LinksCheck" Content="Collisions avec les liens" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="InsulationCheck" Content="Inclure isolants et revêtements" IsChecked="True" Style="{StaticResource Option}"/>
        <CheckBox x:Name="ConnectorsCheck" Content="Connecteurs ouverts" Style="{StaticResource Option}"/>
        <CheckBox x:Name="WallsCheck" Content="Supports de murs (indicatif)" Style="{StaticResource Option}"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,12"><TextBlock Text="Ignorer les intersections inférieures à" Style="{StaticResource Label}" Margin="0,0,8,0"/>
        <TextBox x:Name="VolumeBox" Text="10" Width="70" VerticalContentAlignment="Center"/><TextBlock Text="mm³" Style="{StaticResource Label}" Margin="8,0,0,0"/>
       </WrapPanel>
       <TextBlock Text="Liens et imports à comparer" Style="{StaticResource H2}"/>
       <ItemsControl x:Name="LinksList"><ItemsControl.ItemTemplate><DataTemplate>
        <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" IsEnabled="{Binding Loaded}" Style="{StaticResource Option}"/>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="Obstacles : murs, sols, toitures, poutres, poteaux, fondations, escaliers, réseaux, équipements et modèles génériques. Les connexions physiques directes entre réseaux sont exclues. Les maillages produisent des suspicions à vérifier." Style="{StaticResource Hint}"/>
      </StackPanel>
     </ScrollViewer>
    </Expander>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,12">
   <TextBlock x:Name="RunText" Text="Prêt à analyser les réseaux de votre maquette." Style="{StaticResource Hint}"/>
   <ProgressBar x:Name="RunProgress" Height="4" Margin="0,8,0,0" Visibility="Collapsed" Maximum="100"/>
   <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <TextBlock x:Name="StaleText" Text="La maquette a changé. Relancez l'analyse pour actualiser les résultats." Foreground="#B45309" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
  </StackPanel>
  <Grid Grid.Row="3" x:Name="FilterPanel" Margin="0,0,0,12" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid>
    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" VerticalContentAlignment="Center" Height="34" AutomationProperties.Name="Rechercher un objet, un niveau ou un lien" ToolTip="Rechercher une catégorie, un niveau, un lien, un identifiant ou un commentaire."/>
    <TextBlock Text="Rechercher un objet, un niveau ou un lien…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <ComboBox Grid.Column="1" x:Name="StatusCombo" Width="142" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
   <ComboBox Grid.Column="2" x:Name="CategoryCombo" Width="162" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
  </Grid>
  <Grid Grid.Row="4">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="FocusBar" Visibility="Collapsed" Background="{DynamicResource App.Background}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
    <WrapPanel VerticalAlignment="Center">
     <TextBlock x:Name="FocusBarText" Text="Conflit dans Revit" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button x:Name="ContextButton" Content="Voir autour" Style="{StaticResource SmallButton}" Click="Context_Click" ToolTip="Retirer la boîte de coupe pour situer le conflit dans la maquette. Recliquez pour retrouver le cadrage local."/>
     <Button x:Name="ReservationButton" Content="Créer la réservation" Style="{StaticResource SmallButton}" Click="Reservation_Click" Visibility="Collapsed" ToolTip="Utiliser la famille, la forme et les paramètres configurés dans Autoréservation pour cette traversée."/>
    </WrapPanel>
   </Border>
   <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ResultItem}"
    Grid.Row="1"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
    SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="88" Height="68" CornerRadius="6" Background="{DynamicResource App.Background}" VerticalAlignment="Center" ToolTip="{Binding VisualScene.Notice}">
       <Grid>
        <TextBlock Text="{Binding VisualPlaceholder}" FontSize="10" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="6"/>
        <Image Source="{Binding VisualScene.Thumbnail}" Stretch="Uniform" AutomationProperties.Name="Représentation locale des objets du conflit"/>
       </Grid>
      </Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding PairTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding ContextText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
       <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding ConfidenceText}" FontSize="12" Margin="0,0,12,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#166534"/>
         <Style.Triggers><DataTrigger Binding="{Binding IsApproximate}" Value="True"><Setter Property="Foreground" Value="#B45309"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding StatusDisplayText}" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding NewText}" Foreground="{DynamicResource Brand}" FontSize="12"/>
       </WrapPanel>
       <TextBlock Text="{Binding VisualScene.Notice}" Foreground="#B45309" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
       <Button Content="Voir en 3D" Style="{StaticResource SmallButton}" Click="Focus_Click" IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="Le cadrage dans Revit est disponible après l'analyse. Le détail et son aperçu sont consultables pendant l'analyse."/>
       <Button Content="Détail" Style="{StaticResource SmallButton}" Click="Details_Click"/>
      </StackPanel>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="20">
    <TextBlock x:Name="EmptyTitle" Text="Un contrôle clair, à votre rythme" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock x:Name="EmptyDescription" Text="Choisissez le périmètre et lancez l'analyse. Chaque résultat vous mènera directement à sa zone dans Revit." Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="5" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ResultCountText" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Double-clic : voir en 3D · Entrée : détail"/>
   <WrapPanel Grid.Column="1">
    <Button x:Name="DiagnosticsButton" Content="Bilan" Style="{StaticResource SmallButton}" Click="Diagnostics_Click" IsEnabled="False"/>
    <Button x:Name="OverviewButton" Content="Vue d'ensemble" Style="{StaticResource SmallButton}" Click="Overview_Click" IsEnabled="False"/>
    <Button x:Name="RestoreButton" Content="Revenir à ma vue" Style="{StaticResource SmallButton}" Click="Restore_Click"/>
    <Button x:Name="ExportButton" Content="Exporter" Style="{StaticResource SmallButton}" Click="Export_Click" IsEnabled="False"/>
   </WrapPanel>
  </Grid>
  <WrapPanel Grid.Row="6" HorizontalAlignment="Left">
   <Button x:Name="TutorialInspectButton" Content="Détail sélection" Style="{StaticResource SmallButton}" Click="TutorialInspect_Click" Visibility="Collapsed"/>
   <Button x:Name="TutorialFocusButton" Content="Voir sélection en 3D" Style="{StaticResource SmallButton}" Click="TutorialFocus_Click" Visibility="Collapsed"/>
   <Button x:Name="TutorialFixButton" Content="Relever le tuyau d'essai · 300 mm" Style="{StaticResource SmallButton}" Click="TutorialFix_Click" Visibility="Collapsed"/>
  </WrapPanel>
  </Grid>
 </Grid>
</Window>
