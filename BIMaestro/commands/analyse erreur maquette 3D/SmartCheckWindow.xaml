<Window x:Class="Analyse.SmartCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Clash 3D"
        Height="820"
        Width="1320"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="RowSelectedBrush" Color="#E6F5EC"/>
            <SolidColorBrush x:Key="RowOkBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="CriticalBrush" Color="#D83030"/>
            <SolidColorBrush x:Key="CheckBrush" Color="#E28A00"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="OkBrush" Color="#278D42"/>

            <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="HistoryTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="bd"
                                        Background="Transparent"
                                        CornerRadius="12"
                                        Padding="16,10">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="Accent"
                                        Height="3"
                                        CornerRadius="2"
                                        Background="{DynamicResource Focus}"
                                        VerticalAlignment="Bottom"
                                        Margin="12,0,12,1"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                                    <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover.Fill}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
            </Style>

            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="OkButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Content" Value="Marquer OK"/>
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Height" Value="30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ignored}" Value="True">
                        <Setter Property="Content" Value="Annuler OK"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="VisualCardItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SelectionBorder"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Padding="2">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SeverityBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="9,4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SeverityText}" Value="Critique">
                        <Setter Property="Background" Value="{StaticResource CriticalBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityText}" Value="À vérifier">
                        <Setter Property="Background" Value="{StaticResource CheckBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityText}" Value="OK">
                        <Setter Property="Background" Value="{StaticResource OkBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IssueRowStyle" TargetType="DataGridRow">
                <Setter Property="Padding" Value="4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Ignored}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowOkBrush}"/>
                        <Setter Property="Opacity" Value="0.62"/>
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IssueGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Background="{StaticResource Brand}"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Clash 3D" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,6,0,0"
                           Text="BETA - Lecture visuelle des anomalies, collisions, traversées et raccords ouverts."
                           Foreground="#E7F6EE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="0"
                x:Name="HelpButton"
                Content="?"
                Margin="0,18,18,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Style="{StaticResource HelpButtonStyle}"
                ToolTip="Ouvrir l’aide en ligne"
                Click="HelpButton_Click"/>

        <UniformGrid Grid.Row="1" Columns="5">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Total" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TotalStatText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Critiques" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="CriticalStatText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="À vérifier" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="CheckStatText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CheckBrush}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="OK" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="OkStatText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource OkBrush}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Actives" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="ActiveStatText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Type" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="TypeFilterCombo" Width="210" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                    <TextBlock Text="Statut" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="StateFilterCombo" Width="130" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                    <TextBlock Text="Recherche" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="SearchBox" Width="240" Margin="0,0,12,0" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Text="0 / 0 anomalies"/>
                </WrapPanel>
                <Expander Grid.Row="1" Header="Filtres avancés" Margin="0,8,0,0" Foreground="{DynamicResource Text.Secondary}">
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Gravité" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="SeverityFilterCombo" Width="140" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBlock Text="Niveau" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="LevelFilterCombo" Width="150" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBlock Text="Lien" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="LinkFilterCombo" Width="180" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBlock Text="Catégorie" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="ElementCategoryFilterCombo" Width="160" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBlock Text="Vue" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="VisualModeCombo" Width="170" Margin="0,0,12,0" SelectionChanged="Filter_SelectionChanged"/>
                    </WrapPanel>
                </Expander>
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="ActiveFilterText"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Aucun filtre actif"/>
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="Réinitialiser filtres" Style="{StaticResource ActionButtonStyle}" Click="QuickFilterReset_Click"/>
                        <Button x:Name="FocusIsolateButton" Content="Focus + isoler" Style="{StaticResource ActionButtonStyle}" Click="OnFocusIsolate"/>
                        <Button Content="Rapport" Style="{StaticResource ActionButtonStyle}" Click="OnExportReport"/>
                        <ToggleButton x:Name="BtnShowAll"
                                      Content="Afficher toutes les erreurs"
                                      Height="32"
                                      Padding="12,0"
                                      Margin="0,0,8,6"
                                      BorderBrush="{DynamicResource Border}"
                                      Background="{DynamicResource Surface}"
                                      Checked="OnShowAll"
                                      Unchecked="OnShowAll"/>
                        <CheckBox x:Name="ChkAutoFocus" Content="Focus auto sélection" IsChecked="True" VerticalAlignment="Center" Margin="4,0,8,6"/>
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="4" x:Name="Tabs" Margin="0,12,0,0" Padding="0">
            <TabItem Header="Vue visuelle" Style="{StaticResource HistoryTabItem}">
                <Border Style="{StaticResource Card}" Padding="10,10,18,10" Margin="0,10,0,0">
                    <Grid>
                        <ListBox x:Name="VisualIssuesList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionMode="Single"
                                 ItemContainerStyle="{StaticResource VisualCardItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 SelectionChanged="VisualIssuesList_SelectionChanged"
                                 MouseDoubleClick="VisualIssuesList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="292"
                                            Height="260"
                                            Style="{StaticResource Card}"
                                            Padding="0">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Voir ce groupe"
                                                          Click="QuickFilterGroup_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Voir ce type d'erreur"
                                                          Click="QuickFilterKind_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Voir cet élément"
                                                          Click="QuickFilterElement_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Voir les erreurs liées"
                                                          Click="QuickFilterRelated_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Statut">
                                                    <MenuItem Header="Actif"
                                                              Tag="Actif"
                                                              Click="StatusMenu_Click"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="À corriger"
                                                              Tag="À corriger"
                                                              Click="StatusMenu_Click"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="À revoir"
                                                              Tag="À revoir"
                                                              Click="StatusMenu_Click"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="OK"
                                                              Tag="OK"
                                                              Click="StatusMenu_Click"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="À ignorer"
                                                              Tag="À ignorer"
                                                              Click="StatusMenu_Click"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </MenuItem>
                                                <MenuItem Header="Ajouter commentaire"
                                                          Click="CommentStatus_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Marquer OK / Annuler OK"
                                                          Click="QuickMarkOk_Click"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Réinitialiser les filtres"
                                                          Click="QuickFilterReset_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="96"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    CornerRadius="14,14,0,0"
                                                    Background="{DynamicResource Surface.Subtle}">
                                                <Grid>
                                                    <TextBlock Text="{Binding VisualInitials}"
                                                               FontSize="32"
                                                               FontWeight="Bold"
                                                               Opacity="0.32"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource SeverityBadge}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="10">
                                                        <TextBlock Text="{Binding SeverityText}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="10"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="12"
                                                            Padding="8,4">
                                                        <TextBlock Text="{Binding IssueStateText}"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Margin="10"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="12"
                                                            Padding="8,4">
                                                        <TextBlock Text="{Binding GroupBadgeText}"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="12,10,12,6">
                                                <TextBlock Text="{Binding VisualTitle}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="38"/>
                                                <TextBlock Text="{Binding VisualSubtitle}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="46"/>
                                                <TextBlock Text="{Binding AdviceText}"
                                                           Margin="0,5,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Margin="12,0,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding IssueFamily}"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           FontSize="11"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RelatedLabel}"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           FontSize="11"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyStateText"
                                   Text="Aucune anomalie à afficher avec ces filtres."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="15"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Données" Style="{StaticResource HistoryTabItem}">
                <TabControl Margin="0,10,0,0">
                    <TabItem Header="Toutes" Style="{StaticResource HistoryTabItem}">
                        <DataGrid x:Name="GridAll" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                                  RowStyle="{StaticResource IssueRowStyle}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gravité" Binding="{Binding SeverityText}" Width="110"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="105"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="170"/>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding LevelName}" Width="120"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding ElementCategory}" Width="130"/>
                                <DataGridTextColumn Header="Lien" Binding="{Binding LinkName}" Width="140"/>
                                <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="310">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Click="OnFocus"/>
                                                <Button Content="Focus + isoler" Style="{StaticResource ActionButtonStyle}" Click="OnFocusIsolate"/>
                                                <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Traversées" Style="{StaticResource HistoryTabItem}">
                        <DataGrid x:Name="GridMEP" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                                  RowStyle="{StaticResource IssueRowStyle}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gravité" Binding="{Binding SeverityText}" Width="110"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="105"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="170"/>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding LevelName}" Width="120"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding ElementCategory}" Width="130"/>
                                <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="310">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Click="OnFocus"/>
                                                <Button Content="Focus + isoler" Style="{StaticResource ActionButtonStyle}" Click="OnFocusIsolate"/>
                                                <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Collisions liens / tuyaux" Style="{StaticResource HistoryTabItem}">
                        <DataGrid x:Name="GridLinks" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                                  RowStyle="{StaticResource IssueRowStyle}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gravité" Binding="{Binding SeverityText}" Width="110"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="105"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="170"/>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding LevelName}" Width="120"/>
                                <DataGridTextColumn Header="Lien" Binding="{Binding LinkName}" Width="160"/>
                                <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="310">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Click="OnFocus"/>
                                                <Button Content="Focus + isoler" Style="{StaticResource ActionButtonStyle}" Click="OnFocusIsolate"/>
                                                <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Raccords ouverts" Style="{StaticResource HistoryTabItem}">
                        <DataGrid x:Name="GridOpen" Style="{StaticResource IssueGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                                  RowStyle="{StaticResource IssueRowStyle}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gravité" Binding="{Binding SeverityText}" Width="110"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="105"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="170"/>
                                <DataGridTextColumn Header="Niveau" Binding="{Binding LevelName}" Width="120"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding ElementCategory}" Width="130"/>
                                <DataGridTextColumn Header="Id" Binding="{Binding ElementIdValue}" Width="80"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="310">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Focus 3D" Style="{StaticResource ActionButtonStyle}" Click="OnFocus"/>
                                                <Button Content="Focus + isoler" Style="{StaticResource ActionButtonStyle}" Click="OnFocusIsolate"/>
                                                <Button Click="OnIgnore" Style="{StaticResource OkButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="5"
                   Margin="0,8,0,0"
                   Text="Astuce : double-clic sur un groupe = voir le détail. Clic droit = filtres, statut, commentaire, miniature."
                   Style="{StaticResource Hint}"/>
    </Grid>
</Window>
