<Window x:Class="Modification.PhaseQuickEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phases rapides"
        Width="430"
        Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF7F9FB">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF1F2933"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#FFF1F3F5"/>
            <Setter Property="Foreground" Value="#FF111827"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Modifier les phases des objets sélectionnés"
                           FontSize="17"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectionCountText"
                           Margin="0,5,0,0"
                           Foreground="#FF5C6B73"/>
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="HelpButton"
                    Content="?"
                    Style="{StaticResource HelpButtonStyle}"
                    ToolTip="Ouvrir l’aide en ligne"
                    Click="HelpButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Phase de création"/>
            <ComboBox x:Name="CreatedPhaseCombo"
                      DisplayMemberPath="Name"
                      SelectedValuePath="PhaseId"/>

            <TextBlock Text="Phase de démolition"/>
            <ComboBox x:Name="DemolishedPhaseCombo"
                      DisplayMemberPath="Name"
                      SelectedValuePath="PhaseId"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       TextWrapping="Wrap"
                       Foreground="#FF5C6B73"
                       Text="Les éléments incompatibles seront ignorés."/>
            <Button Grid.Column="1"
                    Content="Annuler"
                    IsCancel="True"/>
            <Button Grid.Column="2"
                    Content="Appliquer"
                    IsDefault="True"
                    Click="ApplyButton_Click"/>
        </Grid>
    </Grid>
</Window>
