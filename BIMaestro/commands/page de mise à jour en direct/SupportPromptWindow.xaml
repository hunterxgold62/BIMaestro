<Window x:Class="Page.SupportPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="610" Height="510" Opacity="0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LetterPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Height" Value="44"/>
                <Setter Property="MinWidth" Value="210"/>
                <Setter Property="FontSize" Value="13.5"/>
            </Style>

            <Style x:Key="TextLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#64716A"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#E8F0EB"/>
                                    <Setter Property="Foreground" Value="#0F5132"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14" Background="#FFFCF7" BorderBrush="#DCE7E1"
            BorderThickness="1" CornerRadius="22" Effect="{DynamicResource CardShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#0F5132" CornerRadius="21,0,0,21"/>

            <Grid Grid.Column="1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="78"/>
                </Grid.RowDefinitions>

                <Grid Margin="25,18,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="12" Background="#EDF5F0"
                            BorderBrush="#D8E8DE" BorderThickness="1">
                        <Image x:Name="LogoImage" Width="32" Height="32" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="BIMaestro" Foreground="#0F5132" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="PLUGIN REVIT INDÉPENDANT" Foreground="#87938C"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="3" Width="30" Height="30" Padding="0" Content="×"
                            FontSize="20" Foreground="#718078" Background="Transparent"
                            BorderBrush="Transparent" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="28,8,36,12">
                    <TextBlock x:Name="TitleText" Foreground="#16392A" FontSize="25"
                               FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" Foreground="#6E7B74"
                               FontSize="13" TextWrapping="Wrap"/>

                    <Rectangle Height="1" Fill="#DFE8E2" Margin="0,18,0,18"/>

                    <TextBlock x:Name="IntroText" Foreground="#26332D"
                               FontSize="14" LineHeight="22" TextWrapping="Wrap"/>

                    <Border Margin="0,18,0,14" Padding="16,13" CornerRadius="12"
                            Background="#FFF3E2" BorderBrush="#F1D2A5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="HighlightTitleText" Foreground="#A35417"
                                       FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="HighlightBodyText" Margin="0,5,0,0" Foreground="#765334"
                                       FontSize="12.5" LineHeight="18" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ClosingText" Foreground="#536159"
                               FontSize="12.5" LineHeight="18" TextWrapping="Wrap"/>

                    <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="Paul" FontFamily="Segoe Script" Foreground="#0F5132"
                                   FontSize="22" FontStyle="Italic" HorizontalAlignment="Right"/>
                        <TextBlock Text="Créateur de BIMaestro" Foreground="#8A958F"
                                   FontSize="10.5" HorizontalAlignment="Right" Margin="0,-2,1,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" Padding="24,16" Background="#F4F8F5"
                        CornerRadius="0,0,21,0" BorderBrush="#DFE8E2" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="♡" Foreground="#0F7650" FontSize="18" Margin="0,0,7,0"/>
                            <TextBlock x:Name="VoluntaryText" Foreground="#718078" FontSize="11.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="LaterButton" Margin="8,0,10,0"
                                Style="{StaticResource TextLinkButton}" Click="LaterButton_Click"/>
                        <Button Grid.Column="2" x:Name="SupportButton"
                                Style="{StaticResource LetterPrimaryButton}" Click="SupportButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
