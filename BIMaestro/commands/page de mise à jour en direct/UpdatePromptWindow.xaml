<Window x:Class="Page.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Mise à jour disponible"
        Width="620" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource Text.Primary}"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PanelCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Background" Value="#171A21"/>
                <Setter Property="BorderBrush" Value="#2A3343"/>
            </Style>

            <Style x:Key="LightPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Height" Value="36"/>
            </Style>

            <Style x:Key="LightSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Height" Value="36"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Border Style="{StaticResource PanelCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Grid.Row="0"
                                   x:Name="TitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1"
                                   x:Name="ContentText"
                                   Margin="0,8,0,0"
                                   Foreground="#D5DEEA"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#202635"
                            BorderBrush="#3A455E"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8"
                            Height="132"
                            VerticalAlignment="Top">
                        <Image x:Name="GifImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
                    <CheckBox x:Name="MuteTodayCheck"
                              Content="Ne plus afficher aujourd'hui"
                              VerticalAlignment="Center"
                              Foreground="#E2E8F0"
                              Margin="0,0,8,0"
                              DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="LaterButton"
                                Click="LaterButton_Click"
                                Margin="0,0,8,0"
                                Style="{StaticResource LightSecondaryButton}">
                            Plus tard
                        </Button>
                        <Button x:Name="UpdateButton"
                                Click="UpdateButton_Click"
                                Style="{StaticResource LightPrimaryButton}">
                            Mettre à jour
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>