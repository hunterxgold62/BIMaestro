<Window x:Class="Page.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Mise à jour disponible"
        Width="600" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource Text.Primary}"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="LightPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinWidth" Value="130"/>
                <Setter Property="Height" Value="36"/>
            </Style>

            <Style x:Key="LightSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="115"/>
                <Setter Property="Height" Value="36"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Border Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Grid.Row="0"
                                   x:Name="TitleText"
                                   Style="{StaticResource CardText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,2,0,8"/>

                        <TextBlock Grid.Row="1"
                                   x:Name="ContentText"
                                   Style="{StaticResource CardText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   LineHeight="20"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource Surface.Subtle}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="6"
                            Width="218"
                            Height="261"
                            VerticalAlignment="Top">
                        <Image x:Name="GifImage"
                               Width="206"
                               Height="249"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel x:Name="DownloadPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="DownloadStatus" Margin="0,5,0,0"
                               Foreground="{DynamicResource Text.Secondary}" Text="Téléchargement…"/>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                    <CheckBox x:Name="MuteTodayCheck"
                              Content="Ne plus afficher aujourd'hui"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="LaterButton"
                                Click="LaterButton_Click"
                                Margin="0,0,8,0"
                                Style="{StaticResource LightSecondaryButton}">
                            Plus tard
                        </Button>
                        <Button x:Name="UpdateButton"
                                Click="UpdateButton_Click"
                                Style="{StaticResource LightPrimaryButton}">
                            Mettre à jour
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
