<!-- UpdateWindow.xaml -->
<Window x:Class="Page.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mises à jour"
        Width="980" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown">

    <!-- Styles AVANT usage -->
    <Window.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Background" Value="#2E3137"/>
            <Setter Property="BorderBrush" Value="#3A3E44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3E44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="BorderBrush" Value="#5865F2"/>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Setter Property="Background" Value="#3A3E44"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="BorderBrush" Value="#3A3E44"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Background="#24262B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#5865F2" Margin="0,0,10,0">
                        <TextBlock Text="R" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Notes de mise à jour" Foreground="#E6E6E6" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/>

                    <!-- Badge version locale -->
                    <Border x:Name="CurrentChip" Style="{StaticResource Chip}" Margin="0,0,8,0">
                        <TextBlock x:Name="CurrentText" Foreground="#E6E6E6" FontSize="12" />
                    </Border>

                    <!-- État de mise à jour -->
                    <Border x:Name="LatestChip" Style="{StaticResource Chip}" Visibility="Collapsed"
                            Background="#26321E" BorderBrush="#38512A" Margin="0,0,8,0">
                        <TextBlock x:Name="LatestText" Foreground="#C7F1B0" FontSize="12"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Click="OpenInBrowser_Click" Margin="0,0,6,0"
                        Style="{StaticResource HeaderBtn}" ToolTip="Ouvrir dans le navigateur">
                    <TextBlock Text="Ouvrir dans le navigateur"/>
                </Button>

                <Button Grid.Column="2" Click="Refresh_Click" Margin="0,0,6,0"
                        Style="{StaticResource HeaderBtn}" ToolTip="Actualiser">
                    <TextBlock Text="Actualiser"/>
                </Button>

                <Button Grid.Column="3" Click="Close_Click" Margin="0,0,10,0"
                        Style="{StaticResource CloseBtn}" ToolTip="Fermer">
                    <TextBlock Text="✕" FontSize="12"/>
                </Button>
            </Grid>

            <!-- CORPS -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

                <Grid x:Name="LoadingPanel" Background="#0A000000" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                        <ProgressBar IsIndeterminate="True" Width="240" Height="6" />
                        <TextBlock Text="Chargement…" Foreground="#D0D3D7"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FallbackPanel" Visibility="Collapsed" Background="#1E1F22">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                        <TextBlock Text="Aperçu intégré indisponible" Foreground="#E6E6E6"
                                   FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Ouverture dans votre navigateur par défaut…" Foreground="#AEB4BE"
                                   TextAlignment="Center" Margin="0,8,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Click="OpenInBrowser_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0">
                                <TextBlock Text="Ouvrir dans le navigateur"/>
                            </Button>
                            <Button Click="CopyLink_Click" Style="{StaticResource HeaderBtn}">
                                <TextBlock Text="Copier le lien"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
