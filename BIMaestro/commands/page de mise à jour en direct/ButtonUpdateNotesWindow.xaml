<Window x:Class="Page.ButtonUpdateNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Nouveautés"
        Width="640"
        MinWidth="560"
        Height="470"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource Text.Primary}"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NoteTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="NoteSummary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="LineHeight" Value="20"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ChangeBullet" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="LineHeight" Value="20"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinWidth" Value="130"/>
                <Setter Property="Height" Value="36"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1"
                        Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="{DynamicResource Brand.Soft}"
                                BorderBrush="{DynamicResource Brand.Border}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <TextBlock Text="i"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brand}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="HeaderTitleText"
                                       Text="Nouveautés du bouton"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="HeaderSubtitleText"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="18">
                    <ItemsControl x:Name="NotesItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource NoteTitle}"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   Style="{StaticResource NoteSummary}"
                                                   Margin="0,6,0,10"/>

                                        <ItemsControl ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0"
                                                                 Width="6"
                                                                 Height="6"
                                                                 Margin="2,7,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top"
                                                                 Fill="{DynamicResource Brand}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding}"
                                                                   Style="{StaticResource ChangeBullet}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0"
                        Padding="18,12">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Cette note ne sera plus affichée pour ce bouton dans cette version."
                                   Foreground="{DynamicResource Text.Muted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   DockPanel.Dock="Left"/>

                        <Button Content="Continuer"
                                Style="{StaticResource CompactPrimaryButton}"
                                Click="ContinueButton_Click"
                                DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
