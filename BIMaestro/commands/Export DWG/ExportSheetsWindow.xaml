<Window x:Class="Visualisation.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Export DWG par feuille" Height="180" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1) Choix du jeu de feuilles -->
        <TextBlock Text="Jeu de feuilles :" Grid.Row="0" VerticalAlignment="Center" Style="{DynamicResource Label}"/>
        <ComboBox x:Name="SheetSetComboBox"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  Grid.Row="0"
                  Margin="120,0,0,0"
                  Width="300"/>

        <!-- 2) Choix du dossier d’export -->
        <TextBlock Text="Dossier d’export :" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0" Style="{DynamicResource Label}"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="120,10,0,0">
            <!-- On peut toujours coller / taper le chemin -->
            <TextBox x:Name="FolderTextBox" Width="240"/>
            <Button Content="Parcourir…" Margin="5,0,0,0"
                    Click="BrowseButton_Click" Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>

        <!-- 3) Boutons -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Width="75"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click" Style="{DynamicResource SecondaryButton}"/>
            <Button x:Name="ExportButton"
                    Content="Exporter"
                    Width="100"
                    Click="ExportButton_Click" Style="{DynamicResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>