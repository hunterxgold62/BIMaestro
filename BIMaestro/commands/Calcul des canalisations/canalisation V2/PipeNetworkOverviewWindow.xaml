 <Window x:Class="Analyse.PipeNetworkInteractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interaction réseaux - Calcul des canalisations"
        Height="500"
        Width="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="16" Background="{DynamicResource Brand}" Padding="16" Margin="0,0,0,12">
            <TextBlock Text="Réseaux détectés"
                       Style="{StaticResource H1}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="NetworksList"
                      ItemsSource="{Binding Networks}"
                      SelectionMode="Single"
                      SelectionChanged="NetworksList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="60" Header="Couleur">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Rectangle Width="24"
                                               Height="24"
                                               StrokeThickness="1"
                                               Stroke="Black"
                                               Fill="{Binding ColorBrush}"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Réseau" DisplayMemberBinding="{Binding Name}" Width="250"/>
                        <GridViewColumn Header="Longueur totale (m)" DisplayMemberBinding="{Binding TotalLengthFormatted}" Width="170"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="Cliquez sur un réseau pour le sélectionner immédiatement dans Revit."
                   Foreground="{DynamicResource Text.Secondary}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>