<Window x:Class="Analyse.PipeSystemTypeSelectionWindowV2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calcul des longueurs par diamètre"
        Height="480"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Options de calcul"
                               Style="{StaticResource H2}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button Grid.Column="1"
                            x:Name="HelpButton"
                            Content="?"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Style="{StaticResource HelpButtonStyle}"
                            ToolTip="Ouvrir l’aide en ligne"
                            Click="HelpButton_Click"/>
                </Grid>

                <CheckBox x:Name="IncludeDuctsCheckBox"
                          Grid.Row="1"
                          Content="Inclure les gaines"
                          IsChecked="False"
                          Margin="0,0,0,10"/>

                <CheckBox x:Name="EnableSystemTypeFilterCheckBox"
                          Grid.Row="2"
                          Content="Filtrer par Type de système"
                          IsChecked="False"
                          Margin="0,0,0,10"
                          Checked="EnableSystemTypeFilterCheckBox_Checked"
                          Unchecked="EnableSystemTypeFilterCheckBox_Unchecked"/>

                <StackPanel Grid.Row="3">
                    <TextBlock x:Name="InstructionText"
                               Text="Sélectionnez les Types de système :"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"/>

                    <ScrollViewer Visibility="Collapsed"
                                  x:Name="SystemTypeScrollViewer"
                                  MaxHeight="190"
                                  Margin="0,0,0,8">
                        <ItemsControl Name="SystemTypeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" IsChecked="True"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="DeselectAllButton"
                            Content="Désélectionner tout"
                            Width="170"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,10"
                            Click="DeselectAllButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>

                <CheckBox x:Name="ExportToExcelCheckBox"
                          Grid.Row="5"
                          Content="Exporter les résultats vers Excel"
                          IsChecked="True"
                          Margin="0,10,0,10"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="CancelButton"
                            Content="Annuler"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click"/>
                    <Button Name="OkButton"
                            Content="OK"
                            Width="120"
                            Click="OkButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
