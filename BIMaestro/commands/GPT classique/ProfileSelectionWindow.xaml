<Window x:Class="IA.ProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro - Sélection du Profil"
        Height="280"
        Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Veuillez sélectionner un profil :" Style="{StaticResource H2}"/>
                <RadioButton x:Name="BasiqueRadio" Content="Basique" IsChecked="True" Margin="0,0,0,8"/>
                <RadioButton x:Name="PersonnelleRevitRadio" Content="Personnelle Revit" Margin="0,0,0,8"/>
                <RadioButton x:Name="BIMManagerRadio" Content="BIM Manager" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Annuler"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click"/>
                    <Button Content="OK" Width="120" Click="OKButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>