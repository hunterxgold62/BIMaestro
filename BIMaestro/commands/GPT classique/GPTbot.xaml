<Window x:Class="IA.GPTBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IA"
        Title="BIMaestro - GPT Bot"
        Height="600"
        Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ====== Bulle USER ====== -->
            <DataTemplate x:Key="UserMessageTemplate">
                <StackPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Border Style="{DynamicResource Card}"
                            Background="{DynamicResource Brand}"
                            BorderBrush="{DynamicResource Brand}"
                            MaxWidth="390"
                            Margin="50,0,0,0"
                            Padding="10,8">
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="White">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copier tout"
                                              CommandParameter="{Binding Content}"
                                              Click="CopyMenuItem_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ====== Bulle BOT ====== -->
            <DataTemplate x:Key="BotMessageTemplate">
                <StackPanel HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Border Style="{DynamicResource Card}"
                            MaxWidth="390"
                            Margin="0,0,50,0"
                            Padding="10,8">
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Primary}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copier tout"
                                              CommandParameter="{Binding Content}"
                                              Click="CopyMenuItem_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DataTemplate>


            <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brand}"
                Padding="16,12"
                CornerRadius="0,0,12,12">
            <TextBlock Text="Assistant BIMaestro" Style="{DynamicResource H1}"/>
        </Border>

        <!-- ===== Zone messages ===== -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="16" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ✅ PAS de ScrollViewer autour : ListBox gère son scroll -->
                <ListBox x:Name="MessagesListBox"
                         Grid.Row="0"
                         ItemsSource="{Binding}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Text.Primary}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="2">

                    <!-- ✅ Chat = mieux sans virtualisation (sinon clipping/mesure) -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type local:MessageModel}">
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="system">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="ContentTemplate" Value="{StaticResource UserMessageTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                <Setter Property="ContentTemplate" Value="{StaticResource BotMessageTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>

                <ProgressBar x:Name="LoadingIndicator"
                             Grid.Row="1"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Height="8"
                             Margin="4,10,4,2"
                             Foreground="{DynamicResource Brand}"
                             Background="{DynamicResource Divider}"/>
            </Grid>
        </Border>

        <!-- ===== Zone saisie ===== -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="16,0,16,16" Padding="13">
            <!-- ✅ Grid plutôt que DockPanel : sizing plus fiable -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         MinHeight="40"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         Padding="10,4"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <Button x:Name="ElementButton"
                        Grid.Column="1"
                        Content="Élément"
                        MinWidth="120"
                        Height="40"
                        Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}"
                        Click="ElementButton_Click"
                        IsEnabled="True"/>

                <Button x:Name="AskButton"
                        Grid.Column="2"
                        Content="Envoyer"
                        MinWidth="120"
                        Height="40"
                        Style="{DynamicResource PrimaryButton}"
                        Click="AskButton_Click"
                        IsEnabled="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>