<Window x:Class="Famille.FamilyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Famille"
        xmlns:ui="clr-namespace:BIMaestro.UI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="BIMaestro - Navigateur de Familles"
        Height="651" Width="1195"
        MinWidth="600" MinHeight="400"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Thème -->
            <SolidColorBrush x:Key="PrimaryText" Color="#0F172A"/>
            <SolidColorBrush x:Key="TabInactiveForeground" Color="#64748B"/>
            <SolidColorBrush x:Key="TabActiveForeground" Color="#0F172A"/>
            <SolidColorBrush x:Key="SearchBoxBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SearchBoxForeground" Color="#0F172A"/>
            <SolidColorBrush x:Key="SearchBoxBorder" Color="#E6EAF0"/>
            <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#F6F8FB"/>
                <GradientStop Offset="1" Color="#FFFFFF"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PanelBackground"    Color="#F9FAFB"/>
            <SolidColorBrush x:Key="TreeViewBackground" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="ItemsBackground"    Color="Transparent"/>
            <SolidColorBrush x:Key="TabBackground"      Color="Transparent"/>
            <SolidColorBrush x:Key="ImageBackground"    Color="Transparent"/>

            <ItemsPanelTemplate x:Key="FamilyListWrapPanel">
                <WrapPanel IsItemsHost="True"/>
            </ItemsPanelTemplate>

            <ItemsPanelTemplate x:Key="FamilyListStackPanel">
                <StackPanel IsItemsHost="True" Orientation="Vertical"/>
            </ItemsPanelTemplate>

            <!-- Styles -->
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            </Style>

            <Style x:Key="ImageStyle" TargetType="Image">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="FavoritesToolbarCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>

            <Style x:Key="FavoritesActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="74"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style x:Key="FavoritesPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style x:Key="DocumentationBadgeStyle" TargetType="Button">
                <Setter Property="Content" Value="DOC"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brand}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brand}"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ToolTip" Value="Ouvrir la documentation"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DocumentationAvailable}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Vignette famille (onglet Dossiers) -->
            <DataTemplate x:Key="FamilyItemTemplate" DataType="{x:Type local:FamilyItem}">
                <Border Margin="5" Width="200"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="5"
                    BorderThickness="1"
                    MouseLeftButtonDown="FamilyItem_DoubleClick"
                    PreviewMouseRightButtonDown="FamilyItem_RightClickSelect"
                    ContextMenuOpening="FamilyItem_ContextMenuOpening">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#33000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="#1F0F5132"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ouvrir le dossier"
                                  Click="OpenFolderItem_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Documentation"
                                  Click="DocumentationMenuItem_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Rentrer dans la famille"
                                  Click="OpenFamilyFile_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Charger la dernière version"
                                  Click="ReloadFamily_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                            <Separator/>

                            <!-- Ajout express dans la collection active -->
                            <MenuItem Header="Ajouter à la collection active"
                                  Click="AddToActiveCollection_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Border Background="{DynamicResource ImageBackground}" Padding="3"
                                    Visibility="{Binding FamilyControlVisibility}">
                                <Image Source="{Binding Icon}"
                                   Width="180" Height="180"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ImageStyle}"/>
                            </Border>
                            <Border Background="{DynamicResource ImageBackground}"
                                    Padding="8"
                                    Visibility="{Binding FolderControlVisibility}"
                                    ToolTip="Ouvrir le sous-dossier">
                                <Grid Width="180" Height="180">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon1}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon2}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon3}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon4}" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource DocumentationBadgeStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Click="DocumentationBadge_Click"/>
                        </Grid>
                        <Button Content="3D"
                            Width="28" Height="20" FontSize="10" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                            Click="OnPreview3DClick"
                            ToolTip="Aperçu 3D de la famille"
                            Background="Transparent"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            FocusVisualStyle="{x:Null}"
                            Visibility="{Binding FamilyControlVisibility}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ★ : Favoris -->
                            <Button Grid.Column="0" Content="★"
                                Click="FavoriteButton_Click"
                                ToolTip="Ajouter/retirer des Favoris"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,0,5,0"
                                Visibility="{Binding FamilyControlVisibility}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="SkyBlue"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,5,0"
                                   ToolTip="Nom complet de la famille"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="FamilyItemDetailedTemplate" DataType="{x:Type local:FamilyItem}">
                <Border Margin="5"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="5"
                    BorderThickness="1"
                    MouseLeftButtonDown="FamilyItem_DoubleClick"
                    PreviewMouseRightButtonDown="FamilyItem_RightClickSelect"
                    ContextMenuOpening="FamilyItem_ContextMenuOpening"
                    HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#33000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brand}"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Setter Property="Background" Value="#1F0F5132"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ouvrir le dossier"
                                  Click="OpenFolderItem_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Documentation"
                                  Click="DocumentationMenuItem_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Rentrer dans la famille"
                                  Click="OpenFamilyFile_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Charger la dernière version"
                                  Click="ReloadFamily_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                            <Separator/>

                            <MenuItem Header="Ajouter à la collection active"
                                  Click="AddToActiveCollection_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource ImageBackground}"
                                Padding="3"
                                Visibility="{Binding FamilyControlVisibility}">
                                <Image Source="{Binding Icon}"
                                   Width="200" Height="200"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ImageStyle}"/>
                            </Border>
                            <Border Background="{DynamicResource ImageBackground}"
                                    Padding="6"
                                    Visibility="{Binding FolderControlVisibility}"
                                    ToolTip="Ouvrir le sous-dossier">
                                <Grid Width="170" Height="170">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon1}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon2}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon3}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="2" CornerRadius="4" ClipToBounds="True" Background="#FFE6EAF0">
                                        <Image Source="{Binding FolderPreviewIcon4}" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource DocumentationBadgeStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Click="DocumentationBadge_Click"/>
                        </Grid>

                        <Grid Grid.Column="1" Margin="20,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="3D"
                                        Width="32" Height="22" FontSize="10" Padding="0"
                                        Margin="0,0,8,0"
                                        Click="OnPreview3DClick"
                                        ToolTip="Aperçu 3D de la famille"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        BorderBrush="Transparent"
                                        FocusVisualStyle="{x:Null}"
                                        Visibility="{Binding FamilyControlVisibility}"/>
                                    <Button Content="★"
                                        Click="FavoriteButton_Click"
                                        ToolTip="Ajouter/retirer des Favoris"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="18"
                                        Width="32"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,0"
                                        Visibility="{Binding FamilyControlVisibility}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="SkyBlue"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                                <Button Click="CategoryPill_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                            <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Category}" Foreground="#FF1F3B57"/>
                                </Button>

                                <Button Click="VersionPill_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                            <Setter Property="Background" Value="#FFF2F5FC"/>
                                            <Setter Property="BorderBrush" Value="#FFDCE6FA"/>
                                            <Setter Property="Foreground" Value="#FF2A3F6A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RevitSavedVersion}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RevitSavedVersion}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Foreground="#FF2A3F6A" FontWeight="SemiBold">
                                    <Run Text="Revit "/>
                                    <Run Text="{Binding RevitSavedVersion}"/>
                                    </TextBlock>
                                </Button>

                                <Button Click="SizePill_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                            <Setter Property="Background" Value="#FFFDF2E8"/>
                                            <Setter Property="BorderBrush" Value="#FFF6D9B8"/>
                                            <Setter Property="Foreground" Value="#FF594525"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileSizeText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FileSizeText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsSizeSortActive}" Value="True">
                                                    <Setter Property="Background" Value="#FFF9E2C7"/>
                                                    <Setter Property="BorderBrush" Value="#FFE0A35C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding FileSizeText}" Foreground="#FF594525" FontWeight="SemiBold"/>
                                </Button>
                            </WrapPanel>

                            <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Background="#FFFFFFFF"
                                BorderBrush="#22000000"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Détails"
                                           Foreground="#FF1F3B57"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                    <Border Height="1"
                                        Margin="0,10,0,14"
                                        Background="#22000000"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Catégorie"/>
                                        <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding Category, TargetNullValue=—}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Version Revit"/>
                                        <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding RevitSavedVersion, TargetNullValue=—}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Dernière mise à jour"/>
                                        <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding LastUpdatedText, TargetNullValue=—}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Taille du fichier"/>
                                        <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding FileSizeText, TargetNullValue=—}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Numéro OmniClass"/>
                                        <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                              Text="{Binding OmniClassDisplay, TargetNullValue=—}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>


                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Vignette famille (onglet Favoris/Collections) : bouton 🗑 -->
            <DataTemplate x:Key="CollectionItemTemplate" DataType="{x:Type local:FamilyItem}">
                <Border Margin="5" Width="200"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="5"
                    MouseLeftButtonDown="FamilyItem_DoubleClick">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rentrer dans la famille"
                                  Click="OpenFamilyFile_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Charger la dernière version"
                                  Click="ReloadFamily_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Border Background="{DynamicResource ImageBackground}" Padding="3">
                                <Image Source="{Binding Icon}"
                                   Width="180" Height="180"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ImageStyle}"/>
                            </Border>
                            <Button Style="{StaticResource DocumentationBadgeStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Click="DocumentationBadge_Click"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 🗑 : supprimer de la collection courante (taille réduite) -->
                            <Button Grid.Column="0"
        Click="RemoveFromCollection_Click"
        ToolTip="Retirer de la collection courante"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        Width="24" Height="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,0,6,0"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Focusable="True">
                                <!-- Icône poubelle animée (hover) -->
                                <ui:AnimatedDeleteIcon IconSize="18"
                         Foreground="{DynamicResource PrimaryText}"/>
                            </Button>

                            <TextBlock Grid.Column="1"
           Text="{Binding Name}"
           Foreground="{DynamicResource PrimaryText}"
           FontWeight="Bold"
           TextWrapping="Wrap"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           Margin="0,0,5,0"/>

                        </Grid>
                        <Button Content="3D"
        Width="28" Height="20" FontSize="10" Padding="0"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
        Click="OnPreview3DClick"
        ToolTip="Aperçu 3D de la famille"
        Background="Transparent"
        BorderThickness="0"
        BorderBrush="Transparent"
        FocusVisualStyle="{x:Null}"/>

                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundGradient}">
        <Grid Margin="8">
            <TabControl
                    Margin="0"
                    x:Name="MainTabControl"
                    Background="{DynamicResource TabBackground}"
                    Foreground="{DynamicResource PrimaryText}"
                    SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="MinWidth" Value="110"/>
                        <Setter Property="Foreground" Value="{DynamicResource TabInactiveForeground}"/>
                        <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}"
                                        CornerRadius="8,8,0,0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brand}"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brand.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="{DynamicResource Brand}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brand.Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- Onglet Dossiers -->
                <TabItem Header="Dossiers" Background="{DynamicResource TabBackground}">
                    <Grid Margin="6" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                            <StackPanel Background="Transparent">
                                <Button x:Name="AllFamiliesButton"
                                Content="{Binding RootFolderName}"
                                FontSize="14" FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryText}"
                                Background="Transparent"
                                BorderThickness="0"
                                Height="35"
                                HorizontalContentAlignment="Left"
                                Click="AllFamiliesButton_Click"/>
                                <TreeView x:Name="FolderTreeView"
                                  Background="{DynamicResource TreeViewBackground}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Height="500"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItemChanged="FolderTreeView_SelectedItemChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Recherche -->
                                <Grid Grid.Row="0">
                                    <TextBox x:Name="SearchBox"
                                     Height="30"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                                     Background="{DynamicResource SearchBoxBackground}"
                                     Foreground="{DynamicResource SearchBoxForeground}"
                                     BorderBrush="{DynamicResource SearchBoxBorder}"
                                     Padding="8,4"
                                     Margin="2,0,0,0"/>
                                    <TextBlock x:Name="PlaceholderText"
                                       Text="Rechercher (cliquer pour recherche globale)…"
                                       Foreground="Gray"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                                </Grid>

                                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource Divider}" Margin="0,5"/>

                                <ScrollViewer x:Name="ItemsScroll"
                                      Grid.Row="2"
                                      Background="{DynamicResource ItemsBackground}"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="ItemsScroll_ScrollChanged">
                                    <StackPanel>

                                        <!-- Top-8 -->
                                        <ItemsControl x:Name="TopFamiliesView"
                                              ItemTemplate="{StaticResource FamilyItemTemplate}"
                                              Visibility="Collapsed">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <Rectangle x:Name="TopSeparator"
                                           Height="1"
                                           Fill="#CCCCCC"
                                           Margin="0,5"
                                           Visibility="Collapsed"/>

                                        <!-- Résultats paginés -->
                                        <ItemsControl x:Name="FamilyListView"
                                              ItemTemplate="{StaticResource FamilyItemTemplate}"
                                              ItemsPanel="{StaticResource FamilyListWrapPanel}"/>

                                        <TextBlock x:Name="PagingStatusText"
                                           Margin="8,12,8,20"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <DockPanel Grid.Row="3" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button x:Name="DateSortButton"
        Content="Date de MAJ"
        Click="DateSortButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                                    <Setter Property="Padding" Value="12,4"/>
                                                    <Setter Property="Background" Value="#FFF2F5FC"/>
                                                    <Setter Property="BorderBrush" Value="#FFDCE6FA"/>
                                                    <Setter Property="Foreground" Value="#FF2A3F6A"/>

                                                    <!-- ✅ Les triggers doivent être dans Style.Triggers -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsDateSortActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFE0F2FF"/>
                                                            <Setter Property="BorderBrush" Value="#FF5AA0FF"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DetailedViewCheckBox}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <CheckBox x:Name="MultiSelectCheckBox"
                                          Content="Sélection multiple"
                                          Foreground="{DynamicResource PrimaryText}"
                                          Margin="0,0,20,0"
                                          Checked="MultiSelectCheckBox_Changed"
                                          Unchecked="MultiSelectCheckBox_Changed"/>
                                        <CheckBox x:Name="DetailedViewCheckBox"
                                          Content="Vue détaillée"
                                          Margin="0,0,8,0"
                                          Foreground="{DynamicResource PrimaryText}"
                                          Checked="DetailedViewCheckBox_Changed"
                                          Unchecked="DetailedViewCheckBox_Changed" Width="92"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Foreground="{DynamicResource PrimaryText}" Margin="5,0,0,0" Text="Éléments affichés : "/>
                                        <TextBlock x:Name="CountTextBlock" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Onglet Favoris / Collections -->
                <TabItem Header="Favoris" Background="{DynamicResource TabBackground}">
                <Grid Margin="10" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ItemsBackground}">
                        <DockPanel LastChildFill="False">
                            <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Collection :" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{DynamicResource PrimaryText}"/>
                                <ComboBox x:Name="CollectionCombo"
                                          Width="300"
                                          DisplayMemberPath="Name"
                                          Margin="6,0,0,0"
                                          SelectionChanged="CollectionCombo_SelectionChanged"/>
                                <Button Content="Nouv." Margin="6,0,0,0" Style="{StaticResource FavoritesActionButton}" Click="CollectionNew_Click" Background="{DynamicResource Surface.Subtle}"/>
                                <Button Content="Ren." Margin="6,0,0,0" Style="{StaticResource FavoritesActionButton}" Click="CollectionRename_Click" Background="{DynamicResource Surface.Subtle}"/>
                                <Button Content="Suppr." Margin="6,0,0,0" Style="{StaticResource FavoritesActionButton}" Click="CollectionDelete_Click" Background="{DynamicResource Surface.Subtle}"/>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="CollectionActionsButton"
                                        Content="Partager"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource FavoritesActionButton}"
                                        Click="CollectionActionsButton_Click" Background="{DynamicResource Surface.Subtle}" IsDefault="True">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Partager la collection…"
                                                      Click="CollectionShareMenuItem_Click"/>
                                            <MenuItem Header="Télécharger la collection…"
                                                      Click="CollectionDownloadMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="Charger la collection"
                                        Style="{StaticResource FavoritesPrimaryActionButton}"
                                        Click="CollectionLoad_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Background="{DynamicResource ItemsBackground}">
                        <ItemsControl x:Name="CollectionListView"
                                      ItemTemplate="{StaticResource CollectionItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <TextBlock Text="Éléments dans la collection : " Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock x:Name="CollectionCountText" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Onglet Paramètres -->
            <TabItem x:Name="SettingsTabItem"
                     Header="Paramètres"
                     Background="{DynamicResource TabBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0"
                              Focusable="False">
                    <Grid x:Name="SettingsPanelRoot" Margin="12,10,8,10" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Margin" Value="0,0,16,0"/>
                        </Style>
                        <Style x:Key="SettingSectionTitleStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                        </Style>
                        <Style x:Key="SettingSectionBorderStyle" TargetType="Border">
                            <Setter Property="Background" Value="#19FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#22000000"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Padding" Value="14"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0"
                               Text="Paramètres d'apparence"
                               Style="{StaticResource SettingSectionTitleStyle}"/>

                    <Border Grid.Row="1"
                            Style="{StaticResource SettingSectionBorderStyle}">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Couleur du haut" Style="{StaticResource SettingLabelStyle}"/>
                            <xctk:ColorPicker Grid.Row="0" Grid.Column="1"
                                              x:Name="TopColorPicker"
                                              Height="26"
                                              SelectedColor="#FFF2F2F2"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Couleur du bas" Style="{StaticResource SettingLabelStyle}"/>
                            <xctk:ColorPicker Grid.Row="0" Grid.Column="4"
                                              x:Name="BottomColorPicker"
                                              Height="26"
                                              SelectedColor="#FFFFFFFF"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrière-plan des familles" Style="{StaticResource SettingLabelStyle}" Margin="0,12,16,0"/>
                            <xctk:ColorPicker Grid.Row="1" Grid.Column="1"
                                              Margin="0,12,0,0"
                                              x:Name="PanelBackgroundPicker"
                                              Height="26"
                                              SelectedColor="#F0F0F0"/>

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Arrière-plan de l'arborescence" Style="{StaticResource SettingLabelStyle}" Margin="0,12,16,0"/>
                            <xctk:ColorPicker Grid.Row="1" Grid.Column="4"
                                              Margin="0,12,0,0"
                                              x:Name="TreeViewBackgroundPicker"
                                              Height="26"
                                              SelectedColor="#F0F0F0"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="Couleurs secondaires"
                               Style="{StaticResource SettingSectionTitleStyle}"/>

                    <Border Grid.Row="3"
                            Style="{StaticResource SettingSectionBorderStyle}">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ItemsBackground" Style="{StaticResource SettingLabelStyle}"/>
                            <xctk:ColorPicker Grid.Row="0" Grid.Column="1"
                                              x:Name="ItemsBackgroundPicker"
                                              Height="26"
                                              SelectedColor="Transparent"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrière-plan général" Style="{StaticResource SettingLabelStyle}" Margin="0,12,16,0"/>
                            <xctk:ColorPicker Grid.Row="1" Grid.Column="1"
                                              Margin="0,12,0,0"
                                              x:Name="TabBackgroundPicker"
                                              Height="26"
                                              SelectedColor="Transparent"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="4"
                               Text="Comportement"
                               Style="{StaticResource SettingSectionTitleStyle}"/>

                    <Border Grid.Row="5"
                            Style="{StaticResource SettingSectionBorderStyle}">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode sombre" Style="{StaticResource SettingLabelStyle}"/>
                            <ui:EyeToggleSwitch Grid.Row="0" Grid.Column="1"
                                                x:Name="DarkModeSwitch"
                                                Width="200"
                                                BaseSize="18"
                                                TransitionMs="420"
                                                VerticalAlignment="Center"
                                                Toggled="DarkModeSwitch_Toggled"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Afficher le Top-8" Style="{StaticResource SettingLabelStyle}" Margin="0,12,16,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      Margin="0,12,0,0"
                                      x:Name="ShowTop8CheckBox"
                                      VerticalAlignment="Center"
                                      IsChecked="False"
                                      Checked="ShowTop8CheckBox_Changed"
                                      Unchecked="ShowTop8CheckBox_Changed"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Toujours au-dessus" Style="{StaticResource SettingLabelStyle}" Margin="0,12,16,0"/>
                            <ui:GhostSwitch Grid.Row="2" Grid.Column="1"
                                            Margin="0,12,0,0"
                                            x:Name="AlwaysOnTopSwitch"
                                            Width="160"
                                            Height="46"
                                            EyeFollowGlobal="False"
                                            AutoPauseWhenHidden="True"
                                            Toggled="AlwaysOnTopSwitch_Toggled"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bouton à gauche -->
                        <Button Content="Modifier les chemins…" 
            Width="220" 
            HorizontalAlignment="Left"
            Margin="0,0,16,0"
            Click="ChangePaths_Click"/>

                        <!-- Trois boutons à droite -->
                        <StackPanel Orientation="Horizontal"
                Grid.Column="1"
                HorizontalAlignment="Right">

                            <Button Content="Appliquer" 
                Width="120" 
                Margin="0,0,8,0" 
                Click="ApplyColors_Click"/>

                            <Button Content="Enregistrer" 
                Width="120" 
                Margin="0,0,8,0" 
                Click="SaveConfig_Click"/>

                            <Button Content="Réinitialiser" 
                Width="120" 
                Click="ResetConfig_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="7"
                               Text="Export d'aperçus 3D"
                               Style="{StaticResource SettingSectionTitleStyle}"/>

                    <Border Grid.Row="8"
                            Style="{StaticResource SettingSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                       Text="Sélectionne le dossier de familles à traiter puis le dossier miroir pour les PNG exportés."
                                       Foreground="{DynamicResource PrimaryText}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Dossier familles"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     x:Name="PreviewSourceTextBox"
                                     IsReadOnly="True"
                                     Margin="0,0,8,6"/>
                            <Button Grid.Row="1" Grid.Column="2"
                                    Content="Choisir…"
                                    Width="100"
                                    Click="SelectPreviewFolders_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Dossier miroir"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     x:Name="PreviewTargetTextBox"
                                     IsReadOnly="True"
                                     Margin="0,0,8,6"/>
                            <Button Grid.Row="2" Grid.Column="2"
                                    Content="Choisir…"
                                    Width="100"
                                    Click="SelectPreviewFolders_Click"/>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,6">
                                <Button x:Name="StartPreviewButton"
                                        Content="Lancer l'export 3D"
                                        Width="170"
                                        Click="StartPreviewExport_Click"
                                        Margin="0,0,12,0"/>
                                <Button x:Name="CancelPreviewButton"
                                        Content="Annuler"
                                        Width="120"
                                        IsEnabled="False"
                                        Click="CancelPreviewExport_Click"/>
                                <TextBlock x:Name="PreviewProgressText"
                                           Foreground="{DynamicResource PrimaryText}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                <ProgressBar x:Name="PreviewProgressBar"
                                             Height="16"
                                             Minimum="0"
                                             Maximum="1"
                                             Visibility="Collapsed"/>
                                <TextBox x:Name="PreviewLogTextBox"
                                         Margin="0,10,0,0"
                                         Height="140"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
            <Button x:Name="HelpButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="32"
                    Height="24"
                    Margin="0,6,8,0"
                    Content="?"
                    FontWeight="Bold"
                    ToolTip="Ouvrir l'aide en ligne"
                    Style="{StaticResource SecondaryButton}"
                    Click="HelpButton_Click"/>
        </Grid>
    </Grid>
</Window>
