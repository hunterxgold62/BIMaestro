<Window x:Class="Famille.FamilyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Famille"
        xmlns:ui="clr-namespace:BIMaestro.UI"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Navigateur de Familles"
        Height="600" Width="1150"
        MinWidth="600" MinHeight="400"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{DynamicResource PrimaryText}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Thème -->
        <SolidColorBrush x:Key="PrimaryText" Color="Black"/>
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFEB0F0F"/>
            <GradientStop Offset="1" Color="#FFFFFFFF"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBackground"    Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TreeViewBackground" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ItemsBackground"    Color="Transparent"/>
        <SolidColorBrush x:Key="TabBackground"      Color="Transparent"/>
        <SolidColorBrush x:Key="ImageBackground"    Color="Transparent"/>

        <ItemsPanelTemplate x:Key="FamilyListWrapPanel">
            <WrapPanel IsItemsHost="True"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="FamilyListStackPanel">
            <StackPanel IsItemsHost="True" Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <!-- Styles -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style x:Key="ImageStyle" TargetType="Image">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFE9EEF6"/>
            <Setter Property="BorderBrush" Value="#FFC9D7F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1F3B57"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocumentationBadgeStyle" TargetType="Button">
            <Setter Property="Content" Value="DOC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF0063B1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Ouvrir la documentation"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DocumentationAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Vignette famille (onglet Dossiers) -->
        <DataTemplate x:Key="FamilyItemTemplate" DataType="{x:Type local:FamilyItem}">
            <Border Margin="5" Width="200"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="5"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    MouseLeftButtonDown="FamilyItem_DoubleClick">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Documentation"
                                  Click="DocumentationMenuItem_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Rentrer dans la famille"
                                  Click="OpenFamilyFile_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Charger la dernière version"
                                  Click="ReloadFamily_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                        <Separator/>

                        <!-- Ajout express dans la collection active -->
                        <MenuItem Header="Ajouter à la collection active"
                                  Click="AddToActiveCollection_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="{DynamicResource ImageBackground}" Padding="3">
                            <Image Source="{Binding Icon}"
                                   Width="180" Height="180"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ImageStyle}"/>
                        </Border>
                        <Button Style="{StaticResource DocumentationBadgeStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Click="DocumentationBadge_Click"/>
                    </Grid>
                    <Button Content="3D"
                            Width="28" Height="20" FontSize="10" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                            Click="OnPreview3DClick"
                            ToolTip="Aperçu 3D de la famille"
                            Background="Transparent"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            FocusVisualStyle="{x:Null}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ★ : Favoris -->
                        <Button Grid.Column="0" Content="★"
                                Click="FavoriteButton_Click"
                                ToolTip="Ajouter/retirer des Favoris"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="SkyBlue"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Foreground" Value="Orange"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,5,0"
                                   ToolTip="Nom complet de la famille"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FamilyItemDetailedTemplate" DataType="{x:Type local:FamilyItem}">
            <Border Margin="5"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="5"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    MouseLeftButtonDown="FamilyItem_DoubleClick"
                    HorizontalAlignment="Stretch">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Documentation"
                                  Click="DocumentationMenuItem_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Rentrer dans la famille"
                                  Click="OpenFamilyFile_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Charger la dernière version"
                                  Click="ReloadFamily_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                        <Separator/>

                        <MenuItem Header="Ajouter à la collection active"
                                  Click="AddToActiveCollection_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource ImageBackground}"
                                Padding="3">
                            <Image Source="{Binding Icon}"
                                   Width="200" Height="200"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ImageStyle}"/>
                        </Border>
                        <Button Style="{StaticResource DocumentationBadgeStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Click="DocumentationBadge_Click"/>
                    </Grid>

                    <Grid Grid.Column="1" Margin="20,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="3D"
                                        Width="32" Height="22" FontSize="10" Padding="0"
                                        Margin="0,0,8,0"
                                        Click="OnPreview3DClick"
                                        ToolTip="Aperçu 3D de la famille"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        BorderBrush="Transparent"
                                        FocusVisualStyle="{x:Null}"/>
                                <Button Content="★"
                                        Click="FavoriteButton_Click"
                                        ToolTip="Ajouter/retirer des Favoris"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="18"
                                        Width="32"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="SkyBlue"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                            <Button Click="CategoryPill_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                        <Setter Property="Background" Value="#FFE9EEF6"/>
                                        <Setter Property="BorderBrush" Value="#FFC9D7F5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Category}" Foreground="#FF1F3B57"/>
                            </Button>

                            <Button Click="VersionPill_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                        <Setter Property="Background" Value="#FFF2F5FC"/>
                                        <Setter Property="BorderBrush" Value="#FFDCE6FA"/>
                                        <Setter Property="Foreground" Value="#FF2A3F6A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RevitSavedVersion}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RevitSavedVersion}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Foreground="#FF2A3F6A" FontWeight="SemiBold">
                                    <Run Text="Revit "/>
                                    <Run Text="{Binding RevitSavedVersion}"/>
                                </TextBlock>
                            </Button>

                            <Button Click="SizePill_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                        <Setter Property="Background" Value="#FFFDF2E8"/>
                                        <Setter Property="BorderBrush" Value="#FFF6D9B8"/>
                                        <Setter Property="Foreground" Value="#FF594525"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FileSizeText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FileSizeText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsSizeSortActive}" Value="True">
                                                <Setter Property="Background" Value="#FFF9E2C7"/>
                                                <Setter Property="BorderBrush" Value="#FFE0A35C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding FileSizeText}" Foreground="#FF594525" FontWeight="SemiBold"/>
                            </Button>
                        </WrapPanel>

                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Background="#FFFFFFFF"
                                BorderBrush="#22000000"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Détails"
                                           Foreground="#FF1F3B57"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <Border Height="1"
                                        Margin="0,10,0,14"
                                        Background="#22000000"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Catégorie"/>
                                    <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding Category, TargetNullValue=—}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Version Revit"/>
                                    <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding RevitSavedVersion, TargetNullValue=—}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Dernière mise à jour"/>
                                    <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding LastUpdatedText, TargetNullValue=—}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Taille du fichier"/>
                                    <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding FileSizeText, TargetNullValue=—}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Foreground="#FF6C7A92"
                                               FontWeight="SemiBold"
                                               Text="Numéro OmniClass"/>
                                    <TextBlock Grid.Column="2"
                                               Foreground="#FF1F3B57"
                                               Text="{Binding OmniClassNumber, TargetNullValue=—}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Vignette famille (onglet Favoris/Collections) : bouton 🗑 -->
        <DataTemplate x:Key="CollectionItemTemplate" DataType="{x:Type local:FamilyItem}">
            <Border Margin="5" Width="200"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="5"
                    MouseLeftButtonDown="FamilyItem_DoubleClick">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rentrer dans la famille"
                                  Click="OpenFamilyFile_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Charger la dernière version"
                                  Click="ReloadFamily_Click"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="{DynamicResource ImageBackground}" Padding="3">
                            <Image Source="{Binding Icon}"
                                   Width="180" Height="180"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ImageStyle}"/>
                        </Border>
                        <Button Style="{StaticResource DocumentationBadgeStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Click="DocumentationBadge_Click"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 🗑 : supprimer de la collection courante (taille réduite) -->
                        <Button Grid.Column="0"
        Click="RemoveFromCollection_Click"
        ToolTip="Retirer de la collection courante"
        Background="Transparent"
        BorderThickness="0"
        Padding="0"
        Width="24" Height="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,0,6,0"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Focusable="True">
                            <!-- Icône poubelle animée (hover) -->
                            <ui:AnimatedDeleteIcon IconSize="18"
                         Foreground="{DynamicResource PrimaryText}"/>
                        </Button>

                        <TextBlock Grid.Column="1"
           Text="{Binding Name}"
           Foreground="{DynamicResource PrimaryText}"
           FontWeight="Bold"
           TextWrapping="Wrap"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           Margin="0,0,5,0"/>

                    </Grid>
                    <Button Content="3D"
        Width="28" Height="20" FontSize="10" Padding="0"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
        Click="OnPreview3DClick"
        ToolTip="Aperçu 3D de la famille"
        Background="Transparent"
        BorderThickness="0"
        BorderBrush="Transparent"
        FocusVisualStyle="{x:Null}"/>

                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundGradient}">
        <TabControl x:Name="MainTabControl"
                    Background="{DynamicResource TabBackground}"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <!-- Onglet Dossiers -->
            <TabItem Header="Dossiers" Background="{DynamicResource TabBackground}">
                <Grid Margin="10" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Background="Transparent">
                        <Button x:Name="AllFamiliesButton"
                                Content="{Binding RootFolderName}"
                                FontSize="14" FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryText}"
                                Background="Transparent"
                                BorderThickness="0"
                                Height="35"
                                HorizontalContentAlignment="Left"
                                Click="AllFamiliesButton_Click"/>
                        <TreeView x:Name="FolderTreeView"
                                  Background="{DynamicResource TreeViewBackground}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Height="460"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItemChanged="FolderTreeView_SelectedItemChanged"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Recherche -->
                        <Grid Grid.Row="0">
                            <TextBox x:Name="SearchBox"
                                     Height="30"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                                     Background="#FFFFFF"
                                     Foreground="{DynamicResource PrimaryText}"
                                     BorderBrush="#CCCCCC"
                                     Padding="5"
                                     Margin="5,0,0,0"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="Rechercher (cliquer pour recherche globale)…"
                                       Foreground="Gray"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="#CCCCCC" Margin="0,5"/>

                        <ScrollViewer x:Name="ItemsScroll"
                                      Grid.Row="2"
                                      Background="{DynamicResource ItemsBackground}"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="ItemsScroll_ScrollChanged">
                            <StackPanel>

                                <!-- Top-8 -->
                                <ItemsControl x:Name="TopFamiliesView"
                                              ItemTemplate="{StaticResource FamilyItemTemplate}"
                                              Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Rectangle x:Name="TopSeparator"
                                           Height="1"
                                           Fill="#CCCCCC"
                                           Margin="0,5"
                                           Visibility="Collapsed"/>

                                <!-- Résultats paginés -->
                                <ItemsControl x:Name="FamilyListView"
                                              ItemTemplate="{StaticResource FamilyItemTemplate}"
                                              ItemsPanel="{StaticResource FamilyListWrapPanel}"/>

                                <TextBlock x:Name="PagingStatusText"
                                           Margin="8,12,8,20"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <DockPanel Grid.Row="3">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="DateSortButton"
                                        Content="Date de MAJ"
                                        Click="DateSortButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                            <Setter Property="Padding" Value="12,4"/>
                                            <Setter Property="Background" Value="#FFF2F5FC"/>
                                            <Setter Property="BorderBrush" Value="#FFDCE6FA"/>
                                            <Setter Property="Foreground" Value="#FF2A3F6A"/>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsDateSortActive}" Value="True">
                                                <Setter Property="Background" Value="#FFE0F2FF"/>
                                                <Setter Property="BorderBrush" Value="#FF5AA0FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=DetailedViewCheckBox}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <CheckBox x:Name="DetailedViewCheckBox"
                                          Content="Vue détaillée"
                                          Margin="0,0,20,0"
                                          Foreground="{DynamicResource PrimaryText}"
                                          Checked="DetailedViewCheckBox_Changed"
                                          Unchecked="DetailedViewCheckBox_Changed" Width="92"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Foreground="{DynamicResource PrimaryText}" Margin="5,0,0,0" Text="Familles affichées : "/>
                                <TextBlock x:Name="CountTextBlock" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Onglet Favoris / Collections -->
            <TabItem Header="Favoris" Background="{DynamicResource TabBackground}">
                <Grid Margin="10" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Collection :" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="{DynamicResource PrimaryText}"/>
                            <ComboBox x:Name="CollectionCombo"
                                      Width="240"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="CollectionCombo_SelectionChanged"/>
                            <Button Content="Nouv."   Width="60" Margin="6,0,0,0" Click="CollectionNew_Click"/>
                            <Button Content="Ren."    Width="60" Margin="6,0,0,0" Click="CollectionRename_Click"/>
                            <Button Content="Suppr."  Width="70" Margin="6,0,0,0" Click="CollectionDelete_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="CollectionActionsButton"
                                    Content="Partager"
                                    Width="120"
                                    Margin="0,0,10,0"
                                    Click="CollectionActionsButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Partager la collection…"
                                                  Click="CollectionShareMenuItem_Click"/>
                                        <MenuItem Header="Télécharger les familles…"
                                                  Click="CollectionDownloadMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Charger la collection"
                                    Width="160"
                                    Click="CollectionLoad_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Background="{DynamicResource ItemsBackground}">
                        <ItemsControl x:Name="CollectionListView"
                                      ItemTemplate="{StaticResource CollectionItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <TextBlock Text="Éléments dans la collection : " Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock x:Name="CollectionCountText" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Onglet Paramètres -->
            <TabItem x:Name="SettingsTabItem"
                     Header="Paramètres"
                     Background="{DynamicResource TabBackground}">
                <Grid x:Name="SettingsPanelRoot" Margin="12,10,8,10" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Paramètres d'apparence"
                               FontSize="14" FontWeight="Bold"
                               Grid.Row="0" Margin="0,0,0,10"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,5">
                        <TextBlock Text="Couleur du haut :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <xctk:ColorPicker x:Name="TopColorPicker" Width="150" Height="25" SelectedColor="#FFF2F2F2"/>
                        <TextBlock Text="  Couleur du bas :" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <xctk:ColorPicker x:Name="BottomColorPicker" Width="150" Height="25" SelectedColor="#FFFFFFFF"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,5">
                        <TextBlock Text="PanelBackground :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <xctk:ColorPicker x:Name="PanelBackgroundPicker" Width="150" Height="25" SelectedColor="#F0F0F0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,5">
                        <TextBlock Text="TreeViewBackground :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <xctk:ColorPicker x:Name="TreeViewBackgroundPicker" Width="150" Height="25" SelectedColor="#F0F0F0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,0,0,5">
                        <TextBlock Text="ItemsBackground :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <xctk:ColorPicker x:Name="ItemsBackgroundPicker" Width="150" Height="25" SelectedColor="Transparent"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0,0,0,5">
                        <TextBlock Text="TabBackground :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <xctk:ColorPicker x:Name="TabBackgroundPicker" Width="150" Height="25" SelectedColor="Transparent"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="6" Margin="0,0,0,5" VerticalAlignment="Center"
            xmlns:ui="clr-namespace:BIMaestro.UI">
                        <TextBlock Text="Mode sombre :" VerticalAlignment="Center" Margin="0,0,10,0"
             Foreground="{DynamicResource PrimaryText}"/>
                        <ui:EyeToggleSwitch x:Name="DarkModeSwitch"
                      BaseSize="18"                
                      TransitionMs="420"
                      VerticalAlignment="Center"
                      Toggled="DarkModeSwitch_Toggled" Width="169"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Grid.Row="7" Margin="0,6,0,5">
                        <TextBlock Text="Afficher le Top-8 :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <CheckBox x:Name="ShowTop8CheckBox"
                                  IsChecked="False"
                                  Checked="ShowTop8CheckBox_Changed"
                                  Unchecked="ShowTop8CheckBox_Changed" Height="16"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="8" Margin="0,6,0,5" VerticalAlignment="Center">
                        <TextBlock Text="Toujours au-dessus :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <ui:GhostSwitch x:Name="AlwaysOnTopSwitch"
                                        Width="130"
                                        Height="46"
                                        EyeFollowGlobal="False"
                                        AutoPauseWhenHidden="True"
                                        Toggled="AlwaysOnTopSwitch_Toggled"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="9" Margin="0,10,0,10">
                        <Button Content="Appliquer" Click="ApplyColors_Click" Margin="0,0,10,0" Width="100"/>
                        <Button Content="Enregistrer" Click="SaveConfig_Click" Margin="0,0,10,0" Width="100"/>
                        <Button Content="Réinitialiser" Click="ResetConfig_Click" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="10" Margin="0,0,0,10">
                        <Button Content="Modifier les chemins…"
                                Width="180"
                                Click="ChangePaths_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>