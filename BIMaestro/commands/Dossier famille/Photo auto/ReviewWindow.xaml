<Window x:Class="Famille.PreviewReview.PreviewReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro – Sélection aperçu (Gauche / Droite)"
        Width="1040" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FocusManager.FocusedElement="{Binding ElementName=LeftButton}">

    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding ChooseLeftCommand}" />
        <KeyBinding Key="Right" Command="{Binding ChooseRightCommand}" />
        <KeyBinding Key="NumPad4" Command="{Binding ChooseLeftCommand}" />
        <KeyBinding Key="NumPad6" Command="{Binding ChooseRightCommand}" />

        <KeyBinding Key="Back" Command="{Binding BackCommand}" />
        <KeyBinding Key="NumPad0" Command="{Binding BackCommand}" />

        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="Enter" Command="{Binding ContinueBatchCommand}" />
    </Window.InputBindings>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF7F7F7" Offset="0"/>
            <GradientStop Color="#FFEEF1F4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.18"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ChoiceCardChromeStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Outer"
                                CornerRadius="18"
                                Background="#FFFFFFFF"
                                BorderBrush="#22000000"
                                BorderThickness="1"
                                Effect="{StaticResource SoftShadow}">
                            <ContentPresenter Margin="14"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.995" ScaleY="0.995"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF111827"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0F111827"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1A111827"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="BorderBrush" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF1D4ED8"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF1E40AF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding FamilyDisplayName}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF111827"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF6B7280"
                           TextWrapping="NoWrap">
                    <Run Text="Famille "/>
                    <Run Text="{Binding BatchIndex}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding BatchSize}"/>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding BackCommand}"
                    VerticalAlignment="Top"
                    Content="↩ Retour (Backspace)"
                    IsEnabled="{Binding CanGoBack}"/>
        </Grid>

        <!-- Main: two choices -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <Button x:Name="LeftButton"
                    Grid.Column="0"
                    Style="{StaticResource ChoiceCardChromeStyle}"
                    Command="{Binding ChooseLeftCommand}"
                    IsEnabled="{Binding IsChoiceEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border Style="{StaticResource BadgeStyle}" DockPanel.Dock="Left">
                            <TextBlock Text="Gauche" FontWeight="SemiBold" Foreground="#FF1A1A1A"/>
                        </Border>
                        <TextBlock Text="{Binding LeftCaption}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF5A5A5A"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,0,12"
                            CornerRadius="14"
                            Background="#FFF5F6F8"
                            BorderBrush="#15000000"
                            BorderThickness="1">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <Image Source="{Binding LeftImage}"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Viewbox>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Foreground="#FF6A6A6A" VerticalAlignment="Center">
                            <Run Text="Clique sur l’image ou "/>
                            <Run Text="← / NumPad4" FontWeight="SemiBold"/>
                        </TextBlock>

                        <Border Grid.Column="1"
                                Background="#FF111827"
                                CornerRadius="10"
                                Padding="10,6">
                            <TextBlock Text="Garder"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Button>

            <!-- Right -->
            <Button x:Name="RightButton"
                    Grid.Column="2"
                    Style="{StaticResource ChoiceCardChromeStyle}"
                    Command="{Binding ChooseRightCommand}"
                    IsEnabled="{Binding IsChoiceEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border Style="{StaticResource BadgeStyle}" DockPanel.Dock="Left">
                            <TextBlock Text="Droite" FontWeight="SemiBold" Foreground="#FF1A1A1A"/>
                        </Border>
                        <TextBlock Text="{Binding RightCaption}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF5A5A5A"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,12,0,12"
                            CornerRadius="14"
                            Background="#FFF5F6F8"
                            BorderBrush="#15000000"
                            BorderThickness="1">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <Image Source="{Binding RightImage}"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Viewbox>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Foreground="#FF6A6A6A" VerticalAlignment="Center">
                            <Run Text="Clique sur l’image ou "/>
                            <Run Text="→ / NumPad6" FontWeight="SemiBold"/>
                        </TextBlock>

                        <Border Grid.Column="1"
                                Background="#FF111827"
                                CornerRadius="10"
                                Padding="10,6">
                            <TextBlock Text="Garder"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Button>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Background="#CCFFFFFF"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Foreground="#FF374151" VerticalAlignment="Center">
                    <Run Text="Raccourcis : "/>
                    <Run Text="←/NumPad4 = Gauche" FontWeight="SemiBold"/>
                    <Run Text="  ·  "/>
                    <Run Text="→/NumPad6 = Droite" FontWeight="SemiBold"/>
                    <Run Text="  ·  "/>
                    <Run Text="Backspace = Retour" FontWeight="SemiBold"/>
                    <Run Text="  ·  "/>
                    <Run Text="Esc = Arrêter" FontWeight="SemiBold"/>
                </TextBlock>

                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding StopCommand}"
                        Content="Arrêter (Esc)"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Overlay: Continuer / Arrêter (après 20 choix) -->
        <Grid Visibility="{Binding IsBatchEndPromptVisible, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Border Width="520"
                    Padding="18"
                    Background="#FFFFFFFF"
                    CornerRadius="18"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Effect="{StaticResource SoftShadow}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF111827"
                               Text="Lot terminé (20 familles)"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,14"
                               Foreground="#FF4B5563"
                               TextWrapping="Wrap">
                        Souhaites-tu continuer avec le prochain lot de familles,
                        ou arrêter maintenant ?
                    </TextBlock>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ContinueBatchCommand}"
                                Content="Continuer (Entrée)"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding StopCommand}"
                                Content="Arrêter (Esc)"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
