<Window x:Class="Famille.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro – Sélection des aperçus (A vs B)"
        Width="980" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFF5F6F8"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock x:Name="TxtCounter"
                       DockPanel.Dock="Right"
                       FontSize="13"
                       Foreground="#FF5A5A5A"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtTitle"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF191919"
                       Text="—"/>
        </DockPanel>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <Border x:Name="CardLeft"
                    Grid.Column="0"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#FFD2D6DC"
                    Background="#FFEBEDF0"
                    MouseLeftButtonDown="CardLeft_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Margin="10,10,10,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF2D2D2D"
                               Text="Gauche (A) – Vue existante"/>

                    <Border Grid.Row="1"
                            Margin="10,0,10,10"
                            CornerRadius="10"
                            Background="White"
                            Padding="10">
                        <Grid>
                            <Image x:Name="ImgA" Stretch="Uniform"/>
                            <TextBlock x:Name="TxtMissingA"
                                       Visibility="Collapsed"
                                       Text="Image A manquante"
                                       Foreground="#FF8C2828"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right -->
            <Border x:Name="CardRight"
                    Grid.Column="2"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#FFD2D6DC"
                    Background="#FFEBEDF0"
                    MouseLeftButtonDown="CardRight_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Margin="10,10,10,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF2D2D2D"
                               Text="Droite (B) – Vue preview perso"/>

                    <Border Grid.Row="1"
                            Margin="10,0,10,10"
                            CornerRadius="10"
                            Background="White"
                            Padding="10">
                        <Grid>
                            <Image x:Name="ImgB" Stretch="Uniform"/>
                            <TextBlock x:Name="TxtMissingB"
                                       Visibility="Collapsed"
                                       Text="Image B manquante"
                                       Foreground="#FF8C2828"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left"
                       FontSize="12"
                       Foreground="#FF5A5A5A"
                       VerticalAlignment="Center"
                       Text="Choisir : NumPad4 / ← = Gauche (A)   |   NumPad6 / → = Droite (B)   |   Retour : Backspace / NumPad0"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Retour" Width="90" Margin="6,0,0,0" Click="BtnUndo_Click"/>
                <Button Content="Gauche (A)" Width="110" Margin="6,0,0,0" Click="BtnLeft_Click"/>
                <Button Content="Droite (B)" Width="110" Margin="6,0,0,0" Click="BtnRight_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
