<Window x:Class="Couleur.ColorPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BIMaestro.UI"
        Title="Couleurs du ruban BIMaestro"
        Width="1030"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PanelNameStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource Brand}"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}"
                           Text="Personnaliser les couleurs"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Text="Testez une couleur unie ou un dégradé horizontal, vertical ou diagonal. L’aperçu permet de vérifier immédiatement le fond et la lisibilité du texte."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Ruban BIMaestro">
                <Border Style="{StaticResource Card}">
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="Thème prédéfini"/>

                        <ComboBox Grid.Column="1"
                                  Height="34"
                                  Margin="14,0,8,0"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding PresetEntries}"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedPresetName, Mode=TwoWay}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="180">
                                        <TextBlock x:Name="PresetName"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"/>
                                        <Grid x:Name="SectionHeader"
                                              Margin="0,5"
                                              Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Separator VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Text="{Binding Name}"/>
                                            <Separator Grid.Column="2"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="PresetName"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="SectionHeader"
                                                    Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Height="34"
                                MinWidth="110"
                                Style="{StaticResource SecondaryButton}"
                                Content="Appliquer"
                                Click="ApplyPresetButton_Click"/>

                        <TextBlock Grid.Column="3"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Hint}"
                                   Text="Le thème remplit les lignes ci-dessous ; vous pouvez ensuite personnaliser chaque panneau."/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Aperçu du panneau"/>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Mode"/>
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Couleur de départ"/>
                    <TextBlock Grid.Column="3"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Couleur d’arrivée"/>
                    <TextBlock Grid.Column="4"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Couleur du texte"/>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PanelColors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,9"
                                        BorderBrush="{DynamicResource Divider}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Margin="0,0,10,0"
                                                Padding="10,5"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="#66000000"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock Style="{StaticResource PanelNameStyle}"
                                                       Foreground="{Binding TextBrush}"
                                                       Text="{Binding PanelName}"/>
                                        </Border>

                                        <ComboBox Grid.Column="1"
                                                  Height="30"
                                                  Margin="12,0,0,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding BackgroundModes}"
                                                  SelectedItem="{Binding BackgroundMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Uni, horizontal, vertical ou diagonal"/>

                                        <ui:SimpleColorPicker Grid.Column="2"
                                                              Margin="12,0,0,0"
                                                              MinWidth="160"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="3"
                                                              Margin="12,0,0,0"
                                                              MinWidth="160"
                                                              HorizontalAlignment="Stretch"
                                                              IsEnabled="{Binding CanEditEndColor}"
                                                              ToolTip="Disponible lorsque le mode dégradé est activé"
                                                              SelectedColor="{Binding BackgroundEndColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="4"
                                                              Margin="12,0,0,0"
                                                              MinWidth="160"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{Binding PreferenceFilePath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PreferenceFilePath}"/>
                </StackPanel>
            </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Arborescence du projet">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Border Margin="0,0,4,4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}"
                                           Text="Arborescence du projet"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource Hint}"
                                           TextWrapping="Wrap"
                                           Text="Composez son apparence et contrôlez immédiatement le résultat dans l’aperçu."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Border Margin="0,0,12,0"
                                        Padding="12,5"
                                        Background="{DynamicResource Surface.Subtle}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <CheckBox Margin="0"
                                              FontWeight="SemiBold"
                                              Content="Personnalisation active"
                                              IsChecked="{Binding BrowserPreferences.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <Button MinWidth="150"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Restaurer Revit"
                                        ToolTip="Désactive toute personnalisation et restaure l’apparence native de l’arborescence."
                                        Click="ResetBrowserDefaultsButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="370"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Aperçu direct inspiré de l’arborescence Revit. -->
                            <Border Height="260"
                                    Background="{DynamicResource Surface.Subtle}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <Border Padding="12,0" Background="#25303B">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Border Width="4" Height="17" Margin="0,0,8,0"
                                                        Background="{Binding BrowserPreviewAccentBrush}" CornerRadius="2"/>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Foreground="White" Text="Arborescence du projet"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="#CAD2DA" Text="—  ×"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Background="{Binding BrowserPreviewBackgroundBrush}">
                                        <Grid ClipToBounds="True">
                                            <Border Visibility="{Binding BrowserAuroraVisibility}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#5CFFB4CF" Offset="0"/>
                                                        <GradientStop Color="#52BBE1FF" Offset="0.36"/>
                                                        <GradientStop Color="#4CC5F0DA" Offset="0.68"/>
                                                        <GradientStop Color="#52E2CBFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Canvas IsHitTestVisible="False" Visibility="{Binding BrowserBubblesVisibility}">
                                                <Ellipse Canvas.Left="22" Canvas.Top="18" Width="22" Height="22" Fill="#48FFB4CF" Stroke="#70FFB4CF" StrokeThickness="2"/>
                                                <Ellipse Canvas.Left="285" Canvas.Top="38" Width="34" Height="34" Fill="#42B2DCFF" Stroke="#68B2DCFF" StrokeThickness="2"/>
                                                <Ellipse Canvas.Left="126" Canvas.Top="102" Width="17" Height="17" Fill="#42BFEED3" Stroke="#66BFEED3" StrokeThickness="2"/>
                                                <Ellipse Canvas.Left="305" Canvas.Top="154" Width="25" Height="25" Fill="#3FE1C7FF" Stroke="#64E1C7FF" StrokeThickness="2"/>
                                            </Canvas>

                                            <Canvas IsHitTestVisible="False" Opacity="0.72" Visibility="{Binding BrowserWavesVisibility}">
                                                <Path Canvas.Left="-5" Canvas.Top="28" Stroke="#70A6D3F1" StrokeThickness="3" Data="M0,20 C20,-5 40,-5 60,20 C80,45 100,45 120,20 C140,-5 160,-5 180,20 C200,45 220,45 240,20 C260,-5 280,-5 300,20 C320,45 340,45 380,20"/>
                                                <Path Canvas.Left="-5" Canvas.Top="116" Stroke="#62F4B1CD" StrokeThickness="3" Data="M0,20 C20,-5 40,-5 60,20 C80,45 100,45 120,20 C140,-5 160,-5 180,20 C200,45 220,45 240,20 C260,-5 280,-5 300,20 C320,45 340,45 380,20"/>
                                            </Canvas>

                                            <Canvas IsHitTestVisible="False" Visibility="{Binding BrowserFirefliesVisibility}">
                                                <Ellipse Canvas.Left="32" Canvas.Top="24" Width="8" Height="8" Fill="#CFFFCD6B"/>
                                                <Ellipse Canvas.Left="300" Canvas.Top="55" Width="7" Height="7" Fill="#C99FE0FF"/>
                                                <Ellipse Canvas.Left="176" Canvas.Top="110" Width="6" Height="6" Fill="#C9CDB1FF"/>
                                                <Ellipse Canvas.Left="72" Canvas.Top="164" Width="7" Height="7" Fill="#BFFFCD6B"/>
                                            </Canvas>

                                            <Grid Margin="11">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="#D9FFFFFF"
                                                        BorderBrush="{Binding BrowserPreviewAccentBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Visibility="{Binding BrowserSearchVisibility}">
                                                    <Grid Margin="8,0">
                                                        <TextBlock VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="#6B7280" Text="{Binding BrowserPreviewSearchLabel}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{Binding BrowserPreviewAccentBrush}" Text="⌕"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="3,9,3,0">
                                                    <TextBlock Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding BrowserPreviewTextBrush}" Text="▾  Vues (tout)"/>
                                                    <TextBlock Margin="18,0,0,6" FontSize="11"
                                                               Foreground="{Binding BrowserPreviewTextBrush}" Text="▾  Plans d’étage"/>
                                                    <TextBlock Margin="35,0,0,5" FontSize="11"
                                                               Foreground="{Binding BrowserPreviewTextBrush}"
                                                               Text="{Binding BrowserPreviewSecondaryViewName}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border Margin="31,0,0,5" Padding="5,3"
                                                            Background="{Binding BrowserPreviewAccentBrush}" CornerRadius="3"
                                                            Visibility="{Binding BrowserSearchVisibility}">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                   Text="{Binding BrowserPreviewPrimaryViewName}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <StackPanel Margin="18,1,0,0" Orientation="Horizontal">
                                                        <TextBlock FontSize="11" Foreground="{Binding BrowserPreviewTextBrush}"
                                                                   Text="{Binding BrowserPreviewSectionName}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{Binding BrowserPreviewActiveParentBrush}"
                                                                   Text="★ Vue active" Visibility="{Binding BrowserActiveParentVisibility}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="#DDF6F8FB" Visibility="{Binding BrowserDisabledVisibility}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="20"
                                                               Foreground="{DynamicResource Text.Secondary}" Text="◉"/>
                                                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}" Text="Aperçu désactivé"/>
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Hint}"
                                                               Text="Activez la personnalisation pour l’utiliser."/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Padding="10,0" Background="#F1F4F6" BorderBrush="#DDE2E7" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#66717D" Text="APERÇU EN DIRECT"/>
                                            <Button HorizontalAlignment="Right"
                                                    Height="22"
                                                    MinWidth="104"
                                                    Padding="8,0"
                                                    FontSize="10"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="↻ Noms fictifs"
                                                    ToolTip="Générer un nouvel exemple de vues"
                                                    Click="RegenerateBrowserPreviewButton_Click"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="16"
                                    Background="{DynamicResource Surface.Subtle}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    IsEnabled="{Binding BrowserPreferences.IsEnabled}">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}" Text="01  Apparence"/>
                                    <TextBlock Margin="0,4,0,10" Style="{StaticResource Hint}"
                                               Text="Choisissez le décor, puis ajustez les couleurs dans l’aperçu."/>
                                    <TextBlock Margin="0,0,0,5" Style="{StaticResource Hint}"
                                               FontWeight="SemiBold" Text="Style du fond"/>
                                    <ComboBox Height="32" Margin="0,0,0,8"
                                              ItemsSource="{Binding BrowserBackgroundModes}"
                                              SelectedItem="{Binding BrowserPreferences.BackgroundMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Margin="0,0,0,5" Style="{StaticResource Hint}" FontWeight="SemiBold" Text="Fond principal"/>
                                    <ui:SimpleColorPicker HorizontalAlignment="Stretch"
                                                          SelectedColor="{Binding BrowserPreferences.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Style="{StaticResource Hint}" FontWeight="SemiBold" Text="Texte"/>
                                            <ui:SimpleColorPicker HorizontalAlignment="Stretch"
                                                                  SelectedColor="{Binding BrowserPreferences.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Style="{StaticResource Hint}" FontWeight="SemiBold" Text="Accent et recherche"/>
                                            <ui:SimpleColorPicker HorizontalAlignment="Stretch"
                                                                  SelectedColor="{Binding BrowserPreferences.AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="16"
                                Background="{DynamicResource Surface.Subtle}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="Navigation depuis une feuille"/>
                                    <TextBlock Margin="0,5,24,0"
                                               Style="{StaticResource Hint}"
                                               TextWrapping="Wrap"
                                               Text="Lorsqu’un viewport ou une nomenclature est sélectionné sur une feuille, BIMaestro recherche sa vue et l’encadre avec la couleur d’accent."/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Content="Recherche automatique"
                                          ToolTip="Activée par défaut. La recherche reste visible 300 ms pendant le clic dans l’arborescence."
                                          IsChecked="{Binding BrowserPreferences.IsSheetViewSearchEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="0,14,0,0"
                                Padding="16"
                                Background="{DynamicResource Surface.Subtle}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="Repère de la vue active"/>
                                    <TextBlock Margin="0,5,24,0"
                                               Style="{StaticResource Hint}"
                                               TextWrapping="Wrap"
                                               Text="Colore et marque d’une étoile le parent visible le plus proche de la vue active. Le repère descend automatiquement lorsque vous dépliez la branche."/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Margin="18,0"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Content="Afficher le repère"
                                          IsChecked="{Binding BrowserPreferences.IsActiveViewParentHighlightEnabled, Mode=TwoWay}"/>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource Hint}"
                                               FontWeight="SemiBold"
                                               Text="Couleur du parent"/>
                                    <ui:SimpleColorPicker HorizontalAlignment="Stretch"
                                                          SelectedColor="{Binding BrowserPreferences.ActiveViewParentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="4"
                                    Margin="0,18,0,0"
                                    VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Les changements sont appliqués après Enregistrer. Revit 2023 conserve son arborescence native."/>
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Hint}"
                                       Text="{Binding PreferenceFilePath}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PreferenceFilePath}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="150"
                    Style="{StaticResource SecondaryButton}"
                    Content="Valeurs par défaut"
                    Click="ResetDefaultsButton_Click"/>

            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    MinWidth="190"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"
                    Content="Encore + · Tout Revit"
                    Click="OpenRevitColorsButton_Click"/>

            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    MinWidth="100"
                    Style="{StaticResource SecondaryButton}"
                    Content="Annuler"
                    IsCancel="True"/>

            <Button Grid.Column="3"
                    MinWidth="150"
                    Style="{StaticResource PrimaryButton}"
                    Content="Enregistrer"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
