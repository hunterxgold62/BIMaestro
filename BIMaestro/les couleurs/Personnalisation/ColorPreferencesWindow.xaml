<Window x:Class="Couleur.ColorPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BIMaestro.UI"
        Title="Couleurs du ruban BIMaestro"
        Width="1030"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PanelNameStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource Brand}"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}"
                           Text="Personnaliser les couleurs"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Text="Testez une couleur unie ou un dégradé horizontal, vertical ou diagonal. L’aperçu permet de vérifier immédiatement le fond et la lisibilité du texte."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Ruban BIMaestro">
                <Border Style="{StaticResource Card}">
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="Thème prédéfini"/>

                        <ComboBox Grid.Column="1"
                                  Height="34"
                                  Margin="14,0,8,0"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding PresetEntries}"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedPresetName, Mode=TwoWay}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="180">
                                        <TextBlock x:Name="PresetName"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"/>
                                        <Grid x:Name="SectionHeader"
                                              Margin="0,5"
                                              Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Separator VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Text="{Binding Name}"/>
                                            <Separator Grid.Column="2"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="PresetName"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="SectionHeader"
                                                    Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Height="34"
                                MinWidth="110"
                                Style="{StaticResource SecondaryButton}"
                                Content="Appliquer"
                                Click="ApplyPresetButton_Click"/>

                        <TextBlock Grid.Column="3"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Hint}"
                                   Text="Le thème remplit les lignes ci-dessous ; vous pouvez ensuite personnaliser chaque panneau."/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Aperçu du panneau"/>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Mode"/>
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Couleur de départ"/>
                    <TextBlock Grid.Column="3"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Couleur d’arrivée"/>
                    <TextBlock Grid.Column="4"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Couleur du texte"/>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PanelColors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,9"
                                        BorderBrush="{DynamicResource Divider}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Margin="0,0,10,0"
                                                Padding="10,5"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="#66000000"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock Style="{StaticResource PanelNameStyle}"
                                                       Foreground="{Binding TextBrush}"
                                                       Text="{Binding PanelName}"/>
                                        </Border>

                                        <ComboBox Grid.Column="1"
                                                  Height="30"
                                                  Margin="12,0,0,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding BackgroundModes}"
                                                  SelectedItem="{Binding BackgroundMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Uni, horizontal, vertical ou diagonal"/>

                                        <ui:SimpleColorPicker Grid.Column="2"
                                                              Margin="12,0,0,0"
                                                              MinWidth="160"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="3"
                                                              Margin="12,0,0,0"
                                                              MinWidth="160"
                                                              HorizontalAlignment="Stretch"
                                                              IsEnabled="{Binding CanEditEndColor}"
                                                              ToolTip="Disponible lorsque le mode dégradé est activé"
                                                              SelectedColor="{Binding BackgroundEndColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="4"
                                                              Margin="12,0,0,0"
                                                              MinWidth="160"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{Binding PreferenceFilePath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PreferenceFilePath}"/>
                </StackPanel>
            </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Arborescence du projet">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}"
                                           Text="Personnalisation de l’arborescence"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource Hint}"
                                           TextWrapping="Wrap"
                                           Text="Réglez séparément son apparence et son comportement. Disponible dans Revit 2024 et les versions suivantes."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <CheckBox Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Content="Activer"
                                          IsChecked="{Binding BrowserPreferences.IsEnabled, Mode=TwoWay}"/>
                                <Button MinWidth="150"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Restaurer Revit"
                                        ToolTip="Désactive toute personnalisation et restaure l’apparence native de l’arborescence."
                                        Click="ResetBrowserDefaultsButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Padding="16"
                                Background="{DynamicResource Surface.Subtle}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="Apparence"/>

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource Hint}"
                                                   FontWeight="SemiBold"
                                                   Text="Style du fond"/>
                                        <ComboBox Height="32"
                                                  ItemsSource="{Binding BrowserBackgroundModes}"
                                                  SelectedItem="{Binding BrowserPreferences.BackgroundMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,16,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource Hint}"
                                                   FontWeight="SemiBold"
                                                   Text="Fond principal"/>
                                        <ui:SimpleColorPicker MinWidth="170"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding BrowserPreferences.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Margin="0,0,16,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource Hint}"
                                                   FontWeight="SemiBold"
                                                   Text="Texte"/>
                                        <ui:SimpleColorPicker MinWidth="170"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding BrowserPreferences.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource Hint}"
                                                   FontWeight="SemiBold"
                                                   Text="Accent et recherche"/>
                                        <ui:SimpleColorPicker MinWidth="170"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding BrowserPreferences.AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="16"
                                Background="{DynamicResource Surface.Subtle}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="Navigation depuis une feuille"/>
                                    <TextBlock Margin="0,5,24,0"
                                               Style="{StaticResource Hint}"
                                               TextWrapping="Wrap"
                                               Text="Lorsqu’un viewport ou une nomenclature est sélectionné sur une feuille, BIMaestro recherche sa vue et l’encadre avec la couleur d’accent."/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Content="Recherche automatique"
                                          ToolTip="Activée par défaut. La recherche reste visible 300 ms pendant le clic dans l’arborescence."
                                          IsChecked="{Binding BrowserPreferences.IsSheetViewSearchEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3"
                                    Margin="0,18,0,0"
                                    VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Les changements sont appliqués après Enregistrer. Revit 2023 conserve son arborescence native."/>
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Hint}"
                                       Text="{Binding PreferenceFilePath}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PreferenceFilePath}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="150"
                    Style="{StaticResource SecondaryButton}"
                    Content="Valeurs par défaut"
                    Click="ResetDefaultsButton_Click"/>

            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    MinWidth="190"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"
                    Content="Encore + · Tout Revit"
                    Click="OpenRevitColorsButton_Click"/>

            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    MinWidth="100"
                    Style="{StaticResource SecondaryButton}"
                    Content="Annuler"
                    IsCancel="True"/>

            <Button Grid.Column="3"
                    MinWidth="150"
                    Style="{StaticResource PrimaryButton}"
                    Content="Enregistrer"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
