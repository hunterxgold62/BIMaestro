<Window x:Class="Couleur.RevitColorPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BIMaestro.UI"
        Title="Encore + · Couleurs de Revit"
        Width="1100"
        Height="650"
        MinWidth="960"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        Background="{DynamicResource App.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PanelNameStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                Background="{DynamicResource Brand}"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource H1}"
                               Text="Encore + · Tout le ruban Revit"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Text="Choisissez un onglet et ses couleurs. Par défaut, seul le bandeau de titre est modifié ; activez « Panneau complet » pour étendre la couleur à toute sa surface."/>
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Background="#22FFFFFF"
                        CornerRadius="8">
                    <CheckBox VerticalAlignment="Center"
                              Foreground="White"
                              FontWeight="SemiBold"
                              Content="Activer Encore + sur Revit"
                              ToolTip="Interrupteur général : désactive temporairement toutes les couleurs natives sans effacer les panneaux cochés."
                              IsChecked="{Binding IsGlobalColoringEnabled, Mode=TwoWay}"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource Surface.Subtle}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="Onglet Revit"/>

                        <ComboBox x:Name="TabSelector"
                                  Grid.Column="1"
                                  Height="34"
                                  Margin="14,0,0,0"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Title"
                                  ItemsSource="{Binding Tabs}"
                                  SelectedItem="{Binding SelectedTab, Mode=TwoWay}"/>

                        <Button Grid.Column="2"
                                Height="34"
                                Margin="10,0,0,0"
                                MinWidth="185"
                                Style="{StaticResource SecondaryButton}"
                                Content="Remettre cet onglet à zéro"
                                ToolTip="Efface toutes les personnalisations de l’onglet sélectionné et restaure l’apparence Revit."
                                Click="ResetSelectedTabButton_Click"/>

                        <TextBlock Grid.Column="3"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Hint}"
                                   Text="{Binding DiscoveryMessage}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Panneau complet"
                               ToolTip="Décoché : seul le bandeau de titre est coloré. Coché : toute la surface du panneau est colorée."/>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Aperçu du panneau"/>
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Mode"/>
                    <TextBlock Grid.Column="3"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Départ"/>
                    <TextBlock Grid.Column="4"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Arrivée"/>
                    <TextBlock Grid.Column="5"
                               Margin="12,0,0,0"
                               Style="{StaticResource Hint}"
                               FontWeight="SemiBold"
                               Text="Texte"/>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedItem.Panels, ElementName=TabSelector}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,9"
                                        BorderBrush="{DynamicResource Divider}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ToolTip="Décoché : bandeau de titre uniquement. Coché : panneau complet."
                                                  IsChecked="{Binding IsFullPanel, Mode=TwoWay}"/>

                                        <Border Grid.Column="1"
                                                Margin="0,0,10,0"
                                                Padding="10,5"
                                                Background="{Binding Palette.BackgroundBrush}"
                                                BorderBrush="#66000000"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock Style="{StaticResource PanelNameStyle}"
                                                       Foreground="{Binding Palette.TextBrush}"
                                                       Text="{Binding Palette.PanelName}"/>
                                        </Border>

                                        <ComboBox Grid.Column="2"
                                                  Height="30"
                                                  Margin="12,0,0,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Palette.BackgroundModes}"
                                                  SelectedItem="{Binding Palette.BackgroundMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="3"
                                                              Margin="12,0,0,0"
                                                              MinWidth="150"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding Palette.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="4"
                                                              Margin="12,0,0,0"
                                                              MinWidth="150"
                                                              HorizontalAlignment="Stretch"
                                                              IsEnabled="{Binding Palette.CanEditEndColor}"
                                                              SelectedColor="{Binding Palette.BackgroundEndColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ui:SimpleColorPicker Grid.Column="5"
                                                              Margin="12,0,0,0"
                                                              MinWidth="150"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedColor="{Binding Palette.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{Binding AutoSaveStatus}"/>
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource Hint}"
                               Text="{Binding PreferenceFilePath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PreferenceFilePath}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource Hint}"
                       Text="Vous pouvez continuer à travailler dans Revit : chaque modification est appliquée et enregistrée automatiquement."/>

            <Button Grid.Column="1"
                    MinWidth="120"
                    Style="{StaticResource PrimaryButton}"
                    Content="Fermer"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
