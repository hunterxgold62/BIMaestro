<Window x:Class="BIMaestro.Dashboard.TimeSeriesDashboardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
 Title="BIMaestro — Temps par projet" Width="1180" Height="820" MinWidth="960" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource App.Background}" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="MinWidth" Value="90"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface.Subtle}"/><Setter Property="BorderThickness" Value="0"/></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Brand}" Margin="-24,-24,-24,18" Padding="24,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Ouvrir Excel" Click="Excel_Click"/><Button Content="Actualiser" Click="Reload_Click"/></StackPanel>
    <StackPanel><TextBlock Text="BIMaestro  /  ANALYSE" Foreground="White" Opacity="0.75" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Votre temps dans Revit" Style="{StaticResource H1}"/><TextBlock Text="Du quotidien au détail de chaque maquette." Foreground="White" Opacity="0.8" FontSize="12" Margin="0,6,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_Changed">
   <TabItem Header="Aperçu"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Seven" Content="7 jours" Tag="7" Click="Range_Click"/><Button x:Name="Fifteen" Content="15 jours" Tag="15" Click="Range_Click"/></StackPanel><TextBlock x:Name="OverviewPeriod" Style="{StaticResource H2}" VerticalAlignment="Center"/></DockPanel>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,14">
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Temps actif total" Style="{StaticResource Hint}"/><TextBlock x:Name="OverviewHours" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Par jour travaillé" Style="{StaticResource Hint}"/><TextBlock x:Name="OverviewAverage" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Maquettes et familles utilisées" Style="{StaticResource Hint}"/><TextBlock x:Name="OverviewCount" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><oxy:PlotView x:Name="OverviewPlot"/><TextBlock x:Name="OverviewEmpty" Text="Aucune activité enregistrée sur cette période." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Border>
    <Border Grid.Row="3" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Vos maquettes · double-cliquez pour analyser" Style="{StaticResource H2}"/>
     <DataGrid x:Name="OverviewTable" Grid.Row="1" MouseDoubleClick="Overview_Open"><DataGrid.Columns>
      <DataGridTextColumn Header="Maquette / famille" Binding="{Binding Name}" Width="*"/>
      <DataGridTemplateColumn Header="Part du temps" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Share}" Maximum="100" Height="8" Margin="0,12,12,12" Foreground="{Binding Brush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Temps actif" Binding="{Binding Duration}" Width="130"/>
     </DataGrid.Columns></DataGrid></Grid></Border>
   </Grid></TabItem>
   <TabItem Header="Analyse détaillée"><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Période et maquettes" Style="{StaticResource H2}"/><TextBlock Text="Du" Style="{StaticResource Hint}"/><DatePicker x:Name="From" SelectedDateChanged="Filter_Changed"/><TextBlock Text="Au (inclus)" Style="{StaticResource Hint}" Margin="0,8,0,0"/><DatePicker x:Name="To" SelectedDateChanged="Filter_Changed"/>
      <TextBlock Text="Rechercher un nom ou un chemin" Style="{StaticResource Hint}" Margin="0,12,0,4"/><TextBox x:Name="Search" TextChanged="Search_Changed"/>
      <Expander Header="Filtres complémentaires" Margin="0,0,0,10"><StackPanel Margin="0,8,0,0">
       <TextBlock Text="Type de document" Style="{StaticResource Hint}"/><ComboBox x:Name="Kind" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Maquettes et familles"/><ComboBoxItem Content="Maquettes (.rvt)"/><ComboBoxItem Content="Familles (.rfa)"/></ComboBox>
       <TextBlock Text="Version Revit" Style="{StaticResource Hint}"/><ComboBox x:Name="Version" SelectionChanged="Filter_Changed"/>
       <TextBlock Text="Paramètres du projet" Style="{StaticResource Hint}"/><TextBox x:Name="ParameterSearch" ToolTip="Rechercher un nom de paramètre ou une valeur enregistrée." TextChanged="Search_Changed"/>
      </StackPanel></Expander>
     </StackPanel>
     <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button Content="Tout cocher" Click="SelectAll_Click"/><Button Content="Tout décocher" Click="ClearSelection_Click"/></WrapPanel>
     <ListBox x:Name="Picker" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" ToolTip="{Binding Path}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="Selection_Changed" Unchecked="Selection_Changed"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="3" x:Name="SelectionCount" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    </Grid></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
     <DockPanel><Button x:Name="PdfButton" DockPanel.Dock="Right" Content="Exporter PDF" Style="{StaticResource PrimaryButton}" Click="Pdf_Click"/><TextBlock Text="Temps sur la sélection" Style="{StaticResource H2}"/></DockPanel>
     <TextBlock x:Name="DetailSummary" Grid.Row="1" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,12" TextWrapping="Wrap"/>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><oxy:PlotView x:Name="DetailPlot"/><TextBlock x:Name="DetailEmpty" Text="Aucune activité pour cette sélection." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Border>
     <Border Grid.Row="3" Style="{StaticResource Card}"><DataGrid x:Name="DetailTable"><DataGrid.Columns>
      <DataGridTextColumn Header="Maquette / famille" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="Temps actif" Binding="{Binding Duration}" SortMemberPath="Hours" Width="100"/>
      <DataGridTextColumn Header="Jours" Binding="{Binding Days}" Width="55"/>
      <DataGridTextColumn Header="Dernière activité" Binding="{Binding Last, StringFormat=dd/MM/yyyy}" Width="120"/>
      <DataGridTextColumn Header="Version" Binding="{Binding Versions}" Width="80"/>
     </DataGrid.Columns></DataGrid></Border>
    </Grid>
   </Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="Status" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
 </Grid>
</Window>
