<Window x:Class="BIMaestro.Dashboard.TimeSeriesDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        Title="BIMaestro — Temps par type de document"
        Width="1280" Height="880" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- =============== RESSOURCES (styles + couleurs) =============== -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Cartes -->
            <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>

            <!-- Typographie locale alignée thème -->
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Boutons -->
            <Style x:Key="DashboardPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="130"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style x:Key="DashboardGhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinWidth" Value="30"/>
            </Style>

            <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinWidth" Value="64"/>
            </Style>

            <Style x:Key="SegmentToggle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="130"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Hover.Fill}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Item légende -->
            <DataTemplate x:Key="LegendItemTemplate">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"
                            Background="{Binding Brush}"/>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DataTemplate>

            <!-- Style items de la liste projets -->
            <Style x:Key="ProjectItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ToolTip" Value="{Binding DocumentId}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Hover.Fill}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ============================= LAYOUT ============================= -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== KPI ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,12,0">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Margin="16">
                        <TextBlock Text="Heures sur la période" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock x:Name="_kpiHours" Text="0.0 h" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Margin="16">
                        <TextBlock Text="Projets sélectionnés" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock x:Name="_kpiProjects" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Margin="16">
                        <TextBlock Text="Moyenne / jour" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock x:Name="_kpiAvg" Text="0.0 h" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel Margin="16,14" Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Temps par type de document" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="_tgRvt" Style="{StaticResource SegmentToggle}" Content="Maquettes (.rvt)" Checked="DocTypeToggle_Click"/>
                        <ToggleButton x:Name="_tgRfa" Style="{StaticResource SegmentToggle}" Content="Familles (.rfa)" Checked="DocTypeToggle_Click"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,8">
                            <TextBlock Text="Légende" VerticalAlignment="Center"/>
                            <CheckBox x:Name="_cbLegend" Content="Afficher" Margin="6,0,0,0" IsChecked="True" Checked="Legend_Checked" Unchecked="Legend_Checked"/>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DashboardGhostButton}" Content="Exporter PNG" Click="ExportPng_Click"/>
                        <Button Style="{StaticResource DashboardGhostButton}" Content="Exporter CSV" Click="ExportCsv_Click"/>
                        <Button Style="{StaticResource DashboardPrimaryButton}" Content="Ouvrir Excel" Click="OpenExcel_Click"/>
                        <Button Style="{StaticResource DashboardGhostButton}" Content="Réinitialiser" Click="Reset_Click"/>
                    </WrapPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dates -->
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Text="Période" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <DatePicker x:Name="_dpFrom" Width="150" Margin="0,0,8,0" SelectedDateChanged="OnDateChanged"/>
                            <DatePicker x:Name="_dpTo" Width="150" SelectedDateChanged="OnDateChanged"/>
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource ChipButton}" Content="7 j" Click="Chip7_Click"/>
                            <Button Style="{StaticResource ChipButton}" Content="30 j" Click="Chip30_Click"/>
                            <Button Style="{StaticResource ChipButton}" Content="YTD" Click="ChipYtd_Click"/>
                            <Button Style="{StaticResource ChipButton}" Content="12 m" Click="Chip12m_Click"/>
                            <Button Style="{StaticResource ChipButton}" Content="Tout" Click="ChipAll_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Mode + tri + Top N -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="12,0">
                        <TextBlock Text="Affichage" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ToggleButton x:Name="_tgOverview" Style="{StaticResource SegmentToggle}" Content="Aperçu" Checked="Mode_Checked"/>
                            <ToggleButton x:Name="_tgCompare"  Style="{StaticResource SegmentToggle}" Content="Comparer" Checked="Mode_Checked"/>
                        </WrapPanel>


                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <TextBlock Text="Top N" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="_btnTopNMinus" Style="{StaticResource TinyButton}" Content="–" Click="BtnTopNMinus_Click"/>
                            <TextBox x:Name="_tbTopN" Width="48" Height="28" Text="20" HorizontalContentAlignment="Center"
                                     PreviewTextInput="TopN_PreviewTextInput" TextChanged="TopN_TextChanged"/>
                            <Button x:Name="_btnTopNPlus" Style="{StaticResource TinyButton}" Content="+" Click="BtnTopNPlus_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== BODY ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Visualisation -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="12">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="_colChart" Width="3*"/>
                        <ColumnDefinition x:Name="_colLegend" Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Temps par type de document" Style="{StaticResource H2}" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

                    <Border x:Name="_chartBorder" Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Surface}" CornerRadius="10">
                        <oxy:PlotView x:Name="_plotView" Background="{DynamicResource Surface}" />
                    </Border>

                    <Border x:Name="_legendBorder" Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface.Subtle}" Padding="10" Margin="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Légende" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="_legendList" ItemTemplate="{StaticResource LegendItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Panneau latéral -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="12,12,12,6">
                    <StackPanel Margin="14">
                        <TextBlock Text="Recherche rapide" Style="{StaticResource H2}"/>
                        <TextBlock Text="Tapez pour trouver un projet/famille et ouvrir son dossier sans impacter les graphiques." Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="_tbSearch" Height="32" MinWidth="260"
                                     ToolTip="Ctrl+F. Échap pour effacer. Accent-insensible."
                                     KeyDown="Search_KeyDown" TextChanged="Search_TextChanged"/>
                            <Button x:Name="_btnClearSearch" Grid.Column="1" Style="{StaticResource TinyButton}" Content="✕" Click="ClearSearch_Click"/>
                        </Grid>

                        <TextBlock x:Name="_lblCount" Margin="0,4,0,0" Foreground="{DynamicResource Text.Secondary}"/>

                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Surface.Subtle}" Padding="10" Margin="0,8,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="160">
                                <ItemsControl x:Name="_icSuggestions">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChipButton}" Height="32" Padding="12,6" Margin="0,4,6,4"
                                                    VerticalContentAlignment="Center"
                                                    Content="{Binding BaseName}"
                                                    Tag="{Binding DocumentId}" Click="Suggestion_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Button Style="{StaticResource DashboardPrimaryButton}" Content="Ouvrir l'emplacement" HorizontalAlignment="Right" Click="OpenLocation_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="12,6,12,12">
                    <StackPanel Margin="14">
                        <TextBlock Text="Astuces" Style="{StaticResource H2}"/>
                        <TextBlock Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0">
• Utilisez la barre de recherche pour filtrer les maquettes/familles.
• Cliquez sur un résultat pour ouvrir rapidement son dossier.
• Ajustez le Top N pour épurer les graphiques.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>