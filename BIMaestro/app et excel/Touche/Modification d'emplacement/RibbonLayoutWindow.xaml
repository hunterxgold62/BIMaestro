<Window x:Class="BIMaestro.RibbonLayout.RibbonLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options BIMaestro"
        Height="625"
        Width="860"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="4,0"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover.Fill}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface.Subtle}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Key="HelpButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="#F1F3F5"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brand}"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource H1}" Text="Configuration BIMaestro"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Foreground="White"
                               Margin="0,6,0,0"
                               Text="Personnalisez l’ordre des panneaux et boutons du ruban, puis renseignez vos informations de contact si besoin."/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="HelpButton"
                        Content="?"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Style="{StaticResource HelpButtonStyle}"
                        ToolTip="Ouvrir l’aide en ligne"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Ruban" Margin="0,0,-4,0">
                    <Grid Margin="10,12,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource H2}" Text="Panneaux"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource H2}" Text="Boutons du panneau sélectionné"/>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="PanelsList"
                                     Grid.Row="0"
                                     ItemsSource="{Binding Panels}"
                                     SelectedItem="{Binding SelectedPanel}"
                                     DisplayMemberPath="DisplayName"
                                     MinHeight="280"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Style="{StaticResource IconButton}" Content="↑" Margin="0,0,8,0" Click="MovePanelUp"/>
                                <Button Style="{StaticResource IconButton}" Content="↓" Click="MovePanelDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="ButtonsList"
                                     Grid.Row="0"
                                     ItemsSource="{Binding SelectedPanel.Buttons}"
                                     SelectedItem="{Binding SelectedPanel.SelectedButton}"
                                     DisplayMemberPath="DisplayName"
                                     MinHeight="280"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Style="{StaticResource IconButton}" Content="↑" Margin="0,0,8,0" Click="MoveButtonUp"/>
                                <Button Style="{StaticResource IconButton}" Content="↓" Click="MoveButtonDown"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="3"
                                   Style="{StaticResource Hint}"
                                   Text="Les modifications seront appliquées au prochain démarrage de Revit."/>
                    </Grid>
                </TabItem>

                <TabItem Header="Contact" Margin="12,0,-12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource H2}" Text="Langue de l’interface"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,8"
                                       Text="Choisissez la langue de BIMaestro. Le changement sera appliqué au prochain démarrage de Revit."/>
                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="Label"
                                      MinWidth="260"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,18"/>

                            <TextBlock Style="{StaticResource H2}" Text="Informations (optionnel)"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,14"
                                       Text="Renseigne ton email si tu veux recevoir les infos importantes. Pour me contacter directement, passe par LinkedIn."/>

                            <TextBlock Style="{StaticResource Label}" Text="Email (optionnel)"/>
                            <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Label}" Text="Prénom (optionnel)"/>
                                    <TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="Nom (optionnel)"/>
                                    <TextBox x:Name="LastNameBox" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Hint}" Text="Ces informations restent modifiables à tout moment."/>

                            <Border Background="{DynamicResource Surface.Subtle}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="15"
                                               Text="Une question, un bug ou une idée ?"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Text="BIMaestro est développé par une seule personne. Tes retours m’aident énormément à repérer ce qui ne fonctionne pas, à améliorer les outils existants et à choisir les prochaines évolutions."/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Text="Même un message rapide peut faire la différence, alors n’hésite pas à me contacter :"/>
                                    <TextBlock Margin="0,12,0,0">
                                        <Run Text="LinkedIn : "/>
                                        <Hyperlink NavigateUri="https://www.linkedin.com/in/paul-lemert-b40921207"
                                                   RequestNavigate="OnRequestNavigate">
                                            <Run Text="Paul Lemert"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Margin="0,6,0,0">
                                        <Run Text="E-mail : "/>
                                        <Hyperlink NavigateUri="mailto:bimaestro.plugin@gmail.com"
                                                   RequestNavigate="OnRequestNavigate">
                                            <Run Text="bimaestro.plugin@gmail.com"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annuler" MinWidth="100" Margin="0,0,8,0" Click="Cancel"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" MinWidth="130" Click="Save"/>
        </StackPanel>
    </Grid>
</Window>
