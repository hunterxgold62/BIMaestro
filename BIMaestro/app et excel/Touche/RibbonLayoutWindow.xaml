<Window x:Class="BIMaestro.RibbonLayout.RibbonLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="525" Width="820" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Ruban">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Panneaux" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="Boutons du panneau sélectionné" FontWeight="Bold" FontSize="14" Grid.Column="1" />

                    <StackPanel Grid.Row="1" Margin="0,8,8,8">
                        <ListBox x:Name="PanelsList" ItemsSource="{Binding Panels}" SelectedItem="{Binding SelectedPanel}" DisplayMemberPath="DisplayName" Height="320" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="↑" Width="32" Margin="4,0" Click="MovePanelUp" />
                            <Button Content="↓" Width="32" Margin="4,0" Click="MovePanelDown" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,8">
                        <ListBox x:Name="ButtonsList" ItemsSource="{Binding SelectedPanel.Buttons}" SelectedItem="{Binding SelectedPanel.SelectedButton}" DisplayMemberPath="DisplayName" Height="320" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="↑" Width="32" Margin="4,0" Click="MoveButtonUp" />
                            <Button Content="↓" Width="32" Margin="4,0" Click="MoveButtonDown" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                               Text="Les modifications seront appliquées au prochain démarrage de Revit." />
                </Grid>
            </TabItem>

            <TabItem Header="Contact">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock FontWeight="Bold" FontSize="14" Text="Informations (optionnel)" />
                        <TextBlock Margin="0,6,0,16" Opacity="0.70"
                                   Text="Renseigne ton email, prénom et nom si tu veux recevoir des infos ou corrections importantes." />

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email (optionnel)" Opacity="0.75" Margin="2,0,0,6" />
                            <TextBox x:Name="EmailBox" Height="32" Padding="10,6" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prénom (optionnel)" Opacity="0.75" Margin="2,0,0,6" />
                                <TextBox x:Name="FirstNameBox" Height="32" Padding="10,6" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nom (optionnel)" Opacity="0.75" Margin="2,0,0,6" />
                                <TextBox x:Name="LastNameBox" Height="32" Padding="10,6" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Opacity="0.60" Text="Ces informations restent modifiables à tout moment." />

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Contact" FontWeight="Bold" FontSize="13" />
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="LinkedIn : " />
                                <Hyperlink NavigateUri="https://www.linkedin.com/in/paul-lemert-b40921207"
                                           RequestNavigate="OnRequestNavigate">
                                    <Run Text="paul-lemert" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="Email : " />
                                <Hyperlink NavigateUri="mailto:bimaestro.plugin@gmail.com"
                                           RequestNavigate="OnRequestNavigate">
                                    <Run Text="bimaestro.plugin@gmail.com" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Enregistrer" Width="120" Margin="0,0,8,0" Click="Save" />
            <Button Content="Annuler" Width="80" Click="Cancel" />
        </StackPanel>
    </Grid>
</Window>