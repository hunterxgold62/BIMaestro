<Window x:Class="BIMaestro.Welcome.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro — Bienvenue"
        Width="610" Height="635"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource App.Background}"
        ShowInTaskbar="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WelcomePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinWidth" Value="190"/>
                <Setter Property="Height" Value="40"/>
            </Style>
            <Style x:Key="WelcomeSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="136"/>
                <Setter Property="Height" Value="40"/>
            </Style>
            <Style x:Key="TrustText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="18"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource Card}" Padding="0" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Padding="20" CornerRadius="18,18,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F5132" Offset="0"/>
                            <GradientStop Color="#188F69" Offset="0.72"/>
                            <GradientStop Color="#D97706" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="14" Background="#EEFFFFFF">
                            <Image x:Name="LogoImage" Width="43" Height="43" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Bienvenue dans BIMaestro" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Margin="0,5,0,0" Foreground="#E8FFF4" FontSize="13.5"
                                       Text="Un plugin Revit gratuit, développé avec les retours du terrain."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="22,18,22,14">
                    <TextBlock Text="Souhaitez-vous rester informé ?" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource TrustText}"
                               Text="Recevez uniquement les informations utiles : correctifs importants, nouveautés et demandes occasionnelles de retour."/>

                    <Border Margin="0,14,0,14" Padding="14" CornerRadius="12"
                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Vous gardez le contrôle" Foreground="#065F46" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,5,0,0" Foreground="#047857" TextWrapping="Wrap" LineHeight="19"
                                       Text="✓ Email facultatif   •   ✓ Aucun compte à créer   •   ✓ Modifiable ou supprimable depuis Options"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Votre email" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                    <TextBox x:Name="EmailBox" Height="40" Padding="12,8"
                             ToolTip="Adresse utilisée uniquement pour les informations BIMaestro"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Prénom (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                            <TextBox x:Name="FirstNameBox" Height="40" Padding="12,8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nom (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                            <TextBox x:Name="LastNameBox" Height="40" Padding="12,8"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="2,7,0,0" Style="{StaticResource TrustText}"
                               Text="Votre adresse sert uniquement à vous tenir au courant de BIMaestro. Vous pourrez la retirer à tout moment dans Option."/>

                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="12"
                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Une question ? Contact direct" FontWeight="SemiBold" Foreground="#92400E"/>
                                <TextBlock Text="Paul Lemert — développeur de BIMaestro" Margin="0,2,0,0" Foreground="#A16207" FontSize="12.5"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="LinkedIn" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Style="{StaticResource WelcomeSecondaryButton}"
                                    MinWidth="94" Height="34" Click="Contact_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Padding="18,14" Background="{DynamicResource Surface.Subtle}"
                        CornerRadius="0,0,18,18" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Continuer sans email" Style="{StaticResource WelcomeSecondaryButton}"
                                Click="NoThanks_Click"/>
                        <Button Grid.Column="1" Content="Me le rappeler plus tard" Margin="10,0,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource WelcomeSecondaryButton}"
                                Click="Later_Click"/>
                        <Button Grid.Column="2" Content="Recevoir les nouveautés" Margin="10,0,0,0"
                                Style="{StaticResource WelcomePrimaryButton}" Click="OptIn_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
