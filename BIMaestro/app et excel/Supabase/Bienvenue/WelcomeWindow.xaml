<Window x:Class="BIMaestro.Welcome.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro — Bienvenue"
        Width="880" Height="620"
        MinWidth="760" MinHeight="540"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.Background}"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WelcomePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinWidth" Value="190"/>
                <Setter Property="Height" Value="42"/>
            </Style>

            <Style x:Key="WelcomeSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="118"/>
                <Setter Property="Height" Value="42"/>
            </Style>

            <Style x:Key="WelcomeGhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="116"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style x:Key="MiniTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="MiniText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="18"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="22" CornerRadius="18" BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F5132" Offset="0"/>
                    <GradientStop Color="#188F69" Offset="0.58"/>
                    <GradientStop Color="#F59E0B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="58" Height="58" CornerRadius="16" Background="#EEFFFFFF">
                    <Image x:Name="LogoImage" Width="46" Height="46" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Bienvenue dans BIMaestro" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#E8FFF4"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="Un plugin Revit qui avance avec les vrais retours du terrain."/>
                </StackPanel>

                <Border Grid.Column="3"
                        VerticalAlignment="Center"
                        Background="#26FFFFFF"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="EN ÉVOLUTION" Foreground="#FDE68A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="continue" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,14"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Ce que BIMaestro veut t'apporter" Style="{StaticResource H2}" FontSize="18" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource MiniText}" FontSize="13.5"
                                   Text="Moins de clics inutiles, des outils plus lisibles, et des corrections qui arrivent quand quelque chose bloque vraiment."/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#DCFCE7">
                                <TextBlock Text="1" Foreground="#166534" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Gagner du temps dans Revit" Style="{StaticResource MiniTitle}"/>
                                <TextBlock Text="Des commandes pratiques pour enlever les tâches répétitives du quotidien." Style="{StaticResource MiniText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#E0F2FE">
                                <TextBlock Text="2" Foreground="#075985" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Comprendre vite les boutons" Style="{StaticResource MiniTitle}"/>
                                <TextBlock Text="Le guide permet de retrouver l'idée de chaque outil sans perdre du temps à deviner." Style="{StaticResource MiniText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FEF3C7">
                                <TextBlock Text="3" Foreground="#92400E" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Améliorer avec tes retours" Style="{StaticResource MiniTitle}"/>
                                <TextBlock Text="Si un bouton marche mal, si une commande n'est pas claire, ou si une idée manque, le plus utile c'est de me le dire." Style="{StaticResource MiniText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Margin="0,16,0,0"
                            Padding="14"
                            CornerRadius="14"
                            Background="#F8FAFC"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Besoin d'un exemple ?" Style="{StaticResource MiniTitle}"/>
                                <TextBlock Text="Ouvre le guide BIMaestro pour voir rapidement l'esprit du plugin." Style="{StaticResource MiniText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Voir le guide"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WelcomeGhostButton}"
                                    Click="OpenGuide_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Rester dans la boucle" Style="{StaticResource H2}" FontSize="18" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource MiniText}" FontSize="13.5"
                                   Text="Laisse ton email si tu veux recevoir les infos importantes : correctifs, changements utiles, ou demande de retour sur une nouvelle idée. Pour me contacter directement, passe plutôt par LinkedIn."/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,14,0,16"
                            Padding="14"
                            CornerRadius="14"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1">
                        <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="#065F46">
                            BIMaestro est en évolution constante.
                            <LineBreak/>
                            Si quelque chose n'est pas clair ou ne fonctionne pas comme prévu, tu peux me contacter directement.
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Email (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                        <TextBox x:Name="EmailBox" Height="38" Padding="12,7"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prénom (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                            <TextBox x:Name="FirstNameBox" Height="38" Padding="12,7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nom (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                            <TextBox x:Name="LastNameBox" Height="38" Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource MiniText}" Margin="2,0,0,10"
                                   Text="Tu peux modifier ces infos plus tard depuis Option. Aucun souci si tu préfères passer."/>
                        <Border Padding="12" CornerRadius="14" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Contact direct" Style="{StaticResource MiniTitle}"/>
                                    <TextBlock Text="LinkedIn - Paul Lemert" Style="{StaticResource MiniText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="LinkedIn"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource WelcomeGhostButton}"
                                        Click="Contact_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="Merci d'aider BIMaestro à devenir plus utile." />

            <WrapPanel DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       ItemHeight="42"
                       Orientation="Horizontal">
                <Button Content="Non merci" Margin="8,0,0,0" Style="{StaticResource WelcomeSecondaryButton}" Click="NoThanks_Click"/>
                <Button Content="Plus tard" Margin="8,0,0,0" Style="{StaticResource WelcomeSecondaryButton}" Click="Later_Click"/>
                <Button Content="Oui, me tenir au courant" Margin="8,0,0,0" Style="{StaticResource WelcomePrimaryButton}" Click="OptIn_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
