<Window x:Class="BIMaestro.Welcome.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro — Bienvenue"
        Width="645" Height="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF6F7FB"
        Foreground="#FF111827"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border CornerRadius="16" Background="White" Padding="16" BorderBrush="#FFE5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="LogoImage" Width="44" Height="44" VerticalAlignment="Center" Stretch="Uniform"/>
                
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Bienvenue dans BIMaestro" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Opacity="0.75"
                               Text="Un plugin pensé pour simplifier le quotidien des dessinateurs Revit."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Margin="0,12,0,12" CornerRadius="16"
                Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" LineHeight="18" Opacity="0.90">
                    Objectif : gagner du temps, éviter les tâches pénibles, et rendre Revit plus fluide.
                    <LineBreak/><LineBreak/>
                    Tu peux ouvrir un <Bold>exemple</Bold> (guide en ligne) pour comprendre rapidement à quoi sert chaque bouton.
                    <LineBreak/><LineBreak/>
                    Optionnel : si tu veux, laisse ton email pour recevoir parfois des infos de mise à jour et correctifs importants.
                </TextBlock>

                <!-- Email -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="Email (optionnel)" Opacity="0.75" Margin="2,0,0,6"/>
                    <TextBox x:Name="EmailBox" Height="36" Padding="12,7"
                             Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                             Foreground="#FF111827"/>
                </StackPanel>

                <!-- Prénom / Nom -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Prénom (optionnel)" Opacity="0.75" Margin="2,0,0,6"/>
                        <TextBox x:Name="FirstNameBox" Height="36" Padding="12,7"
                                 Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                                 Foreground="#FF111827"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nom (optionnel)" Opacity="0.75" Margin="2,0,0,6"/>
                        <TextBox x:Name="LastNameBox" Height="36" Padding="12,7"
                                 Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                                 Foreground="#FF111827"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="3" Margin="2,10,0,0" Opacity="0.65" TextWrapping="Wrap"
                           Text="Tu pourras modifier ça plus tard dans Option (très rapide)."/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.65"
                       Text="BIMaestro — merci pour l’usage." />

            <Button Grid.Column="1" Content="Non merci" Margin="8,0,0,0" Padding="14,9"
                    Background="Transparent" BorderBrush="#FFE5E7EB" BorderThickness="1"
                    Foreground="#FF111827" Click="NoThanks_Click"/>

            <Button Grid.Column="2" Content="Plus tard" Margin="8,0,0,0" Padding="14,9"
                    Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                    Foreground="#FF111827" Click="Later_Click"/>

            <Button Grid.Column="3" Content="Voir l’exemple" Margin="8,0,0,0" Padding="14,9"
                    Background="#FFEEF2FF" BorderBrush="#FFCBD5E1" BorderThickness="1"
                    Foreground="#FF1D4ED8" Click="OpenGuide_Click"/>

            <Button Grid.Column="4" Content="Recevoir les infos" Margin="8,0,0,0" Padding="14,9"
                    Background="#FF2563EB" BorderBrush="#FF2563EB" BorderThickness="1"
                    Foreground="White" Click="OptIn_Click"/>
        </Grid>
    </Grid>
</Window>
