<Window x:Class="BIMaestro.Welcome.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMaestro — Bienvenue"
        Width="820" Height="620"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource App.Background}"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMaestro;component/Themes/BIMaestroTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WelcomePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="Height" Value="38"/>
            </Style>

            <Style x:Key="WelcomeSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Height" Value="38"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="LogoImage" Width="44" Height="44" VerticalAlignment="Center" Stretch="Uniform"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Bienvenue dans BIMaestro" Style="{StaticResource H2}" FontSize="20" Margin="0"/>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Un plugin pensé pour simplifier le quotidien des dessinateurs Revit."/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Text.Primary}">
                        Objectif : gagner du temps, éviter les tâches pénibles, et rendre Revit plus fluide.
                        <LineBreak/><LineBreak/>
                        Tu peux ouvrir un <Bold>exemple</Bold> (guide en ligne) pour comprendre rapidement à quoi sert chaque bouton.
                        <LineBreak/><LineBreak/>
                        Optionnel : si tu veux, laisse ton email pour recevoir parfois des infos de mise à jour et correctifs importants.
                    </TextBlock>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Text="Email (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                        <TextBox x:Name="EmailBox" Height="36" Padding="12,7"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prénom (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                            <TextBox x:Name="FirstNameBox" Height="36" Padding="12,7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nom (optionnel)" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                            <TextBox x:Name="LastNameBox" Height="36" Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" Margin="2,10,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                               Text="Tu pourras modifier ça plus tard dans Option (très rapide)."/>
                </Grid>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="BIMaestro." />

            <WrapPanel DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       ItemHeight="38"
                       Orientation="Horizontal">
                <Button Content="Non merci" Margin="8,0,0,0" Style="{StaticResource WelcomeSecondaryButton}" Click="NoThanks_Click"/>
                <Button Content="Plus tard" Margin="8,0,0,0" Style="{StaticResource WelcomeSecondaryButton}" Click="Later_Click"/>
                <Button Content="Voir l’exemple" Margin="8,0,0,0" Style="{StaticResource WelcomeSecondaryButton}" Click="OpenGuide_Click"/>
                <Button Content="Recevoir les infos" Margin="8,0,0,0" Style="{StaticResource WelcomePrimaryButton}" Click="OptIn_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>