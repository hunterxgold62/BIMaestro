<UserControl x:Class="BIMaestro.UI.ToothedToggleSwitch"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True"
             MinWidth="160" MinHeight="56">
    <Grid x:Name="LayoutRoot" Background="Transparent">

        <!-- Voyants OFF/ON au-dessus -->
        <Grid x:Name="Lights" Height="22" Margin="0,0,0,4"
          VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- OFF -->
            <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="18,0,0,0">
                <TextBlock x:Name="LblOff" Text="off" Foreground="#6F7A7A" FontSize="12" FontWeight="SemiBold"
                   TextOptions.TextFormattingMode="Display" />
                <Ellipse x:Name="LedOff" Width="16" Height="16" Fill="#121212" Margin="0,2,0,0">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="GlowOff" ShadowDepth="0" BlurRadius="0" Color="#f50000" Opacity="0.0"/>
                    </Ellipse.Effect>
                </Ellipse>
            </StackPanel>

            <!-- ON -->
            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,18,0">
                <TextBlock x:Name="LblOn" Text="on" Foreground="#6F7A7A" FontSize="12" FontWeight="SemiBold"/>
                <Ellipse x:Name="LedOn" Width="16" Height="16" Fill="#121212" Margin="0,2,0,0">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="GlowOn" ShadowDepth="0" BlurRadius="0" Color="#4CAF50" Opacity="0.0"/>
                    </Ellipse.Effect>
                </Ellipse>
            </StackPanel>
        </Grid>

        <!-- SWITCH -->
        <Grid x:Name="SwitchHost" Margin="0,24,0,0">
            <!-- Anneau externe (carving) -->
            <Border x:Name="Bezel" CornerRadius="1000" Background="#616774"
              SnapsToDevicePixels="True">
                <Border.Effect>
                    <!-- léger relief externe -->
                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#000000A6"/>
                </Border.Effect>
            </Border>

            <!-- Gorge interne sombre -->
            <Border x:Name="Cavity" CornerRadius="1000" Background="#191e1e" Margin="6">
                <Border.Effect>
                    <!-- ombre interne (fake) -->
                    <DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <!-- DENTS haut/bas -->
            <Grid x:Name="TeethLayer" Margin="6" ClipToBounds="True">
                <!-- Rangée haute -->
                <Grid x:Name="TopTeethContainer" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top"
              Height="Auto" Margin="-10,0,-10,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="TopRotate" Angle="5"/>
                            <TranslateTransform x:Name="TopShift" X="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <UniformGrid x:Name="TopTeeth" Rows="1"/>
                </Grid>

                <!-- Rangée basse -->
                <Grid x:Name="BottomTeethContainer" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Bottom"
              Margin="-10,0,-10,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="BotRotate" Angle="-5"/>
                            <TranslateTransform x:Name="BotShift" X="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <UniformGrid x:Name="BottomTeeth" Rows="1"/>
                </Grid>
            </Grid>

            <!-- THUMB -->
            <Grid x:Name="Thumb" HorizontalAlignment="Left" VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="ThumbX"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- disque -->
                <Ellipse x:Name="ThumbDisk" Fill="{StaticResource ThumbFill}" />
                <!-- stries -->
                <Grid x:Name="Grip" IsHitTestVisible="False">
                    <Rectangle Fill="#2c3133" RadiusX="3" RadiusY="3"/>
                    <Rectangle Fill="#2c3133" RadiusX="3" RadiusY="3"/>
                    <Rectangle Fill="#2c3133" RadiusX="3" RadiusY="3"/>
                </Grid>
                <!-- halo coloré -->
                <Ellipse x:Name="ThumbGlow" Opacity="0.7">
                    <Ellipse.Fill>
                        <RadialGradientBrush x:Name="ThumbRadial" GradientOrigin="0.5,0.55" Center="0.5,0.55" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop x:Name="ThumbColorStop" Color="#f50000" Offset="0.9"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Stroke="#00000040" StrokeThickness="1"/>
            </Grid>
        </Grid>

        <!-- Couche clic (sans focus) -->
        <ToggleButton x:Name="Hit" Background="Transparent" BorderThickness="0"
                  Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}"
                  IsChecked="{Binding IsOn, ElementName=root, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>

    <!-- Ressource pour le remplissage du thumb -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ThumbFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3f4447" Offset="0"/>
            <GradientStop Color="#262727" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>
</UserControl>
