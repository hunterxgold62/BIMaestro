<UserControl x:Class="BIMaestro.UI.EyeToggleSwitch"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             MinWidth="120" MinHeight="48">
    <Grid x:Name="LayoutRoot" Background="Transparent">

        <!-- TRACK -->
        <Grid x:Name="TrackHost" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="TrackRing"
              Background="Transparent"
              BorderBrush="#172C3C"
              BorderThickness="6"
              CornerRadius="1000">
                <Border.Effect>
                    <DropShadowEffect x:Name="RingGlow" Color="#FED501" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                </Border.Effect>
            </Border>

            <Grid x:Name="TrackBody" Margin="0">
                <Border x:Name="Track" CornerRadius="1000" Background="#224056"/>
                <Border x:Name="TrackBevel" CornerRadius="1000" IsHitTestVisible="False" Opacity="0.14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0.00"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#22000000" Offset="1.00"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>

        <!-- THUMB (l'œil) -->
        <Grid x:Name="Thumb"
          HorizontalAlignment="Left" VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5"
          ClipToBounds="True">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="ThumbX"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid x:Name="EyeBox" ClipToBounds="True">
                <!-- blanc + fin liseré gris -->
                <Ellipse x:Name="EyeWhite" Fill="#FFFFFF" Stroke="#E5E7ED" StrokeThickness="4"/>

                <!-- Pupille + reflet -->
                <Grid x:Name="Pupil"
              Width="18" Height="18"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="PupilOffset"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="PupilShape" Fill="#000000"/>
                    <Ellipse x:Name="Spec" Fill="#FFFFFF" Opacity="0.9"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>

                <!-- Paupière supérieure (clipée dans l’œil) -->
                <Path x:Name="Eyelid"
              Fill="#F1F2FB"
              RenderTransformOrigin="0.5,0.85">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="EyelidRot" Angle="-8"/>
                            <TranslateTransform x:Name="EyelidShift" X="0" Y="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Clip>
                        <EllipseGeometry x:Name="EyelidClip" Center="0,0" RadiusX="0" RadiusY="0"/>
                    </Path.Clip>
                </Path>
            </Grid>
        </Grid>

        <!-- couche de clic (sans focus bleu) -->
        <ToggleButton x:Name="Hit"
                  Background="Transparent" BorderThickness="0"
                  Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}"
                  IsChecked="{Binding IsOn, ElementName=root, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

    </Grid>
</UserControl>
