<UserControl x:Class="BIMaestro.UI.SimpleColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="90"
             Focusable="False">
    <Grid>
        <ToggleButton x:Name="DropDownButton"
                      Padding="6,2"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      ToolTip="Choisir une couleur">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="16"
                        Height="16"
                        BorderBrush="#7F8C8D"
                        BorderThickness="1"
                        Background="#E5E7EB">
                    <Rectangle x:Name="ColorSwatch"/>
                </Border>

                <TextBlock x:Name="ColorText"
                           Grid.Column="1"
                           Margin="6,0,4,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Path Grid.Column="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{Binding Foreground, ElementName=DropDownButton}"
                      Data="M 0 0 L 8 0 L 4 4 Z"/>
            </Grid>
        </ToggleButton>

        <Popup x:Name="ColorPopup"
               PlacementTarget="{Binding ElementName=DropDownButton}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=DropDownButton, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True"
               Opened="ColorPopup_Opened">
            <Border Margin="0,3,0,0"
                    Padding="10"
                    Width="230"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.25" ShadowDepth="3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Couleurs rapides"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold"/>

                    <WrapPanel x:Name="PalettePanel"/>

                    <Separator Margin="0,8"/>

                    <TextBlock Text="Couleur hexadécimale"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HexTextBox"
                                 Grid.Column="0"
                                 Height="26"
                                 Padding="5,2"
                                 VerticalContentAlignment="Center"
                                 ToolTip="#RRGGBB ou #AARRGGBB"
                                 KeyDown="HexTextBox_KeyDown"/>

                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="9,2"
                                Content="Appliquer"
                                Click="ApplyHexButton_Click"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Left"
                                Padding="8,3"
                                Content="Personnaliser…"
                                Click="CustomColorButton_Click"/>

                        <Button Grid.Column="1"
                                Padding="8,3"
                                Content="Transparent"
                                Click="TransparentButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
