<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitRuntimeConfig>C:\Program Files\Autodesk\Revit 2025\RevitAPI.runtimeconfig.json</RevitRuntimeConfig>
    <RevitRuntimeJson Condition="Exists('$(RevitRuntimeConfig)')">$([System.IO.File]::ReadAllText('$(RevitRuntimeConfig)'))</RevitRuntimeJson>
    <TargetFramework Condition="$([System.String]::Copy('$(RevitRuntimeJson)').Contains('&quot;net10.0&quot;'))">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BIMaestro.History.NativeValidation</AssemblyName>
    <DefineConstants>REVIT2025_OR_GREATER</DefineConstants>
    <OutputPath>$(HistoryOutput)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>../../BIMaestro/bin/Debug/Newtonsoft.Json.dll</HintPath></Reference>
    <Compile Include="HistoryNativeTests.cs" />
    <Compile Include="RealModelBenchmark.cs" />
    <Compile Include="AntibesBenchmark.cs" />
    <Compile Include="NativeArchiveStore.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryNativeArchive.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryOpeningArchive.cs" />
    <Compile Include="../../BIMaestro/commands/ElementIdExtensions.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryReconstruction.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryReconstruction.Extended.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryRestoration.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryNetwork.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryNetwork.Guard.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryRelations.cs" />
    <Compile Include="../../BIMaestro/commands/qui est le coupable/ElementHistoryAudit.cs" />
  </ItemGroup>
</Project>
