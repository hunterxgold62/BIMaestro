<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2023'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>BIMaestro.RibbonBadgeProbe</AssemblyName>
    <OutputPath>../../tmp/ribbon-badge-probe/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>C:/Program Files/Autodesk/Revit $(RevitVersion)/RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>C:/Program Files/Autodesk/Revit $(RevitVersion)/RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>C:/Program Files/Autodesk/Revit $(RevitVersion)/AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
