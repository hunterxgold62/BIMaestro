<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../tmp/ribbon-compat-check/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CompatibilityCheck.cs" />
    <Reference Include="System.Reflection.MetadataLoadContext"><HintPath>$(MSBuildSDKsPath)/../System.Reflection.MetadataLoadContext.dll</HintPath></Reference>
  </ItemGroup>
</Project>
