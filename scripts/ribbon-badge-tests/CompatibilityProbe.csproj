<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <RevitInstallDir>C:/Program Files/Autodesk/Revit $(RevitVersion)</RevitInstallDir>
    <RevitRuntimeConfig>$(RevitInstallDir)/RevitAPI.runtimeconfig.json</RevitRuntimeConfig>
    <RevitRuntimeJson Condition="Exists('$(RevitRuntimeConfig)')">$([System.IO.File]::ReadAllText('$(RevitRuntimeConfig)'))</RevitRuntimeJson>
    <TargetFramework Condition="'$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027' Or $([System.String]::Copy('$(RevitRuntimeJson)').Contains('&quot;net10.0&quot;'))">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath>../../tmp/ribbon-compat-probe-$(RevitVersion)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BIMaestro.RibbonCompatibilityProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="InformationProbe.cs" />
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)/RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)/RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(RevitInstallDir)/AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
