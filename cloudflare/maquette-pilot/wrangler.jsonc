{
  "name": "bimaestro-maquette-pilot",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "QUOTA_ENABLED": "false" },
  "observability": { "enabled": false },
  "d1_databases": [
    { "binding": "CATALOG", "database_name": "bimaestro-family-catalog", "database_id": "1918916c-c5cb-4165-8db2-0532291d859c" }
  ],
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "bimaestro-maquettes" }
  ]
}
