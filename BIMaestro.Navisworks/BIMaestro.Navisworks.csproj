    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepDiagnostics.cs" />
    <Compile Include="..\BIMaestro\Localization\UiLanguage.cs" />
    <Compile Include="Services\NavisworksBimMetadata.cs" />
    <Compile Include="Services\ExteriorVisibility.cs" />
    <Compile Include="Services\SimplifiedShellMesh.cs" />
    <Compile Include="Services\StraightTubeMesh.cs" />
    <Compile Include="Services\NavisworksWebScene.cs" />
    <Compile Include="UI\PublishWebWindow.cs" />
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameRuntimeDiagnostics.cs" />
    <Compile Include="..\BIMaestro\app et excel\Supabase\UserDataStorage.cs" />
    <Compile Include="..\BIMaestro\app et excel\Supabase\PreferenceStorage.cs" />
