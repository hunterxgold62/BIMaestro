    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepImpact.cs" />
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepScenarioStore.cs" />
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepScenarioHistory.cs" />
