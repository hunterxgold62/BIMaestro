<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{16D826C7-2E5C-4F1C-9D03-808E46715AF3}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>BIMaestro.Navisworks</RootNamespace>
    <AssemblyName>BIMaestro.Navisworks</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <Deterministic>true</Deterministic>
    <NavisworksYear Condition="'$(NavisworksYear)' == ''">2025</NavisworksYear>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage $(NavisworksYear)</NavisworksInstallDir>
    <OutputPath>bin\$(Configuration)\$(NavisworksYear)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(NavisworksYear)\</IntermediateOutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize Condition="'$(Configuration)' != 'Debug'">true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NavisworksInstallDir)/Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NavisworksInstallDir)/Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameSceneData.cs" />
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepData.cs" />
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepReplayStore.cs" />
    <Compile Include="..\BIMaestro\commands\Jeux vidéos\Maquette jouable\GameMepWebPackage.cs" />
